---
// /angebot/ – Website Service im Leitbild „Der Weg“ (27.10.2026): gleiche Köpfe, Karten, Linie wie die Startseite.
// Preise nur aus PAKETE, Ablauf aus steps (eine Quelle mit der Startseite).
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import SectionHead from '../components/SectionHead.astro';
import Weg from '../components/Weg.astro';
import Icon from '../components/Icon.astro';
import { href } from '../lib/paths';
import { WAAS, PAKETE, MODELL, INKLUSIVE, steps, formatEuro } from '../config/site';
---

<BaseLayout
  title="Angebot: Website Service"
  description="Der Website Service von Waybuild: Website, Hosting, Wartung und Betreuung zum festen Monatspreis – 79 € oder 139 € netto, ohne Einrichtungskosten."
  breadcrumb={[{ name: 'Angebot', path: '/angebot/' }]}
>
  <PageHeader eyebrow="Angebot" title="Der Website Service." accent="Alles aus einer Hand." lead="Unser erster Service: Ihre Website – gebaut, betreut und immer aktuell. Zum festen Monatspreis." />

  <section class="section section--sand" id="angebot" aria-labelledby="angebot-h">
    <div class="wrap">
      <SectionHead eyebrow="Zwei Varianten" pre="Ein fester Monatspreis. " accent="Alles drin." text={WAAS.claim} id="angebot-h" />
      <ul class="pakete">
        {PAKETE.map((p) => (
          <li class:list={['paket', 'reveal', { 'paket--top': p.empfohlen }]}>
            {p.empfohlen && <span class="paket__tag">Empfohlen</span>}
            <h3>{p.name}</h3>
            <p class="paket__kurz">{p.kurz}</p>
            <p class="paket__preis"><strong>{formatEuro(p.preis)}</strong> <span>pro Monat, netto zzgl. MwSt.</span></p>
            <p class="paket__fuer">{p.fuer}</p>
            <ul class="paket__liste">
              {p.features.map((f) => <li><Icon name="check" size={18} />{f}</li>)}
            </ul>
            <a class="btn btn--primary" href={href('/kontakt/')}>Unverbindlich anfragen <Icon name="arrow" size={18} /></a>
          </li>
        ))}
      </ul>
      <ul class="modell" aria-label="Rahmenbedingungen">
        {MODELL.map((m) => <li><Icon name="check" size={16} />{m}</li>)}
      </ul>
    </div>
  </section>

  <section class="section" id="enthalten" aria-labelledby="enthalten-h">
    <div class="wrap">
      <SectionHead eyebrow="Enthalten" pre="Sie kümmern sich um Ihr Geschäft. " accent="Wir um den Rest." id="enthalten-h" />
      <ul class="inklusive">
        {INKLUSIVE.map((i) => <li class="reveal"><span class="inklusive__icon" aria-hidden="true"><Icon name={i.icon} size={22} /></span>{i.title}</li>)}
      </ul>
    </div>
  </section>

  <section class="section section--sand" id="ablauf" aria-labelledby="ablauf-h">
    <div class="wrap">
      <SectionHead eyebrow="So starten wir" pre="In vier Schritten " accent="zur Website." text="Vom ersten Gespräch bis zur laufenden Betreuung – mit einem festen Ansprechpartner." id="ablauf-h" />
      <Weg art="gerade" stationen={steps.map((s) => ({ titel: s.title, marke: s.short, text: s.text, icon: s.icon }))} zeichnen nummern />
      <p class="ablauf__cta">
        <a class="btn btn--primary btn--lg" href={href('/kontakt/')}>Erstgespräch anfragen <Icon name="arrow" size={18} /></a>
        <a class="pfeil-link" href={href('/faq/')}>Häufige Fragen zum Angebot <Icon name="arrow" size={16} /></a>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .pakete { list-style: none; margin: 0; padding: 0; display: grid; gap: 20px; max-width: 940px; }
  @media (min-width: 760px) { .pakete { grid-template-columns: 1fr 1fr; gap: 24px; } }
  .paket { position: relative; background: var(--white); border: 1px solid var(--line); border-radius: 20px; padding: clamp(24px, 3vw, 32px); display: grid; gap: 8px; align-content: start; justify-items: start; }
  .paket--top { border: 2px solid var(--accent); }
  .paket__tag { position: absolute; top: -13px; right: 22px; background: var(--accent-ink); color: var(--white); font-size: 0.78rem; font-weight: 700; letter-spacing: 0.06em; padding: 4px 12px; border-radius: 999px; }
  .paket h3 { margin: 0; font-size: 1.35rem; }
  .paket p { margin: 0; }
  .paket__kurz { color: var(--accent-ink); font-weight: 600; }
  .paket__preis strong { font-family: var(--font-head); font-size: 2.3rem; }
  .paket__preis span { color: var(--ink-soft); font-size: 0.9rem; }
  .paket__fuer { color: var(--ink-soft); line-height: 1.6; }
  .paket__liste { list-style: none; margin: 8px 0 16px; padding: 0; display: grid; gap: 8px; }
  .paket__liste li { display: flex; gap: 8px; align-items: flex-start; line-height: 1.45; }
  .paket__liste :global(.icon), .modell :global(.icon) { color: var(--accent-ink); flex: none; margin-top: 2px; }
  .modell { list-style: none; margin: 28px 0 0; padding: 0; max-width: 940px; display: flex; flex-wrap: wrap; gap: 8px 22px; }
  .modell li { display: inline-flex; gap: 6px; align-items: center; font-weight: 500; }

  .inklusive { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
  @media (min-width: 600px) { .inklusive { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1000px) { .inklusive { grid-template-columns: repeat(3, 1fr); } }
  .inklusive li { display: flex; gap: 14px; align-items: center; padding: 16px 18px; border-radius: 16px; background: var(--paper); border: 1px solid var(--line); font-weight: 600; }
  .inklusive__icon { flex: none; display: grid; place-items: center; width: 42px; height: 42px; border-radius: 12px; background: rgb(0 166 161 / 14%); color: var(--accent-ink); }

  .ablauf__cta { display: flex; flex-wrap: wrap; align-items: center; gap: 16px 28px; margin: 40px 0 0; }
</style>
