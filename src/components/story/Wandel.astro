---
// SCHRITT 1 · VORHER → DANN KOMMT WAYBUILD als Reise einer Anfrage (Jamil, Talk 3714–3724, 29.10.2026).
// Die Anfrage (Brief-Symbol, Startpunkt im Hero) wandert scrollgesteuert an der Hauptlinie entlang:
//   Hälfte 1 (grau, leicht wellig, nicht zu viel Chaos): sechs kurze Stationen eines üblichen Ablaufs – das Symbol hält an,
//   beim Warten zittert es kurz. → „Schnitt“ → Hälfte 2 (gerade, türkis, schneller Fluss): die vier Waybuild-Schritte;
//   das Symbol hält an jeder Station, die Karte leuchtet auf.
// Die Animation ersetzt die bisherige Textbeschreibung (Chaos-Begriffe und Situations-Kärtchen erzählten dasselbe).
// Alles hängt am Scroll-Fortschritt p (rückwärts beim Hochscrollen), nur transform/opacity/clip.
// Ohne JS, bei reduzierter Bewegung oder sehr niedrigem Fenster: statische Stationen-Liste (Vorher, Schnitt, Waybuild).
import Icon from '../Icon.astro';
import type { IconName } from '../../config/site';

// Hälfte 1: übliche Reise einer Anfrage (Jamil, Talk 3718), je höchstens 4–6 Wörter
const VORHER: { t: string; icon: IconName }[] = [
  { t: 'Trifft beim Dienstleister ein', icon: 'home' },
  { t: 'Erst einmal Rückfragen …', icon: 'chat' },
  { t: '… Rückfragen geklärt', icon: 'check' },
  { t: 'Intern: Wer ist zuständig?', icon: 'users' },
  { t: 'Ein bis zwei Tage vergehen', icon: 'clock' },
  { t: 'Endlich Rückmeldung: Aufwand? Extrakosten?', icon: 'euro' },
];
// Hälfte 2: Waybuild-Weg (Talk 3720/3722/3724); Stunde (während der Servicezeiten, Mo–Fr 9–18 Uhr) und Abo für alle Produkte
// von Jamil bestätigt (Talk 3726), ohne Produkte zu nennen.
// Jede Station als kleine Szene (Jamil, Talk 3728: „nicht einfach nur stumm als Text … dieser Prozess soll dargestellt werden“)
type Teil = { icon?: IconName; t?: string; pfeil?: boolean };
const SCHRITTE: { titel: string; sub: string; szene: Teil[] }[] = [
  { titel: 'Eine Nachricht genügt.', sub: 'Ihre Anfrage kommt an.', szene: [{ icon: 'mail', t: 'Ihre Nachricht' }, { pfeil: true }, { icon: 'check', t: 'angekommen' }] },
  { titel: 'Ein fester Ansprechpartner.', sub: 'Rückmeldung innerhalb einer Stunde – während der Servicezeiten.', szene: [{ icon: 'user', t: 'Ihr Ansprechpartner' }, { icon: 'clock', t: '< 1 Std.' }] },
  { titel: 'Ein klarer Ablauf.', sub: 'Erst Prüfung, dann Bearbeitung.', szene: [{ icon: 'search', t: 'Prüfung' }, { pfeil: true }, { icon: 'tools', t: 'Bearbeitung' }] },
  { titel: 'Verlässlich umgesetzt.', sub: 'Feste monatliche Pakete – keine Nachkalkulation.', szene: [{ icon: 'check', t: 'umgesetzt' }, { icon: 'refresh', t: 'fester Monatspreis' }] },
];

// Leicht wellige Linie durch die sechs Stationen (x/y in % der Fläche, x = 0 ist die Hauptlinie), Catmull-Rom geglättet
const P: [number, number][] = [[0, 0], [9, 8.3], [3, 25], [13, 41.7], [4, 58.3], [14, 75], [5, 91.7], [0, 100]];
const cr = (pts: [number, number][], a = 0.2) => pts.slice(0, -1).map((p1, i) => {
  const p0 = pts[i - 1] ?? p1, p2 = pts[i + 1], p3 = pts[i + 2] ?? p2;
  const f = (v: number) => v.toFixed(2);
  return ` C ${f(p1[0] + (p2[0] - p0[0]) * a)} ${f(p1[1] + (p2[1] - p0[1]) * a)}, ${f(p2[0] - (p3[0] - p1[0]) * a)} ${f(p2[1] - (p3[1] - p1[1]) * a)}, ${p2[0]} ${p2[1]}`;
}).join('');
const WEG = `M 0 0${cr(P)}`;
const STATIONEN = P.slice(1, -1);
---

<section class="wandel" id="so-arbeiten-wir" aria-labelledby="vorher-h" data-start>
  <div class="wrap wandel__grid">
    <div class="wandel__text">
      <div class="wtext wtext--a">
        <span class="schritt-kenn">Schritt 1 · Vorher</span>
        <h2 id="vorher-h">So fühlt sich Veränderung oft an.</h2>
        <p class="lead">Begleiten Sie eine ganz normale Anfrage.</p>
      </div>
      <div class="wtext wtext--b">
        <span class="schritt-kenn">Dann kommt Waybuild</span>
        <h2>Schritt für Schritt entsteht Ordnung.</h2>
      </div>
    </div>

    <div class="wandel__spur">
      <div class="tafel">
        <span class="anfrage" aria-hidden="true"><Icon name="mail" size={18} /></span>

        <!-- HÄLFTE 1: der übliche Weg -->
        <div class="tafel__teil tafel__vorher">
          <div class="tafel__kopf">
            <p class="tafel__hinweis" aria-hidden="true"><Icon name="chevron" size={18} /> Weiterscrollen – die Anfrage macht sich auf den Weg</p>
            <p class="kenn kenn--mobil kenn--mitte" data-phase="1" aria-hidden="true"><span>Dann kommt Waybuild</span>Schritt für Schritt entsteht Ordnung.</p>
          </div>
          <div class="tafel__flaeche">
            <div class="reise1">
              <svg class="reise1__weg" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true" focusable="false"><path d={WEG} /></svg>
              <ol class="reise1__stationen" aria-label="So läuft eine Anfrage oft">
                {VORHER.map((s, i) => (
                  <li class="station" style={`--sx:${STATIONEN[i][0]}%;--sy:${STATIONEN[i][1]}%;--sr:${i % 2 ? 1.2 : -1.2}deg`} data-station={i}>
                    <span class="station__punkt" aria-hidden="true"></span>
                    <span class="k station__karte"><span class="station__icon" aria-hidden="true"><Icon name={s.icon} size={16} /></span>{s.t}</span>
                  </li>
                ))}
              </ol>
            </div>
            <p class="schnitt" aria-hidden="true"><span>Schnitt.</span> So geht es mit Waybuild.</p>
          </div>
        </div>

        <!-- HÄLFTE 2: der Waybuild-Weg -->
        <div class="tafel__teil tafel__ordnung">
          <div class="tafel__kopf">
            <p class="kenn kenn--tuerkis" data-phase="2"><span>Mit Waybuild:</span>Ein klarer Weg. Gerade Abläufe.</p>
          </div>
          <ol class="schritte" aria-label="So läuft es mit Waybuild">
            {SCHRITTE.map((s, i) => (
              <li class="k k--akzent schritt" data-schritt={i}>
                <span class="k__nr" aria-hidden="true">{i + 1}</span>
                <div class="k__inhalt">
                  <h3 class="schritt__titel">{s.titel}</h3>
                  <p>{s.sub}</p>
                  <div class="szene" aria-hidden="true">
                    {s.szene.map((t, k) => t.pfeil
                      ? <span class="szene__pfeil" style={`--n:${k}`}><Icon name="arrow" size={14} /></span>
                      : <span class="szene__teil" style={`--n:${k}`}>{t.icon && <Icon name={t.icon} size={14} />}{t.t}</span>)}
                  </div>
                </div>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>('[data-start]');
  // Verbindungsstück der Hauptlinie über der Fläche (auch im statischen Zustand)
  if (root) { const t = root.querySelector<HTMLElement>('.tafel'), f = root.querySelector<HTMLElement>('.tafel__flaeche'); const s = () => t && f && t.style.setProperty('--stub-h', `${f.offsetTop}px`); s(); addEventListener('resize', s); document.fonts?.ready.then(s); }
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  const niedrig = window.matchMedia('(max-height: 559px)');
  const breit = window.matchMedia('(min-width: 960px)');
  if (root && !reduce.matches && !niedrig.matches) {
    root.classList.add('wandel--live');
    const spur = root.querySelector<HTMLElement>('.wandel__spur')!;
    const tafel = root.querySelector<HTMLElement>('.tafel')!;
    const flaeche = root.querySelector<HTMLElement>('.tafel__flaeche')!;
    const svg = root.querySelector<SVGSVGElement>('.reise1__weg')!;
    const weg = svg.querySelector<SVGPathElement>('path')!;
    const vorher = root.querySelector<HTMLElement>('.tafel__vorher .reise1')!;
    const ordnung = root.querySelector<HTMLElement>('.tafel__ordnung')!;
    const stationen = Array.from(root.querySelectorAll<HTMLElement>('.station'));
    const schritte = Array.from(root.querySelectorAll<HTMLElement>('.schritt'));
    const kennzeilen = Array.from(root.querySelectorAll<HTMLElement>('.kenn'));
    const textA = root.querySelector<HTMLElement>('.wtext--a')!;
    const textB = root.querySelector<HTMLElement>('.wtext--b')!;
    const hinweis = root.querySelector<HTMLElement>('.tafel__hinweis')!;
    const schnitt = root.querySelector<HTMLElement>('.schnitt')!;
    const anfrage = root.querySelector<HTMLElement>('.anfrage')!;
    const kopf = document.getElementById('siteHeader');
    const startpunkt = document.querySelector<HTMLElement>('.hlinie__start');
    const clamp = (v: number, a = 0, b = 1) => Math.min(b, Math.max(a, v));
    const glatt = (t: number) => t * t * (3 - 2 * t);
    const lerp = (a: number, b: number, t: number) => a + (b - a) * t;

    // Zeitplan (Anteile von p): Hälfte 1 mit Pausen, Schnitt, Hälfte 2 schneller
    const S1 = 0.03, T1 = 0.045, W1 = 0.028;
    const S2 = 0.56, T2 = 0.05, W2 = 0.035;
    const ankunft1 = (k: number) => S1 + k * (T1 + W1) + T1;
    const ankunft2 = (k: number) => S2 + k * (T2 + W2) + T2;
    const ENDE1 = ankunft1(5) + W1 + 0.02;
    const ENDE2 = ankunft2(3) + W2 + 0.05;

    let lx = 0, fh = 0, ftop = 0, len = 1;
    let frac: number[] = []; // Weg-Anteil je Station
    let ziel2: number[] = []; // y je Schritt (relativ zur Tafel)

    const messen = () => {
      lx = parseFloat(getComputedStyle(tafel).getPropertyValue('--linie-x')) || 0;
      ftop = flaeche.offsetTop;
      fh = flaeche.clientHeight;
      len = weg.getTotalLength();
      // Anteil der Weglänge, an dem die Linie die Höhe der Station erreicht
      frac = stationen.map((_, i) => {
        const yZiel = [8.3, 25, 41.7, 58.3, 75, 91.7][i];
        let best = 0, d = 1e9;
        for (let s = 0; s <= 200; s++) { const pt = weg.getPointAtLength((s / 200) * len); const dd = Math.abs(pt.y - yZiel); if (dd < d) { d = dd; best = s / 200; } }
        return best;
      });
      const tr = tafel.getBoundingClientRect();
      ziel2 = schritte.map((s) => { const r = s.getBoundingClientRect(); return r.top + r.height / 2 - tr.top; });
    };

    // Position auf Hälfte 1 (Weg-Anteil f) in Tafel-Koordinaten
    const punkt1 = (f: number) => {
      const pt = weg.getPointAtLength(clamp(f) * len);
      const sr = svg.getBoundingClientRect(), tr = tafel.getBoundingClientRect();
      return { x: sr.left - tr.left + (pt.x / 100) * sr.width, y: sr.top - tr.top + (pt.y / 100) * sr.height, h: sr.height, top: sr.top - tr.top };
    };
    const weg1 = (p: number) => {
      if (p <= S1) return 0;
      for (let k = 0; k < frac.length; k++) {
        const ab = S1 + k * (T1 + W1);
        const von = k ? frac[k - 1] : 0;
        if (p < ab + T1) return lerp(von, frac[k], glatt((p - ab) / T1));
        if (p < ab + T1 + W1) return frac[k];
      }
      return lerp(frac[frac.length - 1], 1, glatt(clamp((p - (ankunft1(5) + W1)) / 0.02)));
    };
    const y2 = (p: number) => {
      const start = ftop, ende = ftop + fh;
      if (p <= S2) return start;
      for (let k = 0; k < ziel2.length; k++) {
        const ab = S2 + k * (T2 + W2);
        const von = k ? ziel2[k - 1] : start;
        if (p < ab + T2) return lerp(von, ziel2[k], glatt((p - ab) / T2));
        if (p < ab + T2 + W2) return ziel2[k];
      }
      return lerp(ziel2[ziel2.length - 1], ende, glatt(clamp((p - (ankunft2(3) + W2)) / 0.05)));
    };

    let zuletzt = -1;
    const zeichnen = (erzwingen = false) => {
      const oben = kopf ? kopf.getBoundingClientRect().bottom : 72;
      const r = spur.getBoundingClientRect();
      const p = clamp((oben - r.top) / Math.max(1, spur.offsetHeight - tafel.offsetHeight));
      if (!erzwingen && Math.abs(p - zuletzt) < 0.0004) return;
      zuletzt = p;

      // Hälfte 1: Linie bis zur Anfrage aufdecken, Stationen erscheinen bei Ankunft
      const f = weg1(p);
      const a1 = punkt1(f);
      svg.style.clipPath = `inset(0 0 ${Math.max(0, a1.h - (a1.y - a1.top) - 2).toFixed(1)}px 0)`;
      stationen.forEach((st, k) => {
        const t = clamp((p - ankunft1(k) + 0.012) / 0.012);
        st.style.opacity = String(t);
        st.classList.toggle('station--hier', p >= ankunft1(k) - 0.004 && p < ankunft1(k) + W1);
      });
      const aus1 = clamp((p - ENDE1) / 0.035);
      vorher.style.opacity = String(1 - aus1);
      schnitt.style.opacity = String(clamp((p - ENDE1 + 0.01) / 0.02) * (1 - clamp((p - S2 + 0.005) / 0.02)));
      const ein2 = clamp((p - S2 + 0.03) / 0.03);
      ordnung.style.opacity = String(ein2);

      // Hälfte 2: Linie wächst mit der Anfrage, Karten erscheinen und leuchten beim Halt auf
      const yy = y2(p);
      tafel.style.setProperty('--zug2', String(clamp((yy - ordnung.offsetTop) / Math.max(1, ordnung.offsetHeight))));
      schritte.forEach((sEl, k) => {
        const t = clamp((p - ankunft2(k) + 0.012) / 0.012);
        sEl.style.opacity = String(t);
        sEl.style.transform = `translateX(${((1 - t) * 12).toFixed(1)}px)`;
        sEl.classList.toggle('schritt--da', t > 0.5);
        sEl.classList.toggle('schritt--hier', p >= ankunft2(k) - 0.004 && p < ankunft2(k) + W2);
      });

      // Die Anfrage: erst auf dem grauen Weg, nach dem Schnitt auf der geraden türkisen Linie
      const zweite = p >= S2 - 0.01;
      const x = zweite ? lx : a1.x;
      const y = zweite ? yy : a1.y;
      // Übergabe: Solange die Reise nicht begonnen hat, ist nur der Startpunkt im Hero zu sehen – sobald sie startet,
      // übernimmt die reisende Anfrage (optisch EIN Brief); beim Hochscrollen umgekehrt.
      const unterwegs = clamp(p / 0.008);
      const sicht = zweite ? clamp((p - S2 + 0.01) / 0.015) * (1 - clamp((p - ENDE2) / 0.03)) : unterwegs * (1 - clamp((p - ENDE1) / 0.02));
      if (startpunkt) startpunkt.style.opacity = String(1 - unterwegs);
      anfrage.style.transform = `translate(${x.toFixed(1)}px, ${y.toFixed(1)}px)`;
      anfrage.style.opacity = String(sicht);
      anfrage.classList.toggle('anfrage--klar', zweite);
      anfrage.classList.toggle('anfrage--wartet', !zweite && p >= ankunft1(4) && p < ankunft1(4) + W1);

      // Kennzeilen, Hinweis, Text-Spalte
      const sichtK = [0, clamp((p - S2) / 0.03) * (1 - clamp((p - 0.9) / 0.03)), clamp((p - 0.92) / 0.03)];
      kennzeilen.forEach((k) => { k.style.opacity = String(sichtK[Number(k.dataset.phase)]); });
      hinweis.style.opacity = String(1 - clamp(p / 0.03));
      root.classList.toggle('wandel--klar', p > S2 - 0.02);
      if (breit.matches) {
        const aus = clamp((p - ENDE1) / 0.03), ein = clamp((p - ENDE1 - 0.03) / 0.03);
        textA.style.opacity = String(1 - aus);
        textB.style.opacity = String(ein);
        textA.style.visibility = aus >= 1 ? 'hidden' : '';
        textB.style.visibility = ein <= 0 ? 'hidden' : '';
      } else {
        [textA, textB].forEach((el) => { el.style.opacity = ''; el.style.visibility = ''; });
      }
    };

    let laeuft = false;
    const anfordern = () => { if (!laeuft) { laeuft = true; requestAnimationFrame(() => { laeuft = false; zeichnen(); }); } };
    const neu = () => { schritte.forEach((s) => (s.style.transform = '')); messen(); tafel.style.setProperty('--stub-h', `${flaeche.offsetTop}px`); zeichnen(true); };
    neu();
    window.addEventListener('scroll', anfordern, { passive: true });
    window.addEventListener('resize', () => requestAnimationFrame(neu));
    if (document.fonts) document.fonts.ready.then(neu);
    reduce.addEventListener?.('change', () => location.reload());
  }
</script>

<style>
  .wandel { position: relative; background: var(--paper); padding-top: clamp(48px, 7vw, 96px); }
  .wandel__grid { display: grid; gap: 28px; }
  .wtext h2 { font-size: clamp(2rem, 4.4vw, 3.3rem); line-height: 1.06; letter-spacing: -0.028em; margin-bottom: 16px; }
  .wtext .lead { margin: 0; max-width: 46ch; }

  /* Arbeitsfläche */
  .tafel { --linie-x: 14px; position: relative; display: grid; gap: 20px; padding-bottom: 8px; }
  /* Die Hauptlinie kommt aus dem Hero: Verbindungsstück von oben bis zum Beginn der Fläche */
  .tafel::before { content: ''; position: absolute; left: calc(var(--linie-x) - 1.25px); top: 0; width: 2.5px; height: var(--stub-h, 0px); background: #cdc6b8; transition: background 300ms ease; }
  :global(.wandel--klar) .tafel::before { background: var(--accent); }
  .tafel__kopf { position: relative; padding-left: calc(var(--linie-x) + 30px); }
  .kenn { margin: 0; font-family: var(--font-head); font-weight: 700; font-size: clamp(1.15rem, 2.2vw, 1.45rem); line-height: 1.25; letter-spacing: -0.01em; color: var(--ink); }
  .kenn span { display: block; margin-bottom: 4px; font-family: var(--font-body); font-size: 0.78rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--accent-ink); }
  .kenn--mobil { display: none; }
  .tafel__hinweis { display: none; }

  /* Hälfte 1 */
  .tafel__flaeche { position: relative; }
  .reise1 { position: relative; height: clamp(520px, 140vw, 600px); margin-left: var(--linie-x); }
  .reise1__weg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .reise1__weg path { fill: none; stroke: #cdc6b8; stroke-width: 2.5; stroke-linecap: round; vector-effect: non-scaling-stroke; }
  .reise1__stationen { list-style: none; margin: 0; padding: 0; }
  .station { position: absolute; left: var(--sx); top: var(--sy); width: 0; height: 0; }
  .station__punkt { position: absolute; left: -6px; top: -6px; width: 12px; height: 12px; border-radius: 50%; background: var(--paper); border: 2.5px solid #cdc6b8; box-sizing: border-box; }
  .station__karte {
    position: absolute; left: 26px; top: 0; transform: translateY(-50%) rotate(var(--sr)); width: max-content; max-width: min(19rem, 62vw);
    --k-pad: 9px 14px; --k-gap: 10px; align-items: center; font-family: var(--font-head); font-weight: 600; font-size: 0.95rem; line-height: 1.3; color: #5b574f;
    transition: border-color 200ms ease;
  }
  .station__icon { flex: none; display: grid; place-items: center; width: 28px; height: 28px; border-radius: 8px; background: rgb(84 84 84 / 7%); color: #6f6a60; }
  .station--hier .station__karte { border-color: #b4ad9e; }
  .schnitt { margin: 18px 0 0 calc(var(--linie-x) + 30px); font-family: var(--font-head); font-weight: 650; color: var(--ink-soft); }
  .schnitt span { color: var(--accent-ink); }

  /* Die Anfrage */
  .anfrage { display: none; }

  /* Hälfte 2 */
  .tafel__ordnung { position: relative; }
  .schritte { list-style: none; margin: 0; padding: 0 0 0 calc(var(--linie-x) + 30px); display: grid; gap: 14px; position: relative; }
  .tafel__ordnung::before { content: ''; position: absolute; left: calc(var(--linie-x) - 1.5px); top: 0; bottom: -8px; width: 3px; background: var(--accent); border-radius: 2px; transform-origin: top; }
  .schritt { --k-pad: 14px 16px; align-items: center; transition: box-shadow 200ms ease, border-color 200ms ease; }
  .schritt::before { content: ''; position: absolute; left: -30px; top: 50%; width: 30px; height: 3px; margin-top: -1.5px; background: var(--accent); }
  .schritt::after { content: ''; position: absolute; left: -37px; top: 50%; width: 14px; height: 14px; margin-top: -7px; border-radius: 50%; background: var(--paper); border: 3px solid var(--accent); box-sizing: border-box; }
  .schritt .schritt__titel { margin: 0 0 2px; font-size: 1.12rem; }
  /* Mini-Szenen je Station: erscheinen nacheinander, sobald die Anfrage die Station erreicht */
  .szene { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; margin-top: 8px; }
  .szene__teil { display: inline-flex; align-items: center; gap: 5px; padding: 3px 9px 3px 7px; border-radius: 999px; background: rgb(0 166 161 / 10%); color: var(--accent-ink); font-size: 0.78rem; font-weight: 650; line-height: 1.3; }
  .szene__pfeil { display: inline-flex; color: var(--accent-mid); }
  :global(.wandel--live) .szene > * { opacity: 0; transform: translateX(-6px); transition: opacity 260ms ease, transform 260ms ease; transition-delay: calc(var(--n) * 220ms); }
  :global(.wandel--live) .schritt--da .szene > * { opacity: 1; transform: none; }
  :global(.wandel--live) .schritt--hier .szene__teil:last-child { background: var(--accent); color: var(--on-accent); }
  .schritt--hier { border-color: var(--accent); box-shadow: 0 0 0 4px rgb(0 166 161 / 16%), inset 0 0 0 999px rgb(0 166 161 / 6%); }

  /* Handy: Text A vor der Bühne, Text B danach */
  @media (max-width: 959px) {
    .wandel { padding-top: 40px; }
    .wandel__text { display: contents; }
    .wtext--a { order: 1; position: relative; padding-left: 44px; }
    .wtext--a::before { content: ''; position: absolute; left: 12.75px; top: -40px; bottom: -28px; width: 2.5px; background: #cdc6b8; }
    .wandel__spur { order: 2; }
    .wtext--b { order: 3; padding-bottom: 8px; }
