---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import SectionHead from '../components/SectionHead.astro';
import Icon from '../components/Icon.astro';
import { href } from '../lib/paths';
import { WAAS, PAKETE, MODELL, INKLUSIVE, steps, formatEuro } from '../config/site';
---

<BaseLayout
  title="Angebot: Website as a Service"
  description="Website as a Service von waybuild IT: Website, Hosting, Wartung und Betreuung zum festen Monatspreis – 79 € oder 139 € netto, ohne Einrichtungskosten."
  breadcrumb={[{ name: 'Angebot', path: '/angebot/' }]}
>
  <PageHeader eyebrow="Angebot" title="Website as a Service" lead="Der erste Service von waybuild IT: Website, Hosting, Wartung und Betreuung zum festen Monatspreis." />
  <!-- 8 ANGEBOT: WEBSITE AS A SERVICE (Preise nur aus PAKETE) -->
  <section class="section section--alt" id="angebot" aria-labelledby="angebot-h">
    <div class="wrap">
      <SectionHead center eyebrow="Zwei Varianten" pre="Ein fester Monatspreis. " accent="Alles drin." text={WAAS.claim} id="angebot-h" />
      <ul class="pakete">
        {PAKETE.map((p) => (
          <li class:list={['paket', 'reveal', { 'paket--top': p.empfohlen }]}>
            {p.empfohlen && <span class="paket__tag">Empfohlen</span>}
            <h3>{p.name}</h3>
            <p class="paket__kurz">{p.kurz}</p>
            <p class="paket__preis"><strong>{formatEuro(p.preis)}</strong> <span>pro Monat, netto zzgl. MwSt.</span></p>
            <p class="paket__fuer">{p.fuer}</p>
            <ul class="paket__liste">
              {p.features.map((f) => <li><Icon name="check" size={18} />{f}</li>)}
            </ul>
            <a class="btn btn--primary" href={href('/kontakt/')}>Unverbindlich anfragen <Icon name="arrow" size={18} /></a>
          </li>
        ))}
      </ul>
      <ul class="modell" aria-label="Rahmenbedingungen">
        {MODELL.map((m) => <li><Icon name="check" size={16} />{m}</li>)}
      </ul>
      <p class="angebot__inklusive"><strong>Enthalten:</strong> {INKLUSIVE.map((i) => i.title).join(' · ')}</p>
    </div>
  </section>

  <!-- 8b ABLAUF: in vier Schritten zur Website (Quelle: steps) -->
  <section class="section" id="ablauf" aria-labelledby="ablauf-h">
    <div class="wrap">
      <SectionHead center eyebrow="So starten wir" pre="In vier Schritten " accent="zur Website." text="Vom ersten Gespräch bis zur laufenden Betreuung – Sie haben immer einen festen Ansprechpartner." id="ablauf-h" />
      <ol class="ablauf reveal">
        {steps.map((t, i) => (
          <li class="ablauf__schritt" style={`--i:${i}`}>
            <span class="ablauf__icon"><Icon name={t.icon} size={30} /><span class="ablauf__nr">{i + 1}</span></span>
            <h3>{t.title}</h3>
            <p><strong>{t.short}.</strong> {t.text}</p>
          </li>
        ))}
      </ol>
      <p class="ablauf__cta"><a class="btn btn--primary btn--lg" href={href('/kontakt/')}>Erstgespräch anfragen <Icon name="arrow" size={18} /></a></p>
    </div>
  </section>

</BaseLayout>

<style>
  /* HERO */
  .hero { padding-block: clamp(40px, 7vw, 96px) clamp(40px, 6vw, 80px); overflow: hidden;
    background: radial-gradient(60% 60% at 80% 40%, rgb(0 166 161 / 12%), transparent 70%); }
  .hero__grid { display: grid; gap: 32px; align-items: center; }
  @media (min-width: 960px) { .hero__grid { grid-template-columns: 1.05fr 1fr; gap: 48px; } }
  .hero__text .lead { margin-bottom: 28px; }
  .hero__cta { display: flex; flex-wrap: wrap; gap: 12px; }
  .hero__art { max-width: 520px; width: 100%; margin-inline: auto; }
  .hub { width: 100%; height: auto; overflow: visible; }
  .hub__ring { fill: none; stroke: var(--accent); stroke-opacity: 0.35; stroke-width: 1.5; stroke-dasharray: 4 10; transform-origin: 240px 240px; }
  .hub__ring--1 { animation: drehen 60s linear infinite; }
  .hub__ring--2 { stroke-opacity: 0.18; animation: drehen 90s linear infinite reverse; }
  .hub__ring--3 { stroke-opacity: 0.25; animation: drehen 40s linear infinite reverse; }
  .hub__line { stroke: var(--accent); stroke-width: 2; stroke-dasharray: 6 8; stroke-opacity: 0.7; animation: fluss 1.6s linear infinite; }
  .hub__core { fill: var(--white); stroke: var(--accent); stroke-width: 3; }
  .hub__pulse { fill: var(--accent); opacity: 0.25; transform-origin: 240px 240px; animation: puls 2.8s ease-out infinite; }
  .hub__node { transform-box: fill-box; transform-origin: center; animation: schweben 4s ease-in-out infinite; color: var(--accent-ink); }
  .hub__node circle { fill: var(--white); stroke: var(--line); stroke-width: 1.5; filter: drop-shadow(0 6px 12px rgb(0 79 76 / 14%)); }
  @keyframes drehen { to { transform: rotate(360deg); } }
  @keyframes fluss { to { stroke-dashoffset: -28; } }
  @keyframes puls { 0% { transform: scale(1); opacity: 0.3; } 100% { transform: scale(1.7); opacity: 0; } }
  @keyframes schweben { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-6px); } }

  /* gemeinsame Ruhe-Regeln: gleiche Abstände, eine Akzentfarbe, keine Hover-Sprünge */
  .section h3 { font-size: 1.1rem; margin: 0 0 6px; }

  /* 1 STANDARDS */
  .standards { display: grid; gap: 32px; align-items: start; }
  @media (min-width: 960px) { .standards { grid-template-columns: 1fr 1.05fr; gap: 56px; } }
  .standards .section-head { margin-bottom: 20px; }
  .standards__text { color: var(--ink-soft); line-height: 1.7; max-width: 58ch; }
  .vergleich { background: var(--white); border: 1px solid var(--line); border-radius: 18px; overflow: hidden; }
  .vergleich__kopf, .vergleich__zeile { display: grid; grid-template-columns: 1fr 1fr; gap: 4px 20px; padding: 14px 22px; }
  .vergleich__kopf { background: var(--paper); font-size: 0.78rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-soft); }
  .vergleich__kopf span:last-child { color: var(--accent-ink); }
  .vergleich__zeile { border-top: 1px solid var(--line); line-height: 1.45; }
  .vergleich__thema { grid-column: 1 / -1; font-size: 0.8rem; font-weight: 700; color: var(--ink); }
  .vergleich__oft { color: var(--ink-soft); font-size: 0.95rem; }
  .vergleich__wir { display: flex; gap: 8px; align-items: flex-start; font-weight: 600; font-size: 0.95rem; }
  .vergleich__wir :global(.icon) { color: var(--accent-ink); flex: none; margin-top: 2px; }
  @media (max-width: 420px) { .vergleich__kopf, .vergleich__zeile { padding: 12px 16px; gap: 4px 14px; } }

  /* 2 SLAs */
  .sla { list-style: none; margin: 0 auto; padding: 0; display: grid; gap: 18px; max-width: 920px; }
  @media (min-width: 760px) { .sla { grid-template-columns: 1fr 1fr; gap: 24px; } }
  .sla__item { background: rgb(255 255 255 / 6%); border: 1px solid var(--dark-line); border-radius: 18px; padding: 28px 26px; display: grid; gap: 8px; justify-items: start; }
  .sla__ring { position: relative; width: 72px; height: 72px; display: grid; place-items: center; color: var(--accent); margin-bottom: 6px; }
  .sla__ring svg { position: absolute; inset: 0; transform: rotate(-90deg); }
  .sla__track { fill: none; stroke: var(--dark-line); stroke-width: 4; }
  .sla__bar { fill: none; stroke: var(--accent); stroke-width: 4; stroke-linecap: round; stroke-dasharray: 214; stroke-dashoffset: 0; }
  :global(html.js) .sla__item:not(.is-visible) .sla__bar { stroke-dashoffset: 214; }
  .sla__item.is-visible .sla__bar { animation: ring 1.4s cubic-bezier(.4,0,.2,1) both; }
  @keyframes ring { from { stroke-dashoffset: 214; } to { stroke-dashoffset: 0; } }
  .sla__label { font-size: 0.8rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--dark-soft); }
  .sla__wert { font-family: var(--font-head); font-size: clamp(1.3rem, 2.6vw, 1.6rem); line-height: 1.25; color: var(--white); }
  .sla__item p { margin: 0; color: var(--dark-lead); line-height: 1.6; }
  .platzhalter { background: #ffe58a; color: var(--ink); padding: 0 6px; border-radius: 4px; font-size: 0.8em; white-space: nowrap; }
  .zusagen { list-style: none; margin: 28px auto 0; padding: 0; max-width: 920px; display: grid; gap: 14px 24px; }
  @media (min-width: 760px) { .zusagen { grid-template-columns: 1fr 1fr; } }
  .zusagen li { display: flex; gap: 12px; align-items: flex-start; line-height: 1.5; color: var(--dark-lead); }
  .zusagen strong { color: var(--white); font-weight: 600; }
  .zusagen__icon { flex: none; display: grid; place-items: center; width: 36px; height: 36px; border-radius: 50%; border: 1px solid var(--dark-line); color: var(--accent); }
  .sla__hinweis { max-width: 920px; margin: 28px auto 0; font-size: 0.9rem; color: var(--dark-soft); text-align: center; }

  /* 3 TICKETSYSTEM – Ablauf in 4 Schritten (gleicher Stil wie die Hero-Linien: gestrichelt, fließend) */
  .ablauf { list-style: none; margin: 0; padding: 0; display: grid; gap: 28px; position: relative; }
  @media (min-width: 860px) {
    .ablauf { grid-template-columns: repeat(4, 1fr); gap: 24px; }
    .ablauf::before { content: ''; position: absolute; left: 12.5%; right: 12.5%; top: 38px; height: 3px; background: repeating-linear-gradient(90deg, var(--accent) 0 10px, transparent 10px 18px); background-size: 36px 3px; opacity: 0.6; animation: band 1.6s linear infinite; }
  }
  @media (max-width: 859px) {
    .ablauf::before { content: ''; position: absolute; left: 38px; top: 40px; bottom: 40px; width: 3px; background: repeating-linear-gradient(180deg, var(--accent) 0 10px, transparent 10px 18px); background-size: 3px 36px; opacity: 0.6; animation: band-v 1.6s linear infinite; }
  }
  @keyframes band { to { background-position: 36px 0; } }
  @keyframes band-v { to { background-position: 0 36px; } }
  :global(html.js) .ablauf.reveal { transform: none; opacity: 1; }
  .ablauf__schritt { position: relative; display: grid; justify-items: center; text-align: center; gap: 4px; }
  :global(html.js) .ablauf:not(.is-visible) .ablauf__schritt { opacity: 0; transform: translateY(12px); }
  .ablauf__schritt { transition: opacity 500ms ease, transform 500ms ease; transition-delay: calc(var(--i) * 350ms); }
  .ablauf__icon { position: relative; display: grid; place-items: center; width: 78px; height: 78px; border-radius: 50%; background: var(--white); border: 3px solid var(--accent); color: var(--accent-ink); margin-bottom: 10px; }
  .ablauf__nr { position: absolute; right: -4px; top: -4px; width: 26px; height: 26px; border-radius: 50%; background: var(--accent-ink); color: var(--white); font-size: 0.8rem; font-weight: 700; display: grid; place-items: center; }
  .ablauf__schritt p { margin: 0; color: var(--ink-soft); font-size: 0.97rem; line-height: 1.6; max-width: 30ch; }
  @media (max-width: 859px) {
    .ablauf__schritt { grid-template-columns: 78px 1fr; justify-items: start; text-align: left; column-gap: 18px; }
    .ablauf__icon { grid-row: span 2; margin-bottom: 0; }
    .ablauf__schritt h3 { align-self: end; margin: 0; }
    .ablauf__schritt p { align-self: start; }
  }

  /* 4 PROZESSE */
  .prozesse { display: grid; gap: 28px; }
  @media (min-width: 960px) { .prozesse { grid-template-columns: 0.9fr 1.1fr; gap: 56px; align-items: start; } }
  .prozesse .section-head { margin-bottom: 0; }
  .prozesse__liste { list-style: none; margin: 0; padding: 0; display: grid; gap: 22px; }
  .prozesse__liste li { display: flex; gap: 16px; align-items: flex-start; }
  .prozesse__liste p { margin: 0; color: var(--ink-soft); line-height: 1.7; }
  .prozesse__icon, .vertrauen__icon { flex: none; display: grid; place-items: center; width: 48px; height: 48px; border-radius: 50%; background: rgb(0 166 161 / 12%); color: var(--accent-ink); }

  /* 5 WERTE – ruhiges 3×2-Raster, weiße Karten (Jamil 20.10.2026), ohne Hover-Sprung */
  .werte { list-style: none; margin: 0; padding: 0; display: grid; gap: 20px; }
  @media (min-width: 720px) { .werte { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1000px) { .werte { grid-template-columns: repeat(3, 1fr); gap: 24px; } }
  .wert { background: var(--white); border: 1px solid var(--line); border-radius: 18px; padding: 28px 26px 30px; }
  .wert__icon { display: grid; place-items: center; width: 56px; height: 56px; border-radius: 50%; background: rgb(0 166 161 / 12%); color: var(--accent-ink); margin-bottom: 16px; }
  .wert__lead { margin: 0 0 10px; font-weight: 600; line-height: 1.45; color: var(--accent-ink); }
  .wert__text { margin: 0; font-size: 0.97rem; line-height: 1.7; color: var(--ink-soft); }
  @media (max-width: 420px) { .wert { padding: 24px 22px 26px; } }

  /* 6 VERTRAUEN */
  .vertrauen { list-style: none; margin: 0; padding: 0; display: grid; gap: 22px 32px; }
  @media (min-width: 640px) { .vertrauen { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1000px) { .vertrauen { grid-template-columns: repeat(3, 1fr); } }
  .vertrauen li { display: flex; gap: 14px; align-items: flex-start; }
  .vertrauen strong { display: block; font-family: var(--font-head); font-size: 1rem; margin-bottom: 2px; }
  .vertrauen li span:not(.vertrauen__icon) { color: var(--ink-soft); font-size: 0.95rem; line-height: 1.55; }

  /* 7 PRODUKTE – eine ruhige Karte, statische Grafik */
  .produkt { background: var(--white); border: 1px solid var(--line); border-radius: 20px; overflow: hidden; display: grid; }
  @media (min-width: 900px) { .produkt { grid-template-columns: 0.85fr 1.15fr; } }
  .produkt__art { min-height: 240px; display: grid; place-items: center; background: var(--dark); padding: 24px; }
  .produkt__body { padding: clamp(24px, 3.5vw, 36px); display: grid; gap: 8px; justify-items: start; align-content: center; }
  .produkt__body h3 { margin: 0; font-size: clamp(1.4rem, 2.4vw, 1.8rem); }
  .produkt__body p { margin: 0; color: var(--ink-soft); line-height: 1.65; }
  .produkt__slogan { font-family: var(--font-head); font-weight: 700; color: var(--accent-ink) !important; }
  .produkt__btn { margin-top: 12px; }
  .bausteine { list-style: none; margin: 8px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .bausteine li { display: inline-flex; align-items: center; gap: 6px; padding: 5px 12px; border-radius: 999px; background: var(--paper); border: 1px solid var(--line); font-size: 0.88rem; font-weight: 500; }
  .bausteine li :global(.icon) { color: var(--accent-ink); }
  .produkte__hinweis { margin: 20px 0 0; text-align: center; color: var(--ink-soft); }
  .browser { width: min(260px, 100%); background: var(--white); border-radius: 10px; padding: 8px; display: grid; gap: 7px; box-shadow: 0 16px 32px rgb(0 0 0 / 25%); }
  .browser__bar { display: flex; gap: 4px; }
  .browser__bar i { width: 7px; height: 7px; border-radius: 50%; background: var(--line); }
  .browser__hero { height: 52px; border-radius: 6px; background: var(--accent); }
  .browser__line { height: 7px; border-radius: 4px; background: var(--paper-2); width: 90%; }
  .browser__line--kurz { width: 60%; }
  .browser__tiles { display: grid; grid-template-columns: repeat(3, 1fr); gap: 5px; }
  .browser__tiles b { height: 28px; border-radius: 5px; background: rgb(0 166 161 / 18%); }

  /* 8 ANGEBOT */
  .pakete { list-style: none; margin: 0 auto; padding: 0; display: grid; gap: 20px; max-width: 920px; }
  @media (min-width: 760px) { .pakete { grid-template-columns: 1fr 1fr; gap: 24px; } }
  .paket { position: relative; background: var(--white); border: 1px solid var(--line); border-radius: 18px; padding: 28px 26px; display: grid; gap: 8px; align-content: start; justify-items: start; }
  .paket--top { border: 2px solid var(--accent); }
  .paket__tag { position: absolute; top: -13px; right: 22px; background: var(--accent-ink); color: var(--white); font-size: 0.78rem; font-weight: 700; letter-spacing: 0.06em; padding: 4px 12px; border-radius: 999px; }
  .paket h3 { margin: 0; font-size: 1.35rem; }
  .paket p { margin: 0; }
  .paket__kurz { color: var(--accent-ink); font-weight: 600; }
  .paket__preis strong { font-family: var(--font-head); font-size: 2.2rem; }
  .paket__preis span { color: var(--ink-soft); font-size: 0.9rem; }
  .paket__fuer { color: var(--ink-soft); line-height: 1.6; }
  .paket__liste { list-style: none; margin: 8px 0 16px; padding: 0; display: grid; gap: 8px; }
  .paket__liste li { display: flex; gap: 8px; align-items: flex-start; line-height: 1.45; }
  .paket__liste :global(.icon), .modell :global(.icon) { color: var(--accent-ink); flex: none; margin-top: 2px; }
  .modell { list-style: none; margin: 28px auto 0; padding: 0; max-width: 920px; display: flex; flex-wrap: wrap; justify-content: center; gap: 8px 22px; }
  .modell li { display: inline-flex; gap: 6px; align-items: center; font-weight: 500; }
  .angebot__inklusive { max-width: 920px; margin: 18px auto 0; text-align: center; color: var(--ink-soft); line-height: 1.7; }

  .ablauf__cta { text-align: center; margin: 36px 0 0; }

  /* 9 FAQ */
  .faq__liste { max-width: 780px; margin: 0 auto; display: grid; gap: 10px; }
  .faq__item { background: var(--white); border: 1px solid var(--line); border-radius: 14px; padding: 0 22px; }
  .faq__item summary { cursor: pointer; padding: 18px 0; font-weight: 600; font-family: var(--font-head); line-height: 1.4; list-style: none; display: flex; justify-content: space-between; gap: 16px; }
  .faq__item summary::-webkit-details-marker { display: none; }
  .faq__item summary::after { content: '+'; color: var(--accent-ink); font-size: 1.4rem; line-height: 1; flex: none; }
  .faq__item[open] summary::after { content: '–'; }
  .faq__item p { margin: 0 0 18px; color: var(--ink-soft); line-height: 1.7; }

  @media (prefers-reduced-motion: reduce) {
    .hub *, .ablauf::before { animation: none !important; }
    .sla__bar { animation: none !important; stroke-dashoffset: 0 !important; }
    .ablauf__schritt { opacity: 1 !important; transform: none !important; }
  }
</style>
