---
// HERO nach Jamils kompaktem Design-Briefing (Talk 3636). Die eigene Weg-Illustration mit Begriffen wurde entfernt
// (Jamil, Talk 3639: „das entfernen … zu viele Linien sonst. Stattdessen soll die Hauptlinie bereits dort beginnen,
// allerdings auch schon wellig.“). Hier beginnt jetzt die EINE Hauptlinie der Seite: ein Ausgangspunkt oben rechts,
// dann eine wellige graue Linie, die unten genau dort ankommt, wo sie in Schritt 1 (Wandel.astro) weiterläuft –
// Desktop in der Mitte, Handy links. Zeichnet sich einmal beim Laden; bei reduzierter Bewegung steht sie fertig da.
import Icon from '../Icon.astro';
import { href } from '../../lib/paths';
import { HERO } from '../../config/hauptseite';
---

<section class="hero" aria-labelledby="hero-h">
  <div class="wrap hero__grid">
    <div class="hero__text">
      <span class="eyebrow eyebrow--weg">{HERO.eyebrow}</span>
      <h1 id="hero-h">{HERO.pre}<span class="accent">{HERO.accent}</span></h1>
      <p class="hero__lead">{HERO.lead}</p>
      <div class="hero__cta">
        <a class="btn btn--primary btn--lg" href={href('/kontakt/')}>Kostenloses Erstgespräch <Icon name="arrow" size={18} /></a>
        <a class="btn btn--ghost btn--lg" href="#so-arbeiten-wir">So arbeiten wir <span aria-hidden="true">↓</span></a>
      </div>
    </div>
  </div>
  <div class="hlinie" aria-hidden="true">
    <svg viewBox="0 0 100 100" preserveAspectRatio="none" focusable="false"><path d="M 88 0 C 88 14, 52 10, 50 26 C 48 42, 82 44, 78 60 C 74 76, 0 70, 0 100" /></svg>
    <span class="hlinie__start"><Icon name="mail" size={18} /><span class="hlinie__label">Ihre Anfrage</span></span>
  </div>
</section>

<style>
  .hero { --spine-x: calc((100% - min(100% - 32px, var(--wrap))) / 2 + 14px); position: relative; background: var(--paper); padding-block: clamp(28px, 5vw, 64px) 0; }
  .hero__grid { display: grid; }
  .hero__text { padding-bottom: 196px; }
  .hero h1 { font-size: clamp(2.5rem, 10.5vw, 4.4rem); line-height: 1.02; letter-spacing: -0.04em; margin: 4px 0 20px; max-width: 12ch; }
  .hero__lead { font-size: clamp(1.08rem, 1.8vw, 1.25rem); line-height: 1.65; color: var(--ink-soft); max-width: 40ch; margin: 0 0 26px; }
  .hero__cta { display: flex; flex-wrap: wrap; gap: 12px; }
  @media (max-width: 480px) { .hero__cta .btn { width: 100%; } }

  /* Beginn der Hauptlinie: Handy unter dem Text von rechts nach links zur Linie, Desktop rechts neben dem Text zur Mitte */
  .hlinie { position: absolute; left: var(--spine-x); right: calc((100% - min(100% - 32px, var(--wrap))) / 2 + 20px); bottom: 0; height: 130px; pointer-events: none; }
  .hlinie svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .hlinie path { fill: none; stroke: #cdc6b8; stroke-width: 2.5; stroke-linecap: round; vector-effect: non-scaling-stroke; }
  /* Zeichnen von oben nach unten per Ausschnitt (stroke-dasharray verträgt sich nicht mit non-scaling-stroke) */
  .hlinie svg { animation: hl-zeichnen 1.6s ease-in-out both 0.85s; }
  /* Startpunkt der Reise: die Anfrage des Kunden macht sich auf den Weg (Jamil, Talk 3714/3719) */
  .hlinie__start { position: absolute; left: 88%; top: 0; display: grid; place-items: center; width: 40px; height: 40px; margin: -20px 0 0 -20px; border-radius: 50%; background: var(--paper); border: 2.5px solid #cdc6b8; color: #6f6a60; animation: hl-start 0.9s ease-out both; }
  .hlinie__label { position: absolute; right: calc(100% + 10px); top: 50%; transform: translateY(-50%); white-space: nowrap; font-size: 0.8rem; font-weight: 650; letter-spacing: 0.02em; color: #6f6a60; }
  /* erst erscheinen, dann „abschicken“ (kurzer Stups + Aufleuchten), danach zeichnet sich die Linie */
  @keyframes hl-start {
    0% { opacity: 0; transform: scale(0.5); }
    40% { opacity: 1; transform: none; border-color: #cdc6b8; }
    65% { transform: translate(-4px, 4px); border-color: var(--accent); color: var(--accent-ink); }
    100% { transform: none; border-color: #cdc6b8; }
  }
  @media (min-width: 960px) {
    .hero { --spine-x: 50%; }
    .hero__grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); column-gap: 112px; }
    .hero__text { padding-bottom: clamp(56px, 7vw, 96px); }
    .hero h1 { font-size: clamp(2.8rem, 4.6vw, 4.6rem); }
    .hlinie { top: clamp(60px, 9vw, 120px); height: auto; }
  }
  @keyframes hl-zeichnen { from { clip-path: inset(0 0 100% 0); } to { clip-path: inset(0 0 -10px 0); } }
</style>
