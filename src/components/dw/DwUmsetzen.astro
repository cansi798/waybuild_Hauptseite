---
// Szene „Umsetzen“ (Talk 4050/4091/4093/4109): Drei Erkenntnisse (Lupe, Glühbirne, Ziel) stehen in einer Reihe rechts
// neben dem Knoten, bleiben eine Weile stehen und fließen dann nacheinander hinein (das nächste zuerst). Der Knoten ist so
// groß wie die Lupe bei „Verstehen“ und trägt ein Funkeln (Erkenntnis). Danach läuft die Linie in eine allgemeine
// „Lösung“: Bausteine schieben sich zu einem fertigen Ganzen zusammen (kein Produktname). Ohne JS / reduzierte
// Bewegung: fertiges Bild.
import Icon from '../Icon.astro';
const W = 440, H = 440, CX = 220, KY = 124, RY = KY;
// Lösung: Rahmen mit vier Bausteinen (2 × 2)
const FX = 145, FY = 196, FS = 150, PAD = 10, GAP = 10, BS = (FS - 2 * PAD - GAP) / 2;
const f = (n: number) => n.toFixed(3);
const pc = (a: number, c: number) => `${((a / c) * 100).toFixed(2)}%`;
const erkenntnisse = [
  { icon: 'search', x: 280 },
  { icon: 'idee', x: 332 },
  { icon: 'target', x: 384 },
].map((e, k) => ({ ...e, k, ox: f(((e.x - CX) / W) * 100), oy: f(((RY - KY) / W) * 100), an: `auf:${f(0.02 + k * 0.03)}-${f(0.1 + k * 0.03)} fliessen:${f(0.3 + k * 0.08)}-${f(0.42 + k * 0.08)}` }));
const bausteine = [
  { x: FX + PAD, y: FY + PAD, von: 'links' },
  { x: FX + PAD + BS + GAP, y: FY + PAD, von: 'rechts' },
  { x: FX + PAD, y: FY + PAD + BS + GAP, von: 'links' },
  { x: FX + PAD + BS + GAP, y: FY + PAD + BS + GAP, von: 'rechts', akzent: true },
].map((b, k) => ({ ...b, k }));
const rahmen = `M ${CX} ${FY} H ${FX + FS - 14} A 14 14 0 0 1 ${FX + FS} ${FY + 14} V ${FY + FS - 14} A 14 14 0 0 1 ${FX + FS - 14} ${FY + FS} H ${FX + 14} A 14 14 0 0 1 ${FX} ${FY + FS - 14} V ${FY + 14} A 14 14 0 0 1 ${FX + 14} ${FY} Z`;
---
<div class="dw-bild dw-umsetzen" data-szene style={`aspect-ratio: ${W} / ${H}`}>
  <svg viewBox={`0 0 ${W} ${H}`} aria-hidden="true" focusable="false">
    <path class="dw-s" pathLength="1" d={`M ${CX} ${KY} L ${CX} ${FY}`} data-an="linear:0.6-0.66" />
    <rect class="dw-umsetzen__flaeche" x={FX} y={FY} width={FS} height={FS} rx="14" data-an="blende:0.64-0.7" />
    <path class="dw-s" pathLength="1" d={rahmen} data-an="zeichnen:0.64-0.76" />
    {bausteine.map((b) => <rect class:list={['dw-umsetzen__baustein', { 'dw-umsetzen__baustein--knopf': b.akzent }]} x={b.x} y={b.y} width={BS} height={BS} rx="8" data-an={`${b.von}:${f(0.7 + b.k * 0.04)}-${f(0.78 + b.k * 0.04)}`} />)}
    <path class="dw-s" pathLength="1" d={`M ${CX} ${FY + FS} L ${CX} ${H}`} data-an="linear:0.86-0.97" />
  </svg>

  {erkenntnisse.map((e) => (
    <span class="dw-pos" style={`left:${pc(CX, W)};top:${pc(KY, H)}`}>
      <span class="dw-umsetzen__erkenntnis" style={`--ox:${e.ox};--oy:${e.oy}`} data-an={e.an}><Icon name={e.icon as any} size={16} /></span>
    </span>
  ))}
  {/* Knoten „Erkenntnisse“: so groß wie die Lupe bei „Verstehen“, teilt sich wie alle Kreise */}
  <span class="dw-pos" style={`left:${pc(CX, W)};top:${pc(KY, H)}`}>
    <span class="dw-verstehen__kreis">
      <svg class="dw-verstehen__ring" viewBox="0 0 100 100" aria-hidden="true" focusable="false">
        <path class="dw-s dw-verstehen__ast" pathLength="1" d="M 50 1.5 A 48.5 48.5 0 0 0 50 98.5" data-an="linear:0.16-0.26" />
        <path class="dw-s dw-verstehen__ast" pathLength="1" d="M 50 1.5 A 48.5 48.5 0 0 1 50 98.5" data-an="linear:0.16-0.26" />
      </svg>
      <span class="dw-verstehen__fuell" data-an="blende:0.56-0.62"></span>
      <span class="dw-verstehen__lupe" data-an="blende:0.2-0.28"><Icon name="spark" size={22} /></span>
      <span class="dw-anker" style="left:50%;top:0" data-weg="ein"></span>
    </span>
  </span>
  {/* „aus“ steht nach dem Kreis-Anker „ein“: Wegpunkte zählen in Dokument-Reihenfolge */}
  <span class="dw-anker" style={`left:${pc(CX, W)};top:100%`} data-weg="aus"></span>
  <span class="dw-pos dw-pos--links" style={`left:calc(${pc(CX, W)} - 38px);top:${pc(KY, H)}`}>
    <span class="dw-umsetzen__notiz" data-an="auf:0.2-0.3">Erkenntnisse</span>
  </span>
  <span class="dw-pos" style={`left:${pc(CX, W)};top:${pc(FY + FS + 30, H)}`}>
    <span class="dw-umsetzen__ergebnis" data-an="auf:0.84-0.92"><Icon name="check" size={18} /> Lösung</span>
  </span>
</div>
