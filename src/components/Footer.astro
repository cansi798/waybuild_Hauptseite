---
import { company } from '../config/site';
import { href } from '../lib/paths';
import Logo from './Logo.astro';
import FooterKontakt from './FooterKontakt.astro';
import { PRODUKTE } from '../config/hauptseite';

const year = new Date().getFullYear();
---

<footer class="footer section--dark">
  <FooterKontakt />
  <div class="wrap footer__grid">
    <div>
      <Logo />
      <p class="footer__claim">Digitale Lösungen für Unternehmen – mit festen Service-Zusagen.</p>
    </div>
    <nav aria-label="Produkte">
      <h2 class="footer__h">Produkte</h2>
      <ul>
        {PRODUKTE.map((p) => <li>{p.url ? <a href={p.url}>{p.name}</a> : <span class="footer__soon">{p.name}</span>}</li>)}
      </ul>
    </nav>
    <div>
      <h2 class="footer__h">waybuild IT</h2>
      <ul>
        <li><a href={href('/#ueber')}>Über uns</a></li>
        <li><a href={href('/#zusagen')}>Service-Zusagen</a></li>
        <li><a href={href('/#ticketsystem')}>Ticketsystem</a></li>
        <li><a href={href('/#prozesse')}>Prozesse</a></li>
        <li><a href={href('/#werte')}>Wofür wir stehen</a></li>
        <li><a href={href('/kontakt/')}>Kontakt</a></li>
      </ul>
    </div>
    <div>
      <h2 class="footer__h">Rechtliches</h2>
      <ul>
        <li><a href={href('/impressum/')}>Impressum</a></li>
        <li><a href={href('/datenschutz/')}>Datenschutz</a></li>
        <li><a href={href('/agb/')}>AGB</a></li>
      </ul>
    </div>
  </div>
  <div class="wrap footer__bottom">
    <small>© {year} {company.legalName}</small>
  </div>
</footer>

<style>
  .footer { padding-block: 0 calc(28px + env(safe-area-inset-bottom)); }
  .footer__grid { padding-top: clamp(32px, 5vw, 48px); border-top: 1px solid var(--dark-line); display: grid; grid-template-columns: repeat(2, 1fr); gap: 28px 20px; }
  .footer__grid > :first-child { grid-column: 1 / -1; }
  @media (min-width: 900px) { .footer__grid { grid-template-columns: 1.6fr 1.2fr 1fr 1fr; gap: 36px; } .footer__grid > :first-child { grid-column: auto; } }
  .footer :global(.logo) { background: var(--white); border-radius: 12px; padding: 8px 12px; }
  .footer__claim { color: var(--dark-soft); margin-top: 16px; max-width: 32ch; }
  .footer__h { font-family: var(--font-body); font-size: 0.8rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--dark-soft); margin-bottom: 12px; }
  .footer ul { list-style: none; margin: 0; padding: 0; }
  .footer li a, .footer__soon { display: inline-block; padding: 6px 0; text-decoration: none; }
  .footer__soon { color: var(--dark-soft); }
  .footer li a:hover { color: var(--accent); }
  .footer__bottom { margin-top: 48px; padding-top: 20px; border-top: 1px solid var(--dark-line); color: var(--dark-soft); }
  @media (max-width: 599px) { .footer__bottom { margin-top: 28px; } }
</style>
