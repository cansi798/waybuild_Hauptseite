---
// Aufklapp-Liste für Fragen (FAQ-Seite und Auszüge). Das FAQPage-Markup steht NUR auf /faq/ (dort im Layout-Schema).
interface Props { items: { q: string; a: string }[] }
const { items } = Astro.props;
---

<div class="faq">
  {items.map((f) => (
    <details class="faq__item">
      <summary>{f.q}</summary>
      <p>{f.a}</p>
    </details>
  ))}
</div>

<style>
  .faq { display: grid; gap: 10px; }
  .faq__item { background: var(--white); border: 1px solid var(--line); border-radius: 16px; padding: 0 22px; }
  .faq__item[open] { border-color: var(--accent); }
  .faq__item summary { cursor: pointer; padding: 18px 0; font-weight: 600; font-family: var(--font-head); line-height: 1.4; list-style: none; display: flex; justify-content: space-between; gap: 16px; border-radius: 8px; }
  .faq__item summary::-webkit-details-marker { display: none; }
  .faq__item summary::after { content: '+'; color: var(--accent-ink); font-size: 1.4rem; line-height: 1; flex: none; }
  .faq__item[open] summary::after { content: '–'; }
  .faq__item p { margin: 0 0 18px; color: var(--ink-soft); line-height: 1.7; }
  @media (max-width: 420px) { .faq__item { padding: 0 16px; } }
</style>
