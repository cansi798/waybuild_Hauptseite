---
// /faq/ im Leitbild „Der Weg“ (27.10.2026). Allgemeine Fragen der Dachmarke (faqsAllgemein); FAQPage-Markup hier für die allgemeinen Fragen; die Website-Fragen haben ihr eigenes FAQPage-Markup auf /angebot/.
// Fragen zum Website-Produkt stehen auf dessen Produktseite (/angebot/#fragen).
import BaseLayout from '../layouts/BaseLayout.astro';
import WegTrenner from '../components/WegTrenner.astro';
import PageHeader from '../components/PageHeader.astro';
import Faq from '../components/Faq.astro';
import Icon from '../components/Icon.astro';
import { href } from '../lib/paths';
import { faqsAllgemein as faqs } from '../config/site';
import { WEBSITE_PRODUKT, produktName } from '../config/hauptseite';
---

<BaseLayout
  title="Häufige Fragen zu Waybuild"
  description="Antworten auf häufige Fragen zu Waybuild: was wir machen, unsere Zusagen für alle Produkte, Antwortzeiten, Erstgespräch und KI."
  breadcrumb={[{ name: 'Häufige Fragen', path: '/faq/' }]}
  schema={[{
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  }]}
>
  <PageHeader eyebrow="Häufige Fragen" title="Kurz und ehrlich" accent="beantwortet." lead="Ihre Frage ist nicht dabei? Schreiben Sie uns, wir antworten spätestens am nächsten Werktag." />
  <section class="section section--sand etappe" id="faq" aria-label="Fragen und Antworten">
    <WegTrenner variante={2} />
    <div class="wrap faq-wrap">
      <Faq items={faqs} />
      <p class="faq-weiter"><a class="pfeil-link" href={href('/angebot/#fragen')}>Fragen zum {produktName(WEBSITE_PRODUKT)} (Preise, Laufzeit, Domain) <Icon name="arrow" size={16} /></a></p>
    </div>
  </section>
</BaseLayout>

<style>
  .faq-wrap :global(.faq) { max-width: 820px; }
  .faq-weiter { margin: 28px 0 0; }
</style>
