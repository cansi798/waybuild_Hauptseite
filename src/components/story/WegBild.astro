---
// Verständnis-Illustration (Jamils kompaktes Design-Briefing, Talk 3636): links eine Schleife, in der Mitte ein
// Übergabepunkt, rechts eine klare Strecke, am Ende ein Ziel. Zeichnet sich einmal, wenn sie ins Bild scrollt
// (CSS scroll-driven); ohne Unterstützung oder bei reduzierter Bewegung steht sie fertig da.
---

<figure class="wegbild" aria-label="Grafik: Links eine graue Schleife voller Umwege, in der Mitte ein Übergabepunkt, rechts eine gerade türkise Strecke bis zum Ziel.">
  <svg viewBox="0 0 1000 250" aria-hidden="true" focusable="false">
    <path class="wb__grau" pathLength="1" d="M 20 130 C 60 130, 90 60, 150 70 C 220 82, 230 190, 170 196 C 110 202, 120 90, 210 84 C 300 78, 330 200, 270 200 C 220 200, 250 120, 330 118 C 380 117, 420 128, 460 130" />
    <path class="wb__tuerkis" pathLength="1" d="M 500 130 L 905 130" />
    <circle class="wb__uebergabe" cx="480" cy="130" r="18" />
    <circle class="wb__uebergabe-mitte" cx="480" cy="130" r="7" />
    <g class="wb__ziel"><circle cx="935" cy="130" r="26" /><circle cx="935" cy="130" r="14" /><circle class="wb__ziel-mitte" cx="935" cy="130" r="5.5" /></g>
  </svg>
  <figcaption class="wegbild__leg" aria-hidden="true">
    <span style="--x:16%">Umwege</span><span style="--x:48%">Übergabe</span><span style="--x:70%">Klare Strecke</span><span style="--x:93.5%">Ziel</span>
  </figcaption>
</figure>

<style>
  .wegbild { position: relative; margin: 0; padding: 18px 0 8px; background: var(--sec-bg, var(--paper)); view-timeline: --wegbild; }
  .wegbild svg { display: block; width: 100%; height: auto; overflow: visible; }
  .wegbild path { fill: none; stroke-linecap: round; stroke-linejoin: round; stroke-dasharray: 1; }
  .wb__grau { stroke: #b4ad9e; stroke-width: 4; }
  .wb__tuerkis { stroke: var(--accent); stroke-width: 5; }
  .wb__uebergabe { fill: var(--sec-bg, var(--paper)); stroke: var(--accent); stroke-width: 4; }
  .wb__uebergabe-mitte { fill: var(--accent); }
  .wb__ziel circle { fill: var(--sec-bg, var(--paper)); stroke: var(--accent); stroke-width: 4; }
  .wb__ziel .wb__ziel-mitte { fill: var(--accent-ink); stroke: none; }
  .wegbild__leg { position: relative; height: 1.6em; margin-top: 6px; font-size: clamp(0.72rem, 1.6vw, 0.9rem); font-weight: 650; letter-spacing: 0.04em; color: #6f6a60; }
  .wegbild__leg span { position: absolute; left: var(--x); transform: translateX(-50%); white-space: nowrap; }
  .wegbild__leg span:nth-child(n + 2) { color: var(--accent-ink); }
  @media (max-width: 599px) { .wegbild__leg span:nth-child(3) { display: none; } }
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .wb__grau, .wb__tuerkis { animation: wb-zeichnen linear both; }
      .wb__uebergabe, .wb__uebergabe-mitte, .wb__ziel { transform-box: fill-box; transform-origin: center; animation: wb-auf linear both; }
      figure.wegbild path.wb__grau { animation-timeline: --wegbild; animation-range: entry 30% cover 45%; }
      figure.wegbild circle.wb__uebergabe, figure.wegbild circle.wb__uebergabe-mitte { animation-timeline: --wegbild; animation-range: cover 44% cover 48%; }
      figure.wegbild path.wb__tuerkis { animation-timeline: --wegbild; animation-range: cover 47% cover 58%; }
      figure.wegbild g.wb__ziel { animation-timeline: --wegbild; animation-range: cover 57% cover 61%; }
    }
  }
  @keyframes wb-zeichnen { from { stroke-dashoffset: 1; } to { stroke-dashoffset: 0; } }
  @keyframes wb-auf { from { opacity: 0; transform: scale(0.4); } to { opacity: 1; transform: none; } }
</style>
