---
// Startseite „Denkweise“ nach Jamils Konzept (Talk 3798/3799) mit Feinschliff (Talk 3818, 30.10.2026).
// Die Linie zeigt keinen Projektablauf, sondern die Waybuild-Denkweise. Drei Teile statt vieler Einzelabschnitte
// (intern „Kapitel“, sichtbar ohne Kapitel-Marke – Jamil, Talk 3935: die Linie entsteht aus der Überschrift heraus):
//   Kapitel 1 · Veränderungen verstehen: Impuls, Verstehen (+ Frage 1), Hinterfragen (+ Frage 2)
//   Kapitel 2 · Veränderungen umsetzen: Entscheiden (statt Vereinfachen, Talk 3939), Umsetzen, Verbessern (Prozessreihenfolge, Jamil Talk 3922),
//   Produkte (eigene Karten, Website Service hervorgehoben)
//   Kapitel 3 · Veränderungen nachhaltig machen: Verlässlichkeit (dunkler Bereich, mit den drei Prinzipien auf der
//   Linie, danach Frage 3), Ihr Veränderungsprofil, Kontakt mit dem Kreis „Fortschritt“.
// Hero: die Prozess-Animation (Impuls → … → Verbessern) ist eine eigene, größere türkise Linie und endet bei
// „Verbessern“; die durchgehende Scroll-Linie beginnt erst unter der ersten Überschrift „Veränderungen verstehen“
// (Talk 3922/3935).
// Eine einzige SVG-Linie über die ganze Geschichte (src/scripts/denkweise.ts), Bildszenen in src/components/dw/,
// Veränderungs-Check (Fragen + Profil) vorerst entfernt (Talk 4045; Komponenten DwFrage/DwProfil bleiben im Repo). Die Unternehmens-DNA kommt seit Talk 4088 bei „Verstehen“ vor.
// Vorherige Fassung: Git-Tag startseite-v3-anfragereise-20261030; Komponenten in src/components/story/.
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import DwIdee from '../components/dw/DwIdee.astro';
import DwVerstehen from '../components/dw/DwVerstehen.astro';
import DwHinterfragen from '../components/dw/DwHinterfragen.astro';
import DwEntscheiden from '../components/dw/DwEntscheiden.astro';
import DwUmsetzen from '../components/dw/DwUmsetzen.astro';
import DwVerbessern from '../components/dw/DwVerbessern.astro';
import ZielRing from '../components/dw/ZielRing.astro';
import { href } from '../lib/paths';
import { BESCHREIBUNG } from '../config/hauptseite';
import {
  DW_HERO, DW_KAPITEL, DW_IDEE, DW_VERSTEHEN, DW_HINTERFRAGEN, DW_ENTSCHEIDEN, DW_UMSETZEN, DW_VERBESSERN,
  DW_PRINZIPIEN, DW_ABSCHLUSS, DW_PRODUKTE, DW_PRODUKTBEREICH, DW_PROZESS,
} from '../config/denkweise';
import '../styles/denkweise.css';

const K = DW_UMSETZEN.karte;
const [K1, K2, K3] = DW_KAPITEL;
---

<BaseLayout
  title="Website Service und digitale Produkte"
  description={BESCHREIBUNG}
  hideFooterKontakt
>
  <div class="dw" data-denkweise>
    <svg class="dw-linie" aria-hidden="true" focusable="false"><path class="dw-strich" d="" /></svg>

    <!-- HERO -->
    <section class="dw-abschnitt dw-hero" aria-labelledby="dw-h1">
      <div class="wrap dw-raster dw-raster--hero">
        <div class="dw-hero__text">
          <p class="eyebrow eyebrow--weg dw-hero__eyebrow">{DW_HERO.eyebrow}</p>
          <h1 id="dw-h1">{DW_HERO.titelVor}<span class="accent">{DW_HERO.titelAkzent}</span></h1>
          <p class="dw-hero__lead">{DW_HERO.lead}</p>
          {/* Talk 4202: am Handy kompakt und waagerecht – gerade Linie, sechs Knoten mit Symbol, Begriffe abwechselnd
              darüber/darunter; Lichtpunkt läuft beim Laden einmal entlang (reduzierte Bewegung: statisch) */}
          <div class="dw-pq" aria-hidden="true">
            <span class="dw-pq__schiene"><span class="dw-pl__licht"></span></span>
            <ol class="dw-pq__liste">
              {DW_PROZESS.map((s, i) => (
                <li class:list={['dw-pq__schritt', { 'dw-pq__schritt--anker': s.anker, 'dw-pq__schritt--oben': i % 2 === 1 }]} style={`--i:${i}`}>
                  <span class:list={['dw-pk', { 'dw-pk--anker': s.anker, 'dw-pk--ziel': s.ziel }]}>
                    {s.ziel ? <ZielRing /> : <Icon name={s.icon} size={s.anker ? 20 : 14} />}
                  </span>
                  <span class="dw-pq__wort">{s.wort}</span>
                </li>
              ))}
            </ol>
          </div>
          <div class="dw-hero__aktionen">
            <a class="btn btn--primary btn--lg" href={href('/kontakt/')}>{DW_HERO.cta} <Icon name="arrow" size={18} /></a>
            <a class="pfeil-link" href={href('/angebot/')}>{DW_HERO.link} <Icon name="arrow" size={16} /></a>
          </div>
        </div>
        {/* Talk 4202: Hero-Prozessbild hochwertiger – ruhige Karte, gerade Linie mit feinem Verlauf und Lichthof, jeder
            Schritt ein sauberer Knoten mit eigenem Symbol, Impuls und Verbessern als Anker; beim Laden läuft einmal ein
            Lichtpunkt die Linie hinab und die Knoten leuchten nacheinander auf (reduzierte Bewegung: statisch).
            Jeder Schritt springt zu seinem Abschnitt. Vorher: geschwungene Linie mit kleinen Kreisen (Talk 4057–4114). */}
        <nav class="dw-pl" aria-label="Die Waybuild-Denkweise in sechs Schritten">
          <span class="dw-pl__schiene" aria-hidden="true"><span class="dw-pl__licht"></span></span>
          <ol class="dw-pl__liste">
            {DW_PROZESS.map((s, i) => (
              <li class:list={['dw-pl__schritt', { 'dw-pl__schritt--anker': s.anker }]} style={`--i:${i}`}>
                <a class="dw-pl__link" href={`#${s.ziel_id}`}>
                  <span class:list={['dw-pk', { 'dw-pk--anker': s.anker, 'dw-pk--ziel': s.ziel }]} aria-hidden="true">
                    {s.ziel ? <ZielRing /> : <Icon name={s.icon} size={s.anker ? 26 : 18} />}
                  </span>
                  <span class="dw-pl__text">
                    <span class="dw-pl__wort">{s.wort}</span>
                    <span class="dw-pl__kurz">{s.kurz}</span>
                  </span>
                </a>
              </li>
            ))}
          </ol>
        </nav>
      </div>
    </section>

    <!-- ═══ KAPITEL 1 · Teil-Kopf entfernt (Talk 4179, wie schon Talk 4088): Überschrift und Kernsatz stehen bei „Verstehen“;
         die Scroll-Linie beginnt beim Impuls (Desktop oben an der Szene mit Startpunkt, Handy links an der Kennzeile) ═══ -->
    <section class="dw-kapitel" id={K1.id} aria-labelledby="k1-h">
      <h2 class="sr-only" id="k1-h">Unsere Denkweise: vom Impuls zur passenden Lösung</h2>
      <!-- Impuls (erster Schritt, bis Talk 4132 „Idee“) -->
      <div class="dw-abschnitt" id="denkweise">
        <div class="wrap dw-raster dw-raster--spiegel">
          <div class="dw-text reveal">
            {/* Talk 4179: am Handy beginnt die Scroll-Linie hier, links an der Kennzeile (Startpunkt) */}
            <span class="dw-linienstart dw-nur-m" aria-hidden="true"></span>
            <span class="dw-wp" data-weg data-weg-nur="m" data-weg-x="links"></span>
            <span class="dw-kenn"><Icon name="impuls" size={18} /> Impuls</span>
            <h3 class="dw-idee-titel" aria-label={DW_IDEE.zeilen.join(' ')}>{DW_IDEE.zeilen.map((z) => <span>{z}</span>)}</h3>
            <p class="dw-idee-gefuehl">{DW_IDEE.gefuehl}</p>
            <blockquote class="dw-zitat dw-zitat--gross">„{DW_IDEE.zitat}“</blockquote>
            <p>{DW_IDEE.schluss}</p>
            <span class="dw-wp" data-weg data-weg-nur="m" data-weg-x="links"></span>
          </div>
          <DwIdee />
        </div>
      </div>

      <!-- Verstehen -->
      <div class="dw-abschnitt" id="verstehen">
        <div class="wrap dw-raster">
          <div class="dw-text reveal">
            <span class="dw-wp" data-weg data-weg-nur="m" data-weg-x="links"></span>
            <span class="dw-kenn"><Icon name="search" size={18} /> Verstehen</span>
            <h3>{DW_VERSTEHEN.titel}</h3>
            <p class="dw-unterzeile">{DW_VERSTEHEN.unterzeile}</p>
            <p>{DW_VERSTEHEN.einleitung} {DW_VERSTEHEN.aspekte}</p>
            <p class="dw-zeilen dw-zeilen--betont">{DW_VERSTEHEN.dna.map((z) => <span>{z}</span>)}</p>
            <p>{DW_VERSTEHEN.dnaText}</p>
            <span class="dw-wp" data-weg data-weg-nur="m" data-weg-x="links"></span>
          </div>
          <DwVerstehen />
        </div>
      </div>

      <!-- Hinterfragen -->
      <div class="dw-abschnitt" id="hinterfragen">
        <div class="wrap dw-raster dw-raster--spiegel">
          <div class="dw-text reveal">
            <span class="dw-wp" data-weg data-weg-nur="m" data-weg-x="links"></span>
            <span class="dw-kenn"><Icon name="frage" size={18} /> Hinterfragen</span>
            <h3>{DW_HINTERFRAGEN.titel}</h3>
            <p class="dw-zeilen">{DW_HINTERFRAGEN.zeilen.map((z) => <span>{z}</span>)}</p>
            <p>{DW_HINTERFRAGEN.schluss}</p>
            <p class="dw-zeilen dw-botschaft">{DW_HINTERFRAGEN.botschaft.map((z) => <span>{z}</span>)}</p>
            <span class="dw-wp" data-weg data-weg-nur="m" data-weg-x="links"></span>
          </div>
          <DwHinterfragen />
        </div>
      </div>
    </section>

    <!-- ═══ KAPITEL 2 (Überschrift „Veränderungen umsetzen“ entfernt, Talk 4049) ═══ -->
    <section class="dw-kapitel" id={K2.id} aria-label={K2.titel}>

      <!-- Entscheiden (Talk 3938/3939, ersetzt „Vereinfachen“) -->
      <div class="dw-abschnitt" id="entscheiden">
        <div class="wrap dw-raster">
          <div class="dw-text reveal">
            <span class="dw-wp" data-weg data-weg-nur="m" data-weg-x="links"></span>
            <span class="dw-kenn"><Icon name="target" size={18} /> Entscheiden</span>
            <h3>{DW_ENTSCHEIDEN.titel}</h3>
            <p class="dw-zeilen">{DW_ENTSCHEIDEN.zeilen.map((z) => <span>{z}</span>)}</p>
            <p class="dw-zeilen dw-zeilen--betont">{DW_ENTSCHEIDEN.ziel.map((z) => <span>{z}</span>)}</p>
            <span class="dw-wp" data-weg data-weg-nur="m" data-weg-x="links"></span>
          </div>
          <DwEntscheiden />
        </div>
      </div>

      <!-- Umsetzen -->
      <div class="dw-abschnitt" id="umsetzen">
        <div class="wrap dw-raster dw-raster--spiegel">
          <div class="dw-text reveal">
            <span class="dw-wp" data-weg data-weg-nur="m" data-weg-x="links"></span>
            <span class="dw-kenn"><Icon name="rocket" size={18} /> Umsetzen</span>
            <h3>{DW_UMSETZEN.titel}</h3>
            <p class="dw-zeilen">{DW_UMSETZEN.zeilen.map((z) => <span>{z}</span>)}</p>
            <p>{DW_UMSETZEN.bruecke}</p>
            <span class="dw-wp" data-weg data-weg-nur="m" data-weg-x="links"></span>
          </div>
          <DwUmsetzen />
        </div>
      </div>

      <!-- Verbessern: direkt nach Umsetzen (Prozessreihenfolge, Jamil Talk 3922) -->
      <div class="dw-abschnitt" id="verbessern">
        <div class="wrap dw-raster">
          <div class="dw-text reveal">
            <span class="dw-wp" data-weg data-weg-nur="m" data-weg-x="links"></span>
            <span class="dw-kenn"><Icon name="chart" size={18} /> Verbessern</span>
            <h3>{DW_VERBESSERN.titel}</h3>
            <p class="dw-unterzeile">{DW_VERBESSERN.unterzeile}</p>
            <p>{DW_VERBESSERN.text}</p>
            <span class="dw-wp" data-weg data-weg-nur="m" data-weg-x="links"></span>
          </div>
          <DwVerbessern />
        </div>
      </div>

      <!-- Produkte: jede als eigene Karte, an die Linie angedockt; Website Service hervorgehoben; seit Talk 4176 ohne Einblenden (sofort sichtbar) -->
      <!-- Ab hier ohne Linie (Talk 4083): die Scroll-Linie endet am Verbessern-Kreis -->
      <div class="dw-abschnitt dw-abschnitt--eng dw-ohne-linie" id="produkte" aria-labelledby="dw-produkte-h">
        <div class="wrap">
          <h3 class="dw-mitteltitel" id="dw-produkte-h">{DW_PRODUKTBEREICH.titel}</h3>
          <div class="dw-andock dw-andock--raster" data-szene>
            <ul class="dw-andock__liste">
              <li class="dw-andock__item dw-andock__item--l">
                <article class="k k--akzent dw-produkt dw-produkt--hervor" aria-labelledby="dw-p-web">
                  <span class="k__icon"><Icon name="layout" size={22} /></span>
                  <div class="k__inhalt">
                    <p class="dw-produkt__name">{DW_PRODUKTBEREICH.hauptprodukt}</p>
                    <h4 id="dw-p-web">{K.titel}</h4>
                    <p class="dw-produkt__nutzen">{K.kenn}</p>
                    <p>{K.text}</p>
                    <ul class="dw-haken">{K.punkte.map((p) => <li><Icon name="check" size={16} /> {p}</li>)}</ul>
                    <p class="dw-produkt__preis">{K.preis}</p>
                    <a class="btn btn--primary" href={href('/angebot/')}>{K.cta} <Icon name="arrow" size={18} /></a>
                  </div>
                </article>
              </li>
              {DW_PRODUKTE.map((p, i) => (
                <li class:list={['dw-andock__item', i % 2 ? 'dw-andock__item--l' : 'dw-andock__item--r']}>
                  <article class="k dw-produkt" aria-labelledby={`dw-p-${p.id}`}>
                    <span class="k__icon"><Icon name={p.icon} size={22} /></span>
                    <div class="k__inhalt">
                      <h4 id={`dw-p-${p.id}`}>{p.name}</h4>
                      <p class="dw-produkt__nutzen">{p.nutzen}</p>
                      <p>{p.text}</p>
                      <a class="pfeil-link dw-produkt__cta" href={href('/kontakt/')}>Anfragen <Icon name="arrow" size={16} /></a>
                    </div>
                  </article>
                </li>
              ))}
              <li class:list={['dw-andock__item', DW_PRODUKTE.length % 2 ? 'dw-andock__item--l' : 'dw-andock__item--r']}>
                <article class="k dw-produkt dw-produkt--individuell" aria-labelledby="dw-p-individuell">
                  <span class="k__icon"><Icon name={DW_PRODUKTBEREICH.individuell.icon} size={22} /></span>
                  <div class="k__inhalt">
                    <p class="dw-produkt__name">{DW_PRODUKTBEREICH.individuell.kenn}</p>
                    <h4 id="dw-p-individuell">{DW_PRODUKTBEREICH.individuell.name}</h4>
                    <p>{DW_PRODUKTBEREICH.individuell.text}</p>
                    <a class="pfeil-link dw-produkt__cta" href={href('/kontakt/')}>Anfragen <Icon name="arrow" size={16} /></a>
                  </div>
                </article>
              </li>
            </ul>
            <p class="dw-produkte__folgt" data-an="auf:auto"><Icon name="spark" size={16} /> {DW_PRODUKTBEREICH.folgt}</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══ KAPITEL 3: Prinzipien (Talk 4087) und Kontakt · ohne Linie (Talk 4083) ═══ -->
    <section class="dw-kapitel dw-ohne-linie" id={K3.id} aria-label={K3.titel}>
      <!-- Unsere drei Prinzipien (Talk 4087, ersetzt „Verlässlichkeit“): seit Talk 4177 auf normalem Seitengrund, die Karten bleiben türkis; ohne Linie -->
      <div class="dw-prinzipien" id="prinzipien">
        <span id="verlaesslichkeit" class="dw-alt-anker"></span>
        <div class="dw-abschnitt">
          <div class="wrap">
            <h2 class="dw-prinzipien__titel" id="dw-prinzipien-h">{DW_PRINZIPIEN.titel}</h2>
            <div class="dw-prinzipien__raster" data-szene>
              {DW_PRINZIPIEN.liste.map((p, i) => (
                <article class="dw-prinzip-karte" aria-labelledby={`dw-pr-${i}`}>
                  <span class="dw-prinzip-karte__icon"><Icon name={p.icon} size={24} /></span>
                  <h3 id={`dw-pr-${i}`}>{p.wort}</h3>
                  <p class="dw-prinzip-karte__kern">{p.kern}</p>
                  {p.text.map((t) => <p>{t}</p>)}
                  {p.einleitung && <p class="dw-prinzip-karte__einleitung">{p.einleitung}</p>}
                  <ul class="dw-prinzip-karte__liste">{p.punkte.map((x) => <li><Icon name="check" size={16} /> {x}</li>)}</ul>
                  <p class="dw-prinzip-karte__schluss">{p.schluss}</p>
                </article>
              ))}
            </div>
          </div>
        </div>
      </div>

      <!-- Kontakt -->
      <div class="dw-abschnitt dw-abschluss" id="kontakt-start" aria-labelledby="dw-abschluss-h">
        <div class="wrap">
          <div class="dw-text reveal">
            <h2 id="dw-abschluss-h" class="dw-abschluss__titel">{DW_ABSCHLUSS.titelVor}<span class="accent">{DW_ABSCHLUSS.titelAkzent}</span></h2>
            <p class="dw-zeilen">{DW_ABSCHLUSS.zeilen.map((z) => <span>{z}</span>)}</p>
            <p class="dw-einladung">{DW_ABSCHLUSS.einladung}</p>
            <a class="btn btn--primary btn--lg" href={href('/kontakt/')}>{DW_ABSCHLUSS.cta} <Icon name="arrow" size={18} /></a>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  import '../scripts/denkweise';
</script>
