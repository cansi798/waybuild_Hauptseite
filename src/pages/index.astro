---
// Startseite „Komplettes Umdenken“ (Jamil, Talk k8oxzjva #4544, 04.11.2026): zehn Abschnitte in seiner Reihenfolge –
// Hero, Warum es Waybuild gibt, Für wen, Wofür wir stehen, Zusammenarbeit, Entscheidungen (bewusst vor den Produkten),
// Lösungen, Projekte und Ergebnisse, Darauf können Sie sich verlassen, Abschluss – dazu das Footer-Markenstatement.
// Texte wörtlich in src/config/startseite.ts. Jeder Abschnitt endet mit einer leisen Besucherfrage (HsFrage).
// Animationen mit der Waybuild-Linie über die vorhandene Engine (src/scripts/denkweise.ts: Szenen [data-szene], Spuren
// [data-an], nur transform/opacity/stroke-dashoffset, reduzierte Bewegung = Endzustand); Hero-Verwandlung einmalig per CSS.
// Vorherige Startseite „Denkweise“: Branch vor-umdenken-20261104 (Komponenten src/components/dw/ bleiben für /ueber-uns/).
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import HsFrage from '../components/hs/HsFrage.astro';
import HsHeroBild from '../components/hs/HsHeroBild.astro';
import HsSystem from '../components/hs/HsSystem.astro';
import HsSortieren from '../components/hs/HsSortieren.astro';
import HsStationen from '../components/hs/HsStationen.astro';
import HsErgebnis from '../components/hs/HsErgebnis.astro';
import { href } from '../lib/paths';
import { BESCHREIBUNG } from '../config/hauptseite';
import {
  HS_HERO, HS_WARUM, HS_FUER_WEN, HS_HALTUNG, HS_ZUSAMMENARBEIT, HS_ENTSCHEIDUNGEN, HS_LOESUNGEN, HS_ERGEBNISSE,
  HS_VERLASSEN, HS_ABSCHLUSS,
} from '../config/startseite';
import '../styles/startseite.css';

const f = (n: number) => n.toFixed(3);
// Wofür wir stehen: vier Karten nacheinander, die Linie verbindet sie
const nH = HS_HALTUNG.grundsaetze.length;
const haltung = HS_HALTUNG.grundsaetze.map((g, i) => {
  const a = 0.04 + i * 0.17, n = 0.04 + (i + 1) * 0.17;
  return { ...g, karte: `auf:${f(a)}-${f(a + 0.1)}`, stiel: `hoch:${f(a - 0.03)}-${f(a + 0.03)}`, stielM: `breit:${f(a - 0.03)}-${f(a + 0.03)}`,
    seg: i < nH - 1 ? `breit:${f(a + 0.04)}-${f(n - 0.02)}` : '', segM: i < nH - 1 ? `hoch:${f(a + 0.04)}-${f(n - 0.02)}` : '' };
});
// Lösungen: eine Linie, drei Produktzweige, alle Äste führen zurück zur Hauptlinie
const ZX = [200, 600, 1000];
const zweige = HS_LOESUNGEN.produkte.map((p, i) => {
  const a = 0.12 + i * 0.12, z = 0.56 + i * 0.07;
  return { ...p, x: ZX[i], hin: `zeichnen:${f(a)}-${f(a + 0.12)}`, zurueck: `zeichnen:${f(z)}-${f(z + 0.1)}`, karte: `auf:${f(a + 0.08)}-${f(a + 0.18)}`,
    stielM: `breit:${f(a + 0.04)}-${f(a + 0.1)}`, segM: i < 2 ? `hoch:${f(a + 0.1)}-${f(a + 0.2)}` : '' };
});
---

<BaseLayout title="Website Service und digitale Lösungen" description={BESCHREIBUNG} hideFooterKontakt>
  <div class="dw hs" data-denkweise>
    {/* Die Engine erwartet die (hier ungenutzte) seitenweite Linie; alle Linien liegen in den Szenen selbst */}
    <svg class="dw-linie" aria-hidden="true" focusable="false"><path class="dw-strich" d="" /></svg>

    <!-- 1 · HERO -->
    <section class="hs-abschnitt hs-hero" id="start" aria-labelledby="hs-h1">
      <div class="wrap hs-hero__raster">
        <div class="hs-hero__text">
          <h1 id="hs-h1">{HS_HERO.titel[0]} <span class="hs-hero__zeile">{HS_HERO.titel[1]}<span class="accent">{HS_HERO.titelAkzent}</span></span></h1>
          <p class="hs-hero__sub">{HS_HERO.sub.map((z) => <span>{z}</span>)}</p>
          <p class="hs-hero__sub2">{HS_HERO.sub2}</p>
          <div class="hs-aktionen">
            <a class="btn btn--primary btn--lg" href={href('/produkte/')}>{HS_HERO.ctaPrimaer} <Icon name="arrow" size={18} /></a>
            <a class="btn btn--ghost btn--lg" href="#warum">{HS_HERO.ctaSekundaer}</a>
          </div>
        </div>
        <HsHeroBild />
      </div>
    </section>

    <!-- 2 · WARUM ES WAYBUILD GIBT -->
    <section class="hs-abschnitt" id="warum" aria-labelledby="hs-warum-h">
      <div class="wrap">
        <div class="hs-raster">
          <div class="hs-text reveal">
            <h2 id="hs-warum-h">{HS_WARUM.titel}</h2>
            <p class="hs-zeilen">{HS_WARUM.einleitung.map((z) => <span>{z}</span>)}</p>
            <ul class="hs-punkte">{HS_WARUM.probleme.map((p) => <li>{p}</li>)}</ul>
            <p class="hs-zeilen">{HS_WARUM.ursache.map((z) => <span>{z}</span>)}</p>
            <p class="hs-ziel"><span>{HS_WARUM.ziel}</span> <strong>{HS_WARUM.zielSatz}</strong></p>
          </div>
          <HsSystem />
        </div>
        <HsFrage f={HS_WARUM.frage} />
      </div>
    </section>

    <!-- 3 · FÜR WEN WAYBUILD GEMACHT IST -->
    <section class="hs-abschnitt" id="fuer-wen" aria-labelledby="hs-fuerwen-h">
      <div class="wrap">
        <div class="hs-raster">
          <div class="hs-text reveal">
            <h2 id="hs-fuerwen-h">{HS_FUER_WEN.titel}</h2>
            <p class="hs-zeilen hs-zeilen--betont">{HS_FUER_WEN.zeilen.map((z) => <span>{z}</span>)}</p>
            <p>{HS_FUER_WEN.text}</p>
            <p class="hs-zeilen">{HS_FUER_WEN.nachsatz.map((z) => <span>{z}</span>)}</p>
          </div>
          <div class="hs-karte hs-erwartungen reveal">
            <h3>{HS_FUER_WEN.erwartungenTitel}</h3>
            <ul class="hs-haken">{HS_FUER_WEN.erwartungen.map((e) => <li><Icon name="check" size={16} /> {e}</li>)}</ul>
          </div>
        </div>
        <HsFrage f={HS_FUER_WEN.frage} />
      </div>
    </section>

    <!-- 4 · WOFÜR WAYBUILD STEHT -->
    <section class="hs-abschnitt" id="prinzipien" aria-labelledby="hs-haltung-h">
      <span id="verlaesslichkeit" class="hs-alt-anker"></span>
      <div class="wrap">
        <div class="hs-kopf reveal">
          <h2 id="hs-haltung-h">{HS_HALTUNG.titel}</h2>
          <p class="hs-zeilen">{HS_HALTUNG.zeilen.map((z) => <span>{z}</span>)}</p>
          <p class="hs-zeilen--betont">{HS_HALTUNG.bleibt}</p>
        </div>
        <div class="hs-haltung" data-szene>
          <ul class="hs-haltung__liste">
            {haltung.map((g) => (
              <li class="hs-haltung__item">
                <span class="hs-stiel hs-nur-d" data-an={g.stiel} aria-hidden="true"></span>
                <span class="hs-stiel hs-stiel--m hs-nur-m" data-an={g.stielM} aria-hidden="true"></span>
                {g.seg && <span class="hs-seg hs-nur-d" data-an={g.seg} aria-hidden="true"></span>}
                {g.segM && <span class="hs-seg hs-seg--m hs-nur-m" data-an={g.segM} aria-hidden="true"></span>}
                <article class="hs-karte hs-grundsatz" data-an={g.karte}>
                  <span class="hs-symbol"><Icon name={g.icon} size={22} /></span>
                  <h3>{g.wort}</h3>
                  {g.text.map((t) => <p>{t}</p>)}
                </article>
              </li>
            ))}
          </ul>
          <p class="hs-ende" data-an="auf:0.74-0.86">{HS_HALTUNG.ende}</p>
        </div>
        <HsFrage f={HS_HALTUNG.frage} mitte />
      </div>
    </section>

    <!-- 5 · SO SOLL SICH ZUSAMMENARBEIT ANFÜHLEN -->
    <section class="hs-abschnitt" id="zusammenarbeit" aria-labelledby="hs-zus-h">
      <div class="wrap">
        <div class="hs-raster hs-raster--spiegel">
          <div class="hs-text reveal">
            <h2 id="hs-zus-h">{HS_ZUSAMMENARBEIT.titel}</h2>
            {HS_ZUSAMMENARBEIT.text.map((t) => <p>{t}</p>)}
            <h3 class="hs-unter">{HS_ZUSAMMENARBEIT.erlebenTitel}</h3>
            <ul class="hs-haken hs-haken--zwei">{HS_ZUSAMMENARBEIT.erleben.map((e) => <li><Icon name="check" size={16} /> {e}</li>)}</ul>
            <p class="hs-zeilen hs-zeilen--betont">{HS_ZUSAMMENARBEIT.zusatz.map((z) => <span>{z}</span>)}</p>
          </div>
          <HsSortieren />
        </div>
        <HsFrage f={HS_ZUSAMMENARBEIT.frage} />
      </div>
    </section>

    <!-- 6 · WIE WIR ENTSCHEIDUNGEN TREFFEN (bewusst vor den Produkten) -->
    <section class="hs-abschnitt" id="denkweise" aria-labelledby="hs-ent-h">
      {/* frühere Sprungziele der Denkweise-Seite (z. B. von /ueber-uns/) landen hier */}
      {['impuls', 'verstehen', 'hinterfragen', 'entscheiden', 'umsetzen', 'verbessern'].map((id) => <span id={id} class="hs-alt-anker"></span>)}
      <div class="wrap">
        <div class="hs-raster">
          <div class="hs-text reveal">
            <h2 id="hs-ent-h">{HS_ENTSCHEIDUNGEN.titel}</h2>
            <p>{HS_ENTSCHEIDUNGEN.einleitung}</p>
            <ul class="hs-fragen">{HS_ENTSCHEIDUNGEN.fragen.map((q) => <li><Icon name="frage" size={16} /> {q}</li>)}</ul>
            <p class="hs-zeilen--betont">{HS_ENTSCHEIDUNGEN.danach}</p>
          </div>
          <HsStationen />
        </div>
        <HsFrage f={HS_ENTSCHEIDUNGEN.frage} />
      </div>
    </section>

    <!-- 7 · UNSERE LÖSUNGEN -->
    <section class="hs-abschnitt" id="loesungen" aria-labelledby="hs-loe-h">
      <span id="produkte" class="hs-alt-anker"></span>
      <div class="wrap">
        <div class="hs-kopf reveal">
          <h2 id="hs-loe-h">{HS_LOESUNGEN.titel}</h2>
          <p class="hs-zeilen">{HS_LOESUNGEN.text.map((z) => <span>{z}</span>)}</p>
          <ul class="hs-chips" aria-label="Unsere Grundlage">{HS_LOESUNGEN.prinzipien.map((p) => <li>{p}</li>)}</ul>
        </div>
        <div class="hs-zweige" data-szene>
          <svg class="hs-zweige__band hs-nur-d" viewBox="0 0 1200 90" preserveAspectRatio="none" aria-hidden="true" focusable="false">
            <path class="dw-s" pathLength="1" d="M0 14 L1200 14" data-an="linear:0.02-0.5" />
            {zweige.map((z) => (
              <>
                <path class="dw-s" pathLength="1" d={`M${z.x - 90} 14 C${z.x - 50} 14 ${z.x} 40 ${z.x} 88`} data-an={z.hin} />
                <path class="dw-s" pathLength="1" d={`M${z.x} 88 C${z.x} 40 ${z.x + 50} 14 ${z.x + 90} 14`} data-an={z.zurueck} />
              </>
            ))}
          </svg>
          <ul class="hs-zweige__liste">
            {zweige.map((z, i) => (
              <li class="hs-zweige__item">
                <span class="hs-stiel hs-stiel--m hs-nur-m" data-an={z.stielM} aria-hidden="true"></span>
                {z.segM && <span class="hs-seg hs-seg--m hs-nur-m" data-an={z.segM} aria-hidden="true"></span>}
                <article class:list={['hs-karte hs-produkt', { 'hs-produkt--haupt': i === 0 }]} data-an={z.karte} aria-labelledby={`hs-p-${i}`}>
                  <span class="hs-symbol"><Icon name={z.icon} size={22} /></span>
                  <h3 id={`hs-p-${i}`}>{z.name}</h3>
                  <p class="hs-zeilen">{z.text.map((t) => <span>{t}</span>)}</p>
                  <a class="pfeil-link" href={href(z.pfad)}>{z.link} <Icon name="arrow" size={16} /><span class="sr-only">: {z.name}</span></a>
                </article>
              </li>
            ))}
          </ul>
          <p class="hs-ende" data-an="auf:0.8-0.92">{HS_LOESUNGEN.ende}</p>
        </div>
        <HsFrage f={HS_LOESUNGEN.frage} mitte />
      </div>
    </section>

    <!-- 8 · PROJEKTE UND ERGEBNISSE (noch ohne freigegebene Referenzen: nur der Ablauf) -->
    <section class="hs-abschnitt" id="ergebnisse" aria-labelledby="hs-erg-h">
      <div class="wrap">
        <div class="hs-kopf reveal">
          <h2 id="hs-erg-h">{HS_ERGEBNISSE.titel}</h2>
          <p class="hs-zeilen hs-zeilen--betont">{HS_ERGEBNISSE.zeilen.map((z) => <span>{z}</span>)}</p>
        </div>
        <HsErgebnis />
        <HsFrage f={HS_ERGEBNISSE.frage} mitte />
      </div>
    </section>

    <!-- 9 · DARAUF KÖNNEN SIE SICH VERLASSEN -->
    <section class="hs-abschnitt" id="erwartungen" aria-labelledby="hs-ver-h">
      <div class="wrap">
        <div class="hs-kopf reveal">
          <h2 id="hs-ver-h">{HS_VERLASSEN.titel}</h2>
        </div>
        <ul class="hs-zusagen reveal">{HS_VERLASSEN.erwartungen.map((e) => <li><Icon name="check" size={18} /> {e}</li>)}</ul>
        <p class="hs-zusatz reveal">{HS_VERLASSEN.zusatz.map((z) => <span>{z}</span>)}</p>
      </div>
    </section>

    <!-- 10 · ABSCHLUSS -->
    <section class="hs-abschnitt hs-abschluss" id="kontakt-start" aria-labelledby="hs-abschluss-h">
      <div class="wrap">
        <div class="hs-abschluss__innen reveal">
          <h2 id="hs-abschluss-h">{HS_ABSCHLUSS.titelVor}<span class="accent">{HS_ABSCHLUSS.titelAkzent}</span></h2>
          <p class="hs-zeilen">{HS_ABSCHLUSS.text.map((z) => <span>{z}</span>)}</p>
          <div class="hs-aktionen hs-aktionen--mitte">
            <a class="btn btn--primary btn--lg" href={href('/produkte/')}>{HS_ABSCHLUSS.ctaPrimaer} <Icon name="arrow" size={18} /></a>
            <a class="btn btn--ghost btn--lg" href={href('/kontakt/')}>{HS_ABSCHLUSS.ctaSekundaer}</a>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  import '../scripts/denkweise';
</script>
