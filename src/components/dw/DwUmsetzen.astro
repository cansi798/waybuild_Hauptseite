---
// Szene „Umsetzen“: Die Hauptlinie läuft weiter; aus ihr zweigt der Website Service ab, darunter dezent (gestrichelt)
// „Weitere Produkte folgen.“ (Talk 4024; vorher fünf Bereiche).
import Icon from '../Icon.astro';
import { DW_UMSETZEN as T } from '../../config/denkweise';
const W = 440, H = 320, X = 88, IX = 210;
const b = T.bereiche.map((x, k) => {
  const y = 96 + k * 130;
  return { ...x, k, y, d: `M ${X} ${y - 36} C ${X} ${y - 8}, ${X + 34} ${y}, ${X + 70} ${y} L ${IX - 22} ${y}` };
});
const pc = (a: number, c: number) => `${((a / c) * 100).toFixed(2)}%`;
---
<div class="dw-bild" data-szene style={`aspect-ratio: ${W} / ${H}`}>
  <svg viewBox={`0 0 ${W} ${H}`} aria-hidden="true" focusable="false">
    {b.map((x) => <path class={`dw-s dw-s--fein${x.hervor ? ' dw-s--akzent' : ''}${x.folgt ? ' dw-s--folgt' : ''}`} pathLength="1" d={x.d} data-an={`zeichnen:${(0.1 + x.k * 0.3).toFixed(2)}-${(0.26 + x.k * 0.3).toFixed(2)}`} />)}
  </svg>
  <span class="dw-anker" style={`left:${pc(X, W)};top:0%`} data-weg></span>
  <span class="dw-anker" style={`left:${pc(X, W)};top:100%`} data-weg></span>
  {b.map((x) => (
    <>
      <span class="dw-pos" style={`left:${pc(IX, W)};top:${pc(x.y, H)}`}>
        <span class:list={['dw-icon', { 'dw-icon--hervor': x.hervor, 'dw-icon--folgt': x.folgt }]} data-an={`erscheinen:${(0.22 + x.k * 0.3).toFixed(2)}-${(0.32 + x.k * 0.3).toFixed(2)}`}><Icon name={x.icon} size={20} /></span>
      </span>
      <span class="dw-pos dw-pos--rechts" style={`left:calc(${pc(IX, W)} + 30px);top:${pc(x.y, H)}`}>
        <span class:list={['dw-bereich', { 'dw-bereich--folgt': x.folgt }]} data-an={`auf:${(0.24 + x.k * 0.3).toFixed(2)}-${(0.36 + x.k * 0.3).toFixed(2)}`}>
          <span class="dw-bereich__name">{x.name}</span>
          {x.hinweis && <span class="dw-bereich__hinweis">{x.hinweis}</span>}
        </span>
      </span>
    </>
  ))}
</div>
