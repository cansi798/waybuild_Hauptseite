---
// Abschluss (Talk 4083): ohne Linie – ein ruhiger, fertiger Kreis „Fortschritt“ als Bild neben dem Kontakt-Text
// (vorher Endpunkt der Scroll-Linie mit Teilung). Statisch, kein Zeichnen.
import Icon from '../Icon.astro';
import { DW_ABSCHLUSS as T } from '../../config/denkweise';
---
<div class="dw-fortschritt" aria-hidden="true">
  <span class="dw-fortschritt__kreis">
    <Icon name="spark" size={26} />
    <span class="dw-fortschritt__wort">{T.kreis}</span>
  </span>
</div>
