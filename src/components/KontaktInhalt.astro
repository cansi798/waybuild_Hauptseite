---
// Kontaktseite (DE /kontakt/, EN /en/contact/) – Formular, Texte je Sprache (src/config/kontakt.ts, en.ts).
import PageHeader from './PageHeader.astro';
import { company, HOURS } from '../config/site';
import Icon from './Icon.astro';
import type { KontaktTexte } from '../config/kontakt';
import type { Lang } from '../i18n/lang';
import { HOURS_EN } from '../config/en';
interface Props { K: KontaktTexte; lang: Lang }
const { K, lang } = Astro.props;
const hours = lang === 'en' ? HOURS_EN : HOURS;
import Val from './Val.astro';
import Hint from './Hint.astro';
import { href } from '../lib/paths';
import { PRODUKTE, produktName } from '../config/hauptseite';

const interessen = PRODUKTE.filter((p) => p.aktiv).map((p) => ({ value: p.id === 'website' ? 'website service' : p.id, label: produktName(p) }))
  // 01.11.2026: wie auf /produkte/ – Individuelle Software (auf Anfrage) und Partner-Anfragen (/partner/) vorwählbar über ?leistung=…
  .concat([{ value: 'individuelle-software', label: 'Individuelle Software' }, { value: 'partnerschaft', label: 'Partnerschaft' }]);
const websiteSlugs: string[] = [];

// Versand über Web3Forms (kostenlos, ohne eigenen Server). Der Access-Key ist laut Anbieter öffentlich nutzbar.
// Ohne Key öffnet sich als Rückfall das E-Mail-Programm. Key setzen: GitHub → Settings → Variables → WEB3FORMS_KEY
const formKey = import.meta.env.PUBLIC_WEB3FORMS_KEY ?? '';
const endpoint = formKey ? 'https://api.web3forms.com/submit' : '';
---

  <PageHeader eyebrow={K.eyebrow} title={K.titel} accent={K.akzent} lead={K.lead} />

  <section class="section section--sand etappe">
    <div class="wrap contact">
      <form class="form card" id="contact-form" data-endpoint={endpoint} data-key={formKey} data-mailto={company.email} data-thanks={href('/danke/')} data-texte={JSON.stringify(K.js)} data-website-slugs={websiteSlugs.join(',')} novalidate>
        <label>{K.worum}
          <select name="interesse">
            <option value="">{K.allgemein}</option>
            {interessen.map((i) => <option value={i.value}>{K.interessen[i.value] ?? i.label}</option>)}
          </select>
        </label>
        <div class="row">
          <label>{K.name}<input name="name" autocomplete="name" required /></label>
          <label>{K.email}<input name="email" type="email" inputmode="email" autocomplete="email" required /></label>
        </div>
        <div class="row">
          <label><span>{K.telefon} <small>{K.telefonKlein}</small></span><input name="telefon" type="tel" inputmode="tel" autocomplete="tel" /></label>
          <label>{K.firma}<input name="firma" autocomplete="organization" /></label>
        </div>
        <label><span>{K.nachricht} <small>{K.optional}</small></span><textarea name="nachricht" rows="4" placeholder={K.platzhalter}></textarea></label>
        <input type="hidden" name="branche" value="" />
        <input type="hidden" name="paket" value="" />
        <input type="text" name="website" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <label class="check">
          <input type="checkbox" name="datenschutz" required />
          <span>{K.einwilligungVor}<a href={href('/datenschutz/')}>{K.einwilligungLink}</a>{K.einwilligungNach}</span>
        </label>
        <button class="btn btn--primary" type="submit">{K.senden}</button>
        <ol class="after" aria-label={K.danachAria}>
          {K.danach.map(([a, b]) => <li><strong>{a}</strong> {b}</li>)}
        </ol>
        {!endpoint && (
          <Hint label="Formular-Versand (Web3Forms-Key)" where="GitHub → Settings → Secrets and variables → Actions → Variables → WEB3FORMS_KEY">
            {' '}Aktuell öffnet sich nur das E-Mail-Programm.
          </Hint>
        )}
        <p class="form__status" role="status" aria-live="polite"></p>
      </form>

      <div class="side">
        <div class="card side__card">
          <h2>{K.direkt}</h2>
          <p><a href={`mailto:${company.email}`}>{company.email}</a></p>
          <p class="muted">{K.zeiten}: {hours}</p>
          <p class="muted">{company.legalName}<br /><Val value={company.street} label="Straße" where="src/config/site.ts → company.street" /><br /><Val value={company.zip} label="PLZ" where="src/config/site.ts → company.zip" /> <Val value={company.city} label="Ort" where="src/config/site.ts → company.city" /></p>
        </div>
        <p class="dach"><Icon name="globe" size={18} /> {K.dach}</p>
        <ul class="promise">
          {K.versprechen.map(([a, b]) => <li><strong>{a}</strong>{b}</li>)}
        </ul>
      </div>
    </div>
  </section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  if (form) {
    // Früher verlinkte Tarif-Parameter (?tarif=…) gelten als Website-Anfrage
    const tarif = new URLSearchParams(location.search).get('tarif');
    // Branche von der Branchen-Landingpage mitnehmen
    const branche = new URLSearchParams(location.search).get('branche');
    if (branche) (form.elements.namedItem('branche') as HTMLInputElement).value = branche.slice(0, 40);
    // Interesse aus ?leistung=… (Detailseiten) vorbelegen, Paket aus ?paket=… mitnehmen
    const params = new URLSearchParams(location.search);
    const interesse = form.elements.namedItem('interesse') as HTMLSelectElement;
    const websiteSlugs = (form.dataset.websiteSlugs ?? '').split(',').filter(Boolean); // leere Einträge ignorieren (sonst leere Auswahl)
    const leistung = params.get('leistung') ?? '';
    if ((leistung && websiteSlugs.includes(leistung)) || tarif || params.get('paket')) interesse.value = 'website service';
    else if ([...interesse.options].some((o) => o.value === leistung)) interesse.value = leistung;
    const paket = params.get('paket');
    if (paket) (form.elements.namedItem('paket') as HTMLInputElement).value = paket.slice(0, 60);

    const T = JSON.parse(form.dataset.texte || '{}');
    const interessText = (d: Record<string, string>) => interesse.querySelector<HTMLOptionElement>(`option[value="${CSS.escape(d.interesse ?? '')}"]`)?.textContent ?? T.beratung;
    const status = form.querySelector<HTMLElement>('.form__status')!;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!form.reportValidity()) return;
      const data = Object.fromEntries(new FormData(form)) as Record<string, string>;
      if (data.website) return; // Honeypot: Bots füllen das versteckte Feld aus
      delete data.website;

      const endpoint = form.dataset.endpoint;
      if (!endpoint) {
        const L = T.felder;
        const body = `${L.name}: ${data.name}\n${L.firma}: ${data.firma}\n${L.email}: ${data.email}\n${L.telefon}: ${data.telefon}\n${L.interesse}: ${interessText(data)}${data.paket ? `\n${L.paket}: ${data.paket}` : ''}${data.branche ? `\n${L.branche}: ${data.branche}` : ''}\n\n${data.nachricht}`;
        location.href = `mailto:${form.dataset.mailto}?subject=${encodeURIComponent(`${T.betreff}: ${interessText(data)}`)}&body=${encodeURIComponent(body)}`;
        status.textContent = T.mailOffen;
        return;
      }
      status.textContent = T.sendet;
      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
      button.disabled = true;
      try {
        const res = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({
            ...data,
            access_key: form.dataset.key,
            subject: `${T.betreff}: ${interessText(data)}${data.paket ? ` – ${data.paket}` : ''}${data.branche ? ` (${data.branche})` : ''}`,
            from_name: 'Waybuild Website',
            replyto: data.email,
          }),
        });
        const json = await res.json().catch(() => ({}));
        if (!res.ok || json.success === false) throw new Error(String(res.status));
        // Abschluss der Journey: Danke-Seite mit nächsten Schritten
        location.href = `${form.dataset.thanks}?name=${encodeURIComponent(data.name.split(' ')[0])}`;
      } catch {
        button.disabled = false;
        status.textContent = `${T.fehler} ${form.dataset.mailto}.`;
      }
    });
  }
</script>

<style>
  .contact { display: grid; gap: 32px; }
  @media (min-width: 960px) { .contact { grid-template-columns: 1.5fr 1fr; gap: 48px; align-items: start; } }
  .form { display: grid; gap: 18px; }
  .row { display: grid; gap: 18px; }
  @media (min-width: 640px) { .row { grid-template-columns: 1fr 1fr; } }
  label { display: grid; gap: 6px; font-weight: 600; font-size: 0.95rem; }
  legend small { font-weight: 400; color: var(--ink-soft); }
  input, select, textarea {
    font: inherit; font-weight: 400; color: var(--ink); width: 100%;
    padding: 12px 14px; min-height: 48px; border: 1.5px solid var(--line); border-radius: 10px; background: var(--paper);
  }
  input:focus, select:focus, textarea:focus { outline: none; border-color: var(--accent-ink); background: var(--white); box-shadow: 0 0 0 3px rgb(0 166 161 / 30%); }
  .check { display: flex; gap: 12px; align-items: flex-start; font-weight: 400; font-size: 0.9rem; color: var(--ink-soft); }
  .check input { width: 20px; min-height: 20px; height: 20px; margin-top: 2px; flex: none; accent-color: var(--accent); }
  .hp { position: absolute; left: -9999px; }
  .form .btn { justify-self: stretch; }
  @media (min-width: 640px) { .form .btn { justify-self: start; } }
  label small { font-weight: 400; color: var(--ink-soft); }
  .after { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; font-size: 0.82rem; color: var(--ink-soft); }
  .after li { border-top: 2px solid var(--line); padding-top: 8px; }
  .after li:first-child { border-color: var(--accent); }
  .after strong { display: block; color: var(--ink); font-size: 0.9rem; }
  .form__status { margin: 0; font-weight: 600; }
  .side { display: grid; gap: 20px; }
  .side__card h2 { font-size: 1.3rem; }
  .side__card a { font-weight: 650; }
  .direct { display: flex; flex-wrap: wrap; gap: 8px; margin: 4px 0 12px; }
  .direct .btn { border-color: var(--line); }
  .muted { color: var(--ink-soft); font-size: 0.95rem; margin: 0; }
  .dach { display: flex; gap: 10px; align-items: flex-start; margin: 0; padding: 14px 16px; border-radius: 14px; background: rgb(0 166 161 / 8%); line-height: 1.55; }
  .dach :global(.icon) { flex: none; margin-top: 3px; color: var(--accent-mid); }
  .promise { list-style: none; padding: 0; margin: 0; display: grid; gap: 14px; }
  .promise li { padding-left: 18px; border-left: 3px solid var(--accent); line-height: 1.5; }
  .promise strong { display: block; }
  @media (max-width: 599px) { .promise { display: none; } }
</style>
