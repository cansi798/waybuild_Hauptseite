---
// Szene „Hinterfragen“ (die wichtigste Animation): Aus „Neue Website“ entstehen am Entscheidungspunkt fünf mögliche
// Wege. Kurz sind alle gleichwertig sichtbar, dann verblassen zwei, drei verbinden sich wieder: eine Richtung.
// Desktop breit (880 × 520), Handy schmaler (440 × 600) mit Begriffen in zwei Reihen.
import Icon from '../Icon.astro';
import { DW_HINTERFRAGEN as T } from '../../config/denkweise';

type Variante = { W: number; H: number; sx: number; sy: number; dy: number; xs: number[]; ly: number[]; ey: number; jy: number; v: 'd' | 'm' };
const VARIANTEN: Variante[] = [
  { v: 'd', W: 880, H: 520, sx: 440, sy: 46, dy: 120, xs: [120, 280, 440, 600, 760], ly: [250, 250, 250, 250, 250], ey: 340, jy: 440 },
  { v: 'm', W: 440, H: 600, sx: 220, sy: 36, dy: 96, xs: [62, 140, 220, 300, 372], ly: [212, 286, 212, 286, 212], ey: 360, jy: 462 },
];
const AUF = '0.1-0.34', WAHL = '0.5-0.66', ZUSAMMEN = (k: number) => `${(0.62 + k * 0.03).toFixed(2)}-${(0.8 + k * 0.03).toFixed(2)}`;
const bau = (v: Variante) => {
  const bleiben = T.wege.map((w, i) => (w.bleibt ? i : -1)).filter((i) => i >= 0);
  return {
    ...v,
    wege: T.wege.map((w, i) => {
      const x = v.xs[i];
      const d = x === v.sx ? `M ${v.sx} ${v.dy} L ${x} ${v.ey}` : `M ${v.sx} ${v.dy} C ${v.sx} ${v.dy + (v.ly[i] - v.dy) * 0.5}, ${x} ${v.dy + (v.ly[i] - v.dy) * 0.35}, ${x} ${v.ly[i] - 30} L ${x} ${v.ey}`;
      return { ...w, i, x, d };
    }),
    zusammen: bleiben.map((i, k) => ({ k, d: `M ${v.xs[i]} ${v.ey} C ${v.xs[i]} ${v.ey + (v.jy - v.ey) * 0.6}, ${v.sx} ${v.jy - (v.jy - v.ey) * 0.5}, ${v.sx} ${v.jy}` })),
  };
};
const varianten = VARIANTEN.map(bau);
const pc = (a: number, b: number) => `${((a / b) * 100).toFixed(2)}%`;
---
{varianten.map((v) => (
  <div class={`dw-bild dw-bild--breit dw-nur-${v.v}`} data-szene style={`aspect-ratio: ${v.W} / ${v.H}`}>
    <svg viewBox={`0 0 ${v.W} ${v.H}`} aria-hidden="true" focusable="false">
      <path class="dw-s" pathLength="1" d={`M ${v.sx} ${v.sy} L ${v.sx} ${v.dy}`} data-an="zeichnen:0.04-0.12" />
      {v.wege.map((w) => <path class="dw-s" pathLength="1" d={w.d} data-an={`zeichnen:${AUF}${w.bleibt ? '' : ` aus:${WAHL}:0.1`}`} />)}
      {v.zusammen.map((z) => <path class="dw-s" pathLength="1" d={z.d} data-an={`zeichnen:${ZUSAMMEN(z.k)}`} />)}
      <path class="dw-s dw-s--stark" pathLength="1" d={`M ${v.sx} ${v.jy} L ${v.sx} ${v.H}`} data-an="zeichnen:0.84-0.97" />
      <circle class="dw-knoten" cx={v.sx} cy={v.dy} r="6" data-an="erscheinen:0.08-0.14" />
      <circle class="dw-knoten dw-knoten--akzent" cx={v.sx} cy={v.jy} r="7" data-an="erscheinen:0.8-0.88" />
    </svg>
    <span class="dw-anker" style={`left:50%;top:${pc(v.sy, v.H)}`} data-weg="ein" data-weg-nur={v.v}></span>
    <span class="dw-anker" style="left:50%;top:100%" data-weg="aus" data-weg-nur={v.v}></span>
    <span class="dw-pos" style={`left:50%;top:${pc(v.sy, v.H)}`}>
      <span class="dw-chip dw-chip--start" data-an="auf:0-0.08"><Icon name="idee" size={16} /> {T.start}</span>
    </span>
    {v.wege.map((w) => (
      <span class="dw-pos" style={`left:${pc(w.x, v.W)};top:${pc(v.ly[w.i], v.H)}`}>
        <span class="dw-chip" data-an={`auf:${(0.2 + w.i * 0.03).toFixed(2)}-${(0.34 + w.i * 0.03).toFixed(2)}${w.bleibt ? '' : ` aus:${WAHL}:0.15`}`}>{w.text}</span>
      </span>
    ))}
    <span class="dw-pos dw-pos--rechts" style={`left:calc(${pc(v.sx, v.W)} + 18px);top:${pc(v.jy, v.H)}`}>
      <span class="dw-wort dw-wort--akzent" data-an="auf:0.86-0.96">{T.richtung}</span>
    </span>
  </div>
))}
