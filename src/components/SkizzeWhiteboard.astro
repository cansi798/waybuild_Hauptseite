---
// Skizzen-Illustration statt Stockfoto (Design-System Jamil, Talk 3622: „Zusammenarbeit, Gespräche, Whiteboards, Skizzen“).
// Zwei Menschen am Whiteboard – darauf die Waybuild-Linie: aus dem Kringel wird ein gerader Weg zum Ziel.
// Linienstil wie die Symbole. Die Linie auf dem Whiteboard zeichnet sich einmal, wenn die Skizze sichtbar wird.
---

<figure class="skizze reveal" aria-label="Skizze: Zwei Menschen stehen an einem Whiteboard. Darauf wird aus einer verknoteten Linie ein gerader Weg zum Ziel.">
  <svg viewBox="0 0 400 300" role="img" aria-hidden="true" focusable="false">
    <!-- Whiteboard -->
    <rect class="sk-ink" x="40" y="18" width="320" height="170" rx="10" />
    <path class="sk-ink" d="M120 188 L104 232 M280 188 L296 232" />
    <!-- Linie auf dem Board -->
    <path class="sk-grau sk-zeichnen" pathLength="1" d="M66 112 C 82 112, 88 78, 106 82 C 128 87, 120 136, 102 132 C 84 128, 98 70, 132 74 C 166 78, 152 132, 136 128 C 124 125, 146 104, 178 104" />
    <path class="sk-tuerkis sk-zeichnen sk-zeichnen--2" pathLength="1" d="M178 104 L 318 104" />
    <circle class="sk-punkt" cx="226" cy="104" r="5" />
    <circle class="sk-punkt" cx="272" cy="104" r="5" />
    <circle class="sk-ziel" cx="326" cy="104" r="11" />
    <circle class="sk-ziel" cx="326" cy="104" r="5" />
    <!-- Notizzettel -->
    <path class="sk-ink sk-duenn" d="M70 140 h40 v28 h-40z M76 150 h26 M76 158 h18" />
    <!-- Person links -->
    <circle class="sk-ink" cx="150" cy="226" r="17" />
    <path class="sk-ink" d="M116 300 C 116 268, 130 252, 150 252 C 170 252, 184 268, 184 300" />
    <!-- Person rechts, zeigt auf das Board -->
    <circle class="sk-ink" cx="250" cy="220" r="17" />
    <path class="sk-ink" d="M216 300 C 216 264, 230 246, 250 246 C 270 246, 284 264, 284 300" />
    <path class="sk-ink" d="M274 258 C 290 240, 300 214, 304 168" />
  </svg>
</figure>

<style>
  .skizze { margin: 0; max-width: 460px; width: 100%; }
  .skizze svg { display: block; width: 100%; height: auto; overflow: visible; }
  .sk-ink, .sk-grau, .sk-tuerkis { fill: none; stroke-linecap: round; stroke-linejoin: round; }
  .sk-ink { stroke: #6f6a60; stroke-width: 2.6; }
  .sk-duenn { stroke-width: 2; }
  .sk-grau { stroke: #a8a191; stroke-width: 4; }
  .sk-tuerkis { stroke: var(--accent); stroke-width: 4.5; }
  .sk-punkt { fill: var(--paper); stroke: var(--accent); stroke-width: 3; }
  .sk-ziel { fill: none; stroke: var(--accent-ink); stroke-width: 3; }
  .sk-zeichnen { stroke-dasharray: 1; }
  :global(html.js) .skizze:not(.is-visible) .sk-zeichnen { stroke-dashoffset: 1; }
  :global(html.js) .skizze:not(.is-visible) .sk-punkt, :global(html.js) .skizze:not(.is-visible) .sk-ziel { opacity: 0; }
  .skizze.is-visible .sk-zeichnen { animation: sk-zeichnen 1.1s linear both 0.3s; }
  .skizze.is-visible .sk-zeichnen--2 { animation-duration: 0.8s; animation-delay: 1.4s; }
  .skizze.is-visible .sk-punkt, .skizze.is-visible .sk-ziel { animation: sk-auf 0.25s ease-out both; }
  .skizze.is-visible .sk-punkt:nth-of-type(1) { animation-delay: 1.66s; }
  .skizze.is-visible .sk-punkt:nth-of-type(2) { animation-delay: 1.92s; }
  .skizze.is-visible .sk-ziel { animation-delay: 2.2s; }
  @keyframes sk-zeichnen { from { stroke-dashoffset: 1; } to { stroke-dashoffset: 0; } }
  @keyframes sk-auf { from { opacity: 0; } to { opacity: 1; } }
  :global(html.js) .skizze.reveal { transform: none; }
  @media (prefers-reduced-motion: reduce) {
    .sk-zeichnen, .sk-punkt, .sk-ziel { animation: none !important; stroke-dashoffset: 0 !important; opacity: 1 !important; }
  }
</style>
