---
// Wegstück zwischen zwei Abschnitten der Unterseiten (Neuaufbau Storytelling, Jamil Talk 3632):
// Auf den Unterseiten ist der Weg schon geordnet – deshalb eine gerade, ruhige Linie von Station zu Station,
// die sich beim Scrollen einmal zieht (ohne Unterstützung/bei reduzierter Bewegung: steht fertig da).
// `variante` bleibt aus Kompatibilität erhalten.
interface Props { variante?: 1 | 2 }
---

<div class="trenner" aria-hidden="true">
  <span class="trenner__linie"></span>
  <span class="trenner__punkt trenner__punkt--a"></span>
  <span class="trenner__punkt trenner__punkt--b"></span>
</div>
