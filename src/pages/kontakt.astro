---
// Aufbau seit 04.11.2026 in src/components/KontaktInhalt.astro (gemeinsam mit /en/contact/).
import BaseLayout from '../layouts/BaseLayout.astro';
import KontaktInhalt from '../components/KontaktInhalt.astro';
import { KONTAKT_DE as K } from '../config/kontakt';
---

<BaseLayout title={K.meta.title} description={K.meta.description} breadcrumb={[{ name: K.meta.crumb, path: '/kontakt/' }]} hideMobileCta hideFooterKontakt>
  <KontaktInhalt K={K} lang="de" />
</BaseLayout>
