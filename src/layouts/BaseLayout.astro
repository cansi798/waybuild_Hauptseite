---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import StickyBar from '../components/StickyBar.astro';
import { company, isMissing } from '../config/site';
import { PRODUKTE, produktName, BESCHREIBUNG } from '../config/hauptseite';
import { href, absolute } from '../lib/paths';
import { IS_PREVIEW } from '../lib/env';
import { langVon, fassungen } from '../i18n/lang';
import { UI } from '../i18n/ui';
import { BESCHREIBUNG_EN } from '../config/en';
// Schriften für den ersten Bildschirm früh laden (Überschrift = größtes Element, wichtig für LCP)
import schriftKopf from '@fontsource-variable/montserrat/files/montserrat-latin-wght-normal.woff2?url';
import schriftText from '@fontsource-variable/jost/files/jost-latin-wght-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  /** Zusätzliche JSON-LD-Objekte für diese Seite */
  schema?: Record<string, unknown>[];
  noindex?: boolean;
  breadcrumb?: { name: string; path: string }[];
  /** Mobile Sticky-CTA ausblenden (z. B. auf der Kontaktseite selbst) */
  hideMobileCta?: boolean;
  /** Dunklen Kontaktblock im Footer weglassen (Startseite hat den Abschluss selbst) */
  hideFooterKontakt?: boolean;
  /** Startseite: die Linie läuft als Rückgrat bis in den Zielpunkt des Abschlusses */
  rueckgrat?: boolean;
}

const { title, description, schema = [], noindex = false, breadcrumb, hideMobileCta = false, hideFooterKontakt = false, rueckgrat = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const lang = langVon(Astro.url.pathname);
const t = UI[lang];
// hreflang: nur Seiten, die es in beiden Sprachen gibt (src/i18n/routes.mjs); x-default = Deutsch
const fass = fassungen(Astro.url.pathname);
const alternates = fass.de && fass.en ? [
  { hreflang: 'de', href: absolute(fass.de, Astro.site) },
  { hreflang: 'en', href: absolute(fass.en, Astro.site) },
  { hreflang: 'x-default', href: absolute(fass.de, Astro.site) },
] : [];
const istDeStart = lang === 'de' && fass.de === '/';
const siteRoot = absolute('/', Astro.site);
const ogImage = absolute('/og-image.png', Astro.site);
const fullTitle = title.includes(company.name) ? title : `${title} | ${company.name}`;

const hasAddress = ![company.street, company.zip, company.city].some(isMissing);

const organization = {
  '@context': 'https://schema.org',
  // Mit vollständiger Adresse zusätzlich lokales Unternehmen → Chance auf lokale Suchergebnisse
  '@type': hasAddress ? ['Organization', 'ProfessionalService'] : 'Organization',
  '@id': `${siteRoot}#organization`,
  name: company.legalName,
  alternateName: company.name,
  description: lang === 'en' ? BESCHREIBUNG_EN : BESCHREIBUNG,
  url: siteRoot,
  logo: absolute('/icon-512.png', Astro.site),
  image: ogImage,
  slogan: company.slogan,
  ...(company.sameAs.length ? { sameAs: company.sameAs } : {}),
  // DACH (Can, Talk 4551): Deutschland, Österreich, Schweiz
  areaServed: [
    { '@type': 'Country', name: 'Deutschland', identifier: 'DE' },
    { '@type': 'Country', name: 'Österreich', identifier: 'AT' },
    { '@type': 'Country', name: 'Schweiz', identifier: 'CH' },
  ],
  ...(hasAddress ? { priceRange: '€€' } : {}),
  email: company.email,
  // Servicezeiten wie auf der Seite (HOURS / SLA_HINWEIS): Montag bis Freitag, 9 bis 18 Uhr
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'customer service',
    email: company.email,
    availableLanguage: ['de', 'en'],
    hoursAvailable: { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'], opens: '09:00', closes: '18:00' },
  },
  // Dachmarke: nur verfügbare Produkte als Angebot melden (Name = Arbeitsname aus der Config, keine Preise hier)
  makesOffer: PRODUKTE.filter((p) => p.aktiv).map((p) => ({
    '@type': 'Offer',
    itemOffered: { '@type': 'Service', name: produktName(p), serviceType: p.kategorie, url: p.url || absolute(p.pfad ?? '/', Astro.site), ...(p.zweck ? { description: p.zweck } : {}) },
  })),
  // Platzhalter-Nummer nie an Google melden
  // Adresse erst ausgeben, wenn sie vollständig ist – nie Platzhalter an Google melden
  ...(!hasAddress
    ? {}
    : {
        address: {
          '@type': 'PostalAddress',
          streetAddress: company.street,
          postalCode: company.zip,
          addressLocality: company.city,
          addressCountry: company.country,
        },
      }),
};

const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${siteRoot}#website`,
  url: siteRoot,
  name: company.name,
  inLanguage: ['de-DE', 'en'],
  publisher: { '@id': `${siteRoot}#organization` },
};

const breadcrumbSchema = breadcrumb && {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [{ name: t.start, path: t.home }, ...breadcrumb].map((b, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: b.name,
    item: absolute(b.path, Astro.site),
  })),
};


const jsonLd = [organization, website, ...(breadcrumbSchema ? [breadcrumbSchema] : []), ...schema];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <link rel="preload" href={schriftKopf} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={schriftText} as="font" type="font/woff2" crossorigin />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    {istDeStart && (
      /* Gemerkte Sprachwahl (nur nach Klick auf „EN“, nie nach Browsersprache): Startseite öffnet dann die englische Fassung */
      <script is:inline define:vars={{ ziel: href('/en/') }}>try { if (localStorage.getItem('wb-lang') === 'en' && !/[?&]lang=de/.test(location.search)) location.replace(ziel); } catch (e) {}</script>
    )}
    <meta name="robots" content={IS_PREVIEW ? 'noindex, nofollow' : noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1'} />
    <meta name="theme-color" content="#004f4c" />
    <link rel="icon" href={href('/favicon.ico')} sizes="any" />
    <link rel="icon" href={href('/icon-192.png')} type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href={href('/apple-touch-icon.png')} />
    <link rel="manifest" href={href('/site.webmanifest')} />
    <link rel="sitemap" href={href('/sitemap-index.xml')} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'de_DE'} />
    {alternates.length > 0 && <meta property="og:locale:alternate" content={lang === 'en' ? 'de_DE' : 'en_US'} />}
    <meta property="og:site_name" content={company.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={lang === 'en' ? 'Waybuild: We take responsibility. You stay focused.' : 'Waybuild: Wir übernehmen Verantwortung. Sie behalten den Fokus.'} />
    <meta name="twitter:card" content="summary_large_image" />

    {jsonLd.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">{t.skip}</a>
    {IS_PREVIEW && <div class="preview-bar" role="region" aria-label={t.hinweis}>{t.vorschau}</div>}
    <Header />
    <main id="main">
      {breadcrumb && <Breadcrumbs items={breadcrumb} />}
      <slot />
    </main>
    <Footer kontakt={!hideFooterKontakt} rueckgrat={rueckgrat} />
    {!hideMobileCta && <StickyBar />}
    {/* Schwebendes „offene Punkte“-Badge entfernt (Jamil, Talk 3636: „unklare schwebende 16-Markierung“). Die Launch-Checkliste bleibt unter /checkliste/ (Vorschau). */}
    <script data-reveal-script>
      // Reveal beim Scrollen (nur mit JS; ohne JS ist alles sichtbar)
      const reveals = document.querySelectorAll('.reveal');
      if (reveals.length && 'IntersectionObserver' in window) {
        const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-visible'); io.unobserve(e.target); } }), { threshold: 0.15 });
        reveals.forEach((r) => io.observe(r));
      } else reveals.forEach((r) => r.classList.add('is-visible'));
    </script>
  </body>
</html>

<style>
  .preview-bar { background: var(--dark); color: var(--dark-soft); text-align: center; font-size: 0.75rem; letter-spacing: 0.08em; text-transform: uppercase; padding: 4px 16px; }
</style>
