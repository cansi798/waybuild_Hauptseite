---
// /karriere/ – Daueranzeigen, WAYBUILD-Benefits, Bewerbung per E-Mail (Can, Talk k8oxzjva, 04.11.2026).
// Inhalt: src/config/unterseiten.ts → KARRIERESEITE, Aufbau: src/components/us/KarriereInhalt.astro.
// Kein JobPosting-JSON-LD: die Seite listet mehrere Dauer- bzw. Initiativ-Anzeigen auf einer Übersicht; Google
// verlangt eine konkrete, offene Stelle je Detailseite.
import BaseLayout from '../layouts/BaseLayout.astro';
import KarriereInhalt from '../components/us/KarriereInhalt.astro';
import { KARRIERESEITE as K } from '../config/unterseiten';
import '../styles/denkweise.css';
import '../styles/unterseiten.css';
---

<BaseLayout title={K.meta.title} description={K.meta.description} breadcrumb={[{ name: K.meta.crumb, path: '/karriere/' }]}>
  <KarriereInhalt K={K} />
</BaseLayout>
