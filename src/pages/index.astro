---
// Startseite waybuild IT – Neufassung 27.10.2026 (Jamil, Talk 3467), basierend auf den Texten 3373, 3378, 3395, 3401.
// Zwei Fragen müssen in 10/30/60 Sekunden beantwortet sein: WAS macht Waybuild (Website Service, Nutzen, Preise)
// und WARUM Waybuild (Haltung „Veränderungen einfach“, Leichtigkeit im Prozess, feste Zusagen, klare Bedingungen).
// Aufbau: Hero → Haltung → Angebot → Warum → So läuft es → Roadmap → Vertrauen/FAQ → Abschluss.
// Bewegung nur dreimal und erklärend: Status-Linie im Hero-Beispiel, Prozess-Linie in „So läuft es“, sanftes Einblenden.
// Alles HTML/CSS/Inline-SVG, ohne JS sichtbar, bei prefers-reduced-motion sofort Endzustand.
// Zahlen/Zusagen NUR aus src/config (site.ts, hauptseite.ts). Vorherige Fassung: Tag startseite-v2-2026-10-27.
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { href } from '../lib/paths';
import { company, HOURS, PAKETE, MODELL, faqs, formatEuro, type IconName } from '../config/site';
import { SLA_KERN, ZUSAGEN } from '../config/hauptseite';

const FRUST = ['E-Mails', 'Screenshots', 'WhatsApp-Nachrichten', 'Abstimmungsschleifen', 'Wartezeiten'];

const FRAGEN = [
  'Wie einfach lassen sich Änderungen bei Ihnen heute umsetzen?',
  'Wie schnell kommen Ideen tatsächlich in die Umsetzung?',
  'Wie abhängig ist Ihr Unternehmen von einzelnen Personen?',
  'Wie transparent sind Ihre Dienstleister?',
  'Wie viel Aufwand entsteht bei kleinen Veränderungen?',
];

const NUTZEN: { icon: IconName; title: string; text: string }[] = [
  { icon: 'layout', title: 'Eine professionelle Website', text: 'Nach persönlicher Beratung – passend zu Ihrem Unternehmen.' },
  { icon: 'server', title: 'Alles Technische inklusive', text: 'Hosting, Domain, SSL, Wartung, Updates und Backups.' },
  { icon: 'mic', title: 'Änderungen per Sprache oder Text', text: 'Eine Nachricht genügt. Kein Formular, keine Screenshots.' },
  { icon: 'user', title: 'Ein fester Ansprechpartner', text: 'Eine Person, die Ihr Unternehmen kennt.' },
];

const GRUENDE: { icon: IconName; title: string; text: string }[] = [
  { icon: 'mic', title: 'Eine Nachricht genügt', text: 'Sie sagen, was sich ändern soll. Wir kümmern uns darum – ohne Schleifen.' },
  { icon: 'clock', title: 'Feste Zusagen, schriftlich', text: `${SLA_KERN[0].wert} eine persönliche Antwort. Servicezeiten: ${HOURS}.` },
  { icon: 'user', title: 'Menschlich beraten, schnell umgesetzt', text: 'Wir hören zu und erklären ohne Fachchinesisch. KI beschleunigt die Umsetzung – sie ersetzt keine guten Ideen.' },
  { icon: 'eye', title: 'Klare Bedingungen', text: 'Fester Monatspreis, keine versteckten Kosten. Website, Code und Domain gehören Ihnen.' },
];

const ABLAUF: { icon: IconName; title: string; text: string }[] = [
  { icon: 'chat', title: 'Erstgespräch', text: 'Kostenlos und unverbindlich. Wir lernen Ihr Unternehmen kennen.' },
  { icon: 'compass', title: 'Verstehen & Planen', text: 'Wir klären gemeinsam, was Sie erreichen möchten.' },
  { icon: 'zap', title: 'Umsetzen', text: 'Wir setzen um. Sie prüfen und geben frei.' },
  { icon: 'refresh', title: 'Laufend betreut', text: 'Änderungen per Sprache oder Text. Wartung und Updates laufen im Hintergrund.' },
];

const ROADMAP: { name: string; icon: IconName; aktiv?: boolean }[] = [
  { name: 'Website Service', icon: 'layout', aktiv: true },
  { name: 'Software Service', icon: 'code' },
  { name: 'Cloud Service', icon: 'cloud' },
  { name: 'Workplace Service', icon: 'users' },
  { name: 'Process Service', icon: 'layers' },
];

const faqAuszug = faqs.filter((f) => /Was kostet|Vertrag|gehören/.test(f.q));
const ersteSicht = PAKETE.map((p) => ({ name: p.name, kurz: p.kurz, preis: formatEuro(p.preis), top: p.empfohlen }));
---

<BaseLayout
  title="Wir machen Veränderungen einfach"
  description="waybuild IT betreut Ihre Website und setzt Änderungen per Sprache oder Text um – mit festen Zusagen und festem Monatspreis."
  hideFooterKontakt
>
  <!-- 1 HERO: klare Aussage + was wir tun + Beispiel -->
  <section class="hero" aria-labelledby="hero-h">
    <div class="hero__bg" aria-hidden="true"></div>
    <div class="wrap hero__grid">
      <div class="hero__text">
        <span class="eyebrow">waybuild IT</span>
        <h1 id="hero-h">Wir machen Veränderungen <span class="accent">einfach.</span></h1>
        <p class="hero__was">Wir betreuen Ihre Website und setzen Änderungen für Sie um – per Sprachnachricht oder Text, zu einem festen Monatspreis.</p>
        <div class="hero__cta">
          <a class="btn btn--primary btn--lg" href={href('/kontakt/')}>Erstgespräch anfragen <Icon name="arrow" size={18} /></a>
          <a class="btn btn--ghost btn--lg" href={href('/#angebot')}>Was wir anbieten</a>
        </div>
      </div>
      <figure class="demo" aria-label="Beispiel: So läuft eine Änderung bei waybuild">
        <figcaption>Beispiel: eine Änderung</figcaption>
        <div class="demo__msg">
          <span class="demo__mic" aria-hidden="true"><Icon name="mic" size={20} /></span>
          <div>
            <strong>Sprachnachricht · 0:08</strong>
            <span>„Bitte das neue Teamfoto auf die Startseite.“</span>
          </div>
        </div>
        <ol class="demo__status">
          <li style="--i:0"><span class="dot"></span>Nachricht erhalten</li>
          <li style="--i:1"><span class="dot"></span>Ticket angelegt</li>
          <li style="--i:2"><span class="dot"></span>Online</li>
        </ol>
        <p class="demo__note">Keine E-Mail-Kette. Keine Screenshots.</p>
      </figure>
    </div>
    <div class="wrap hero__fakten" aria-label="Zur Firma">
      <span><Icon name="shield" size={16} /> {company.legalName}, Norderstedt</span>
      <span><Icon name="doc" size={16} /> {company.registerCourt}, {company.registerNumber}</span>
      <span><Icon name="server" size={16} /> Server in Deutschland</span>
    </div>
  </section>

  <!-- 2 HALTUNG: warum es uns gibt + Nachdenk-Fragen -->
  <section class="section haltung" id="haltung" aria-labelledby="haltung-h">
    <div class="wrap haltung__grid">
      <div class="head">
        <span class="eyebrow">Warum es uns gibt</span>
        <h2 id="haltung-h">Nicht die Technik ist das Problem. <span class="muted">Der Weg zur Umsetzung ist es.</span></h2>
        <p class="lead">Waybuild ist aus Frust entstanden. Eine einfache Änderung bedeutete:</p>
        <ul class="frust" aria-label="Was früher passierte">
          {FRUST.map((f) => <li>{f}</li>)}
        </ul>
        <p class="haltung__satz">Wir fragen deshalb zuerst: <strong>Was möchten Sie erreichen?</strong> Nicht jede Veränderung braucht neue Software oder eine neue Website. Aber fast jede braucht Klarheit, Struktur und einen verlässlichen Partner.</p>
      </div>
      <div class="fragenbox reveal">
        <h3>Wie leicht ist Veränderung bei Ihnen heute?</h3>
        <ul>
          {FRAGEN.map((f) => <li>{f}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <!-- 3 ANGEBOT: Website Service konkret mit Preisen -->
  <section class="section angebot" id="angebot" aria-labelledby="angebot-h">
    <div class="wrap">
      <div class="head head--center">
        <span class="eyebrow">Was wir heute anbieten</span>
        <h2 id="angebot-h">Der Website Service: <span class="accent">alles aus einer Hand.</span></h2>
        <p class="lead">Wir beginnen mit Websites. Sie bekommen Ihre Website – und müssen sich um nichts kümmern.</p>
      </div>
      <div class="angebot__grid">
        <ul class="nutzen">
          {NUTZEN.map((n) => (
            <li class="reveal">
              <span class="nutzen__icon" aria-hidden="true"><Icon name={n.icon} size={24} /></span>
              <div><h3>{n.title}</h3><p>{n.text}</p></div>
            </li>
          ))}
        </ul>
        <div class="preise reveal">
          <h3>Ein fester Monatspreis</h3>
          <ul class="preise__liste">
            {ersteSicht.map((p) => (
              <li class:list={{ 'preise__top': p.top }}>
                <div>
                  <strong>{p.name}</strong>
                  <span>{p.kurz}</span>
                </div>
                <p><b>{p.preis}</b><small>pro Monat, netto</small></p>
              </li>
            ))}
          </ul>
          <ul class="preise__modell">
            {MODELL.filter((m) => !/Fester Monatspreis/.test(m)).map((m) => <li><Icon name="check" size={16} />{m}</li>)}
          </ul>
          <div class="preise__cta">
            <a class="btn btn--primary" href={href('/kontakt/')}>Erstgespräch anfragen</a>
            <a class="btn btn--ghost" href={href('/angebot/')}>Alle Details &amp; Preise</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 4 WARUM WAYBUILD: vier belegte Gründe -->
  <section class="section warum" id="warum" aria-labelledby="warum-h">
    <div class="wrap">
      <div class="head head--center">
        <span class="eyebrow">Warum waybuild</span>
        <h2 id="warum-h">Weil Zusammenarbeit <span class="accent">leicht sein darf.</span></h2>
      </div>
      <ul class="gruende">
        {GRUENDE.map((g, i) => (
          <li class="reveal" style={`--d:${i * 100}ms`}>
            <span class="gruende__icon" aria-hidden="true"><Icon name={g.icon} size={26} /></span>
            <h3>{g.title}</h3>
            <p>{g.text}</p>
          </li>
        ))}
      </ul>
      <p class="warum__mehr"><a href={href('/zusagen/')}>Alle Zusagen ansehen <Icon name="arrow" size={16} /></a></p>
    </div>
  </section>

  <!-- 5 SO LÄUFT ES: vier Schritte mit Prozess-Linie -->
  <section class="section ablauf" id="ablauf" aria-labelledby="ablauf-h">
    <div class="wrap">
      <div class="head head--center">
        <span class="eyebrow">So läuft es</span>
        <h2 id="ablauf-h">Vier Schritte. <span class="accent">Ohne Umwege.</span></h2>
      </div>
      <ol class="schritte reveal">
        {ABLAUF.map((a, i) => (
          <li style={`--i:${i}`}>
            <span class="schritte__kreis"><Icon name={a.icon} size={28} /><b>{i + 1}</b></span>
            <h3>{a.title}</h3>
            <p>{a.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 6 ROADMAP: Anfang einer größeren Plattform -->
  <section class="section roadmap" id="roadmap" aria-labelledby="roadmap-h">
    <div class="wrap">
      <div class="head head--center">
        <span class="eyebrow">Wohin wir uns entwickeln</span>
        <h2 id="roadmap-h">Heute Websites. <span class="accent">Das ist erst der Anfang.</span></h2>
        <p class="lead">Jeder Service soll Ihnen und Ihrem Unternehmen einen echten Mehrwert bringen. Weitere Angebote folgen.</p>
      </div>
      <ol class="rm reveal">
        {ROADMAP.map((r, i) => (
          <li class:list={[r.aktiv ? 'rm__aktiv' : 'rm__bald']} style={`--i:${i}`}>
            <span class="rm__icon" aria-hidden="true"><Icon name={r.icon} size={26} /></span>
            <strong>{r.name}</strong>
            <em>{r.aktiv ? 'Aktiv' : 'Bald verfügbar'}</em>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 7 VERTRAUEN + FAQ-Auszug -->
  <section class="section vertrauen" id="vertrauen" aria-labelledby="vertrauen-h">
    <div class="wrap vertrauen__grid">
      <div class="head">
        <span class="eyebrow">Gut zu wissen</span>
        <h2 id="vertrauen-h">Offen und <span class="accent">nachprüfbar.</span></h2>
        <ul class="belege">
          <li><Icon name="shield" size={18} /><span>{company.legalName}<br />Sitz Norderstedt, {company.registerCourt}, {company.registerNumber}</span></li>
          <li><Icon name="server" size={18} /><span>Server in Deutschland, Auftragsverarbeitungs-Vertrag auf Anfrage</span></li>
          <li><Icon name="lock" size={18} /><span>Keine Cookies, kein Tracking auf dieser Seite</span></li>
          <li><Icon name="unlock" size={18} /><span>Kein künstlicher Lock-in – Sie behalten die Kontrolle über Ihre Daten</span></li>
        </ul>
      </div>
      <div class="faq-auszug">
        {faqAuszug.map((f) => (
          <details class="faq__item">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
        <p class="faq-auszug__mehr"><a href={href('/faq/')}>Alle Fragen ansehen <Icon name="arrow" size={16} /></a></p>
      </div>
    </div>
  </section>

  <!-- 8 ABSCHLUSS -->
  <section class="abschluss" aria-labelledby="abschluss-h">
    <div class="wrap abschluss__inner">
      <h2 id="abschluss-h">Wenn sich etwas verändern soll, <span class="accent">sprechen wir darüber.</span></h2>
      <p class="abschluss__sub">Das Erstgespräch ist kostenlos und unverbindlich. Wir melden uns spätestens am nächsten Werktag.</p>
      <p class="abschluss__cta">
        <a class="btn btn--primary btn--lg" href={href('/kontakt/')}>Erstgespräch anfragen <Icon name="arrow" size={18} /></a>
        <a class="btn btn--ghost btn--lg" href={`mailto:${company.email}`}><Icon name="mail" size={18} /> {company.email}</a>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  /* Gemeinsame Kopfzeilen */
  .head { max-width: 760px; margin-bottom: clamp(26px, 5vw, 52px); }
  .head--center { margin-inline: auto; text-align: center; }
  .head--center .lead { margin-inline: auto; }
  .head .eyebrow { display: inline-block; margin-bottom: 12px; }
  .head h2 { font-size: clamp(1.9rem, 4.8vw, 3.2rem); line-height: 1.1; letter-spacing: -0.02em; }
  .head .lead { margin-top: 16px; }
  .muted { color: #837e73; }
  .section h3 { margin: 0 0 6px; }

  /* 1 HERO */
  .hero { position: relative; overflow: hidden; padding-block: clamp(36px, 7vw, 88px) 0; background: var(--paper); }
  .hero__bg { position: absolute; inset: 0; pointer-events: none; background:
    radial-gradient(50% 60% at 85% 20%, rgb(0 166 161 / 16%), transparent 70%),
    radial-gradient(40% 50% at 0% 100%, rgb(0 107 104 / 10%), transparent 70%); }
  .hero__grid { position: relative; display: grid; gap: 36px; align-items: center; }
  @media (min-width: 960px) { .hero__grid { grid-template-columns: 1.15fr 0.85fr; gap: 56px; } }
  .hero h1 { font-size: clamp(2.4rem, 7.4vw, 5rem); line-height: 1.04; letter-spacing: -0.03em; margin: 0 0 22px; max-width: 14ch; }
  .hero__was { font-size: clamp(1.1rem, 2.4vw, 1.45rem); line-height: 1.45; color: var(--ink-soft); max-width: 34ch; margin: 0 0 28px; }
  .hero__cta { display: flex; flex-wrap: wrap; gap: 12px; }
  .hero__fakten { position: relative; display: flex; flex-wrap: wrap; gap: 8px 24px; margin-top: clamp(32px, 6vw, 64px); padding-block: 18px; border-top: 1px solid var(--line); font-size: 0.92rem; color: var(--ink-soft); }
  .hero__fakten span { display: inline-flex; align-items: center; gap: 8px; }
  .hero__fakten :global(.icon) { color: var(--accent-ink); }

  /* Hero-Beispiel (Bewegung 1: Status-Linie) */
  .demo { margin: 0; background: var(--white); border: 1px solid var(--line); border-radius: 24px; padding: 22px; box-shadow: var(--shadow); display: grid; gap: 16px; max-width: 460px; width: 100%; justify-self: center; }
  .demo figcaption { font-size: 0.78rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--accent-ink); }
  .demo__msg { display: flex; gap: 14px; align-items: flex-start; background: var(--paper); border-radius: 16px; padding: 16px; }
  .demo__mic { flex: none; display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%; background: var(--accent); color: var(--ink); }
  .demo__msg strong { display: block; font-size: 0.85rem; color: var(--ink-soft); margin-bottom: 2px; }
  .demo__msg span { font-family: var(--font-head); font-weight: 600; line-height: 1.35; }
  .demo__status { list-style: none; margin: 0; padding: 0; display: grid; gap: 0; position: relative; }
  .demo__status li { display: flex; align-items: center; gap: 14px; padding: 9px 0; font-weight: 600; position: relative; color: var(--ink-soft); animation: lit 0.5s ease both; animation-delay: calc(0.8s + var(--i) * 0.9s); }
  .demo__status li + li::before { content: ''; position: absolute; left: 7px; top: -12px; width: 2px; height: 24px; background: var(--line); }
  .dot { width: 16px; height: 16px; border-radius: 50%; background: var(--line); flex: none; position: relative; z-index: 1; }
  .demo__status li:last-child { color: var(--ink); }
  @keyframes lit { from { color: #aaa49a; } to { color: var(--ink); } }
  .demo__status li .dot { animation: dotlit 0.5s ease both; animation-delay: calc(0.8s + var(--i) * 0.9s); }
  @keyframes dotlit { from { background: var(--line); transform: scale(0.8); } to { background: var(--accent); transform: scale(1); } }
  .demo__note { margin: 0; font-size: 0.95rem; color: var(--ink-soft); border-top: 1px dashed var(--line); padding-top: 12px; }

  /* 2 HALTUNG */
  .haltung { background: var(--white); }
  .haltung__grid { display: grid; gap: 32px; align-items: start; }
  @media (min-width: 960px) { .haltung__grid { grid-template-columns: 1.1fr 0.9fr; gap: 64px; } }
  .haltung .head { margin-bottom: 0; max-width: none; }
  .frust { list-style: none; margin: 18px 0 22px; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .frust li { padding: 6px 14px; border-radius: 999px; background: var(--paper-2); color: #6f6a60; text-decoration: line-through; text-decoration-color: rgb(160 110 30 / 70%); font-weight: 500; }
  .haltung__satz { margin: 0; max-width: 56ch; line-height: 1.7; color: var(--ink-soft); font-size: 1.05rem; }
  .haltung__satz strong { color: var(--ink); }
  .fragenbox { background: var(--dark); color: var(--white); border-radius: 24px; padding: clamp(24px, 4vw, 40px); }
  .fragenbox h3 { font-size: clamp(1.25rem, 2.6vw, 1.6rem); color: var(--white); margin-bottom: 18px; line-height: 1.25; }
  .fragenbox ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0; }
  .fragenbox li { padding: 14px 0 14px 26px; border-top: 1px solid var(--dark-line); position: relative; color: var(--dark-lead); line-height: 1.45; }
  .fragenbox li::before { content: ''; position: absolute; left: 0; top: 22px; width: 10px; height: 10px; border-radius: 50%; background: var(--accent); }

  /* 3 ANGEBOT */
  .angebot { background: var(--paper); }
  .angebot__grid { display: grid; gap: 24px; align-items: stretch; }
  @media (min-width: 960px) { .angebot__grid { grid-template-columns: 1.1fr 0.9fr; gap: 32px; } }
  .nutzen { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; }
  @media (min-width: 960px) { .nutzen { height: 100%; grid-template-rows: repeat(4, 1fr); } .nutzen li { align-items: center; } }
  .nutzen li { display: flex; gap: 16px; align-items: flex-start; background: var(--white); border: 1px solid var(--line); border-radius: 18px; padding: 20px 22px; }
  .nutzen__icon { flex: none; display: grid; place-items: center; width: 48px; height: 48px; border-radius: 14px; background: rgb(0 166 161 / 14%); color: var(--accent-ink); }
  .nutzen h3 { font-size: 1.1rem; }
  .nutzen p { margin: 0; color: var(--ink-soft); line-height: 1.5; }
  .preise { background: var(--white); border: 2px solid var(--accent); border-radius: 24px; padding: clamp(22px, 3.5vw, 34px); box-shadow: var(--shadow); }
  .preise h3 { font-size: 1.2rem; margin-bottom: 16px; }
  .preise__liste { list-style: none; margin: 0 0 18px; padding: 0; display: grid; gap: 10px; }
  .preise__liste li { display: flex; justify-content: space-between; gap: 14px; align-items: center; padding: 14px 16px; border-radius: 14px; background: var(--paper); }
  .preise__top { outline: 2px solid rgb(0 166 161 / 40%); }
  .preise__liste strong { display: block; font-family: var(--font-head); }
  .preise__liste span { display: block; font-size: 0.9rem; color: var(--ink-soft); line-height: 1.35; }
  .preise__liste p { margin: 0; text-align: right; flex: none; }
  .preise__liste b { display: block; font-family: var(--font-head); font-size: 1.7rem; line-height: 1.1; }
  .preise__liste small { color: var(--ink-soft); font-size: 0.8rem; }
  .preise__modell { list-style: none; margin: 0 0 20px; padding: 0; display: grid; gap: 6px; }
  .preise__modell li { display: flex; gap: 8px; align-items: center; line-height: 1.4; }
  .preise__modell :global(.icon) { color: var(--accent-ink); flex: none; }
  .preise__cta { display: flex; flex-wrap: wrap; gap: 10px; }

  /* 4 WARUM */
  .warum { background: var(--dark); color: var(--paper); }
  .warum h2, .warum h3 { color: var(--white); }
  .warum .eyebrow, .warum .accent { color: var(--accent); }
  .gruende { list-style: none; margin: 0; padding: 0; display: grid; gap: 16px; }
  @media (min-width: 640px) { .gruende { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1040px) { .gruende { grid-template-columns: repeat(4, 1fr); gap: 20px; } }
  .gruende li { background: rgb(255 255 255 / 6%); border: 1px solid var(--dark-line); border-radius: 20px; padding: 26px 22px; }
  .gruende__icon { display: grid; place-items: center; width: 52px; height: 52px; border-radius: 50%; background: rgb(0 166 161 / 30%); color: #5fe0da; margin-bottom: 14px; }
  .gruende h3 { font-size: 1.15rem; margin-bottom: 8px; }
  .gruende p { margin: 0; color: var(--dark-lead); line-height: 1.55; }
  .warum__mehr { text-align: center; margin: 28px 0 0; }
  .warum__mehr a { color: var(--accent); font-weight: 600; display: inline-flex; gap: 6px; align-items: center; }

  /* 5 ABLAUF (Bewegung 2: Prozess-Linie) */
  .schritte { list-style: none; margin: 0; padding: 0; display: grid; gap: 24px; position: relative; }
