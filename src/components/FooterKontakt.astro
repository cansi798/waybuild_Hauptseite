---
// Gemeinsamer Abschluss (dunkel) vor dem Footer: Frage + Erstgespräch + E-Mail.
// Letzter Schritt des Wegs (Design-System Jamil, Talk 3622): Die Weglinie biegt zur Mitte ab und endet im Zielpunkt –
// „Veränderung umgesetzt“. Darunter die Frage „Was möchten Sie verändern?“.
import { href } from '../lib/paths';
import { company, HOURS } from '../config/site';
import { FOOTER_KONTAKT as F } from '../config/home';
import Icon from './Icon.astro';
---

<section class="fkontakt section--dark etappe etappe--ziel" aria-labelledby="fkontakt-titel">
  <div class="zielweg" aria-hidden="true">
    <svg viewBox="0 0 1000 100" preserveAspectRatio="none" focusable="false"><path pathLength="1" d="M0 0 C 0 46, 20 56, 90 56 L 910 56 C 980 56, 1000 66, 1000 100" /></svg>
  </div>
  <svg class="zielpunkt" viewBox="0 0 48 48" aria-hidden="true" focusable="false"><circle cx="24" cy="24" r="20" /><circle cx="24" cy="24" r="11" /><circle class="zielpunkt__mitte" cx="24" cy="24" r="4.5" /></svg>
  <div class="wrap fkontakt__inner">
    <h2 id="fkontakt-titel">{F.pre}<span class="accent">{F.accent}</span></h2>
    <p class="fkontakt__text">{F.text}</p>
    <div class="fkontakt__actions">
      <a class="btn btn--primary btn--lg" href={href('/kontakt/')}>Erstgespräch anfragen <Icon name="arrow" size={18} /></a>
      <a class="btn btn--ghost btn--lg fkontakt__mail" href={`mailto:${company.email}`}><Icon name="mail" size={18} /> {company.email}</a>
    </div>
    <p class="fkontakt__zeiten">Servicezeiten: {HOURS}</p>
  </div>
</section>

<style>
  .fkontakt { padding-block: 0 clamp(48px, 7vw, 80px); position: relative; display: flow-root; }
  .fkontakt.etappe::before { display: none; }
  .zielweg { position: absolute; top: 0; left: calc(var(--weg-l) + 1px); right: 50%; height: 104px; pointer-events: none; }
  .zielweg svg { display: block; width: 100%; height: 100%; overflow: visible; }
  .zielweg path { fill: none; stroke: rgb(95 224 218 / 55%); stroke-width: 2; stroke-linecap: round; vector-effect: non-scaling-stroke; stroke-dasharray: 1; }
  .zielpunkt { position: relative; display: block; width: 48px; height: 48px; margin: 98px auto 22px; overflow: visible; }
  .zielpunkt circle { fill: var(--dark); stroke: var(--accent-light); stroke-width: 3.5; }
  .zielpunkt .zielpunkt__mitte { fill: var(--accent-light); stroke: none; }
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .zielweg path { animation: ziel-zeichnen linear both; }
      .zielpunkt { animation: ziel-auf linear both; }
      div.zielweg svg path { animation-timeline: view(); animation-range: entry 0% cover 30%; }
      svg.zielpunkt { animation-timeline: view(); animation-range: entry 60% cover 35%; }
    }
  }
  @keyframes ziel-zeichnen { from { stroke-dashoffset: 1; } to { stroke-dashoffset: 0; } }
  @keyframes ziel-auf { from { opacity: 0; transform: scale(0.4); } to { opacity: 1; transform: none; } }
  .fkontakt__inner { display: grid; justify-items: center; text-align: center; gap: 18px; }
  .fkontakt__inner h2, .fkontakt__inner p { margin: 0; }
  .fkontakt h2 { font-size: clamp(2rem, 5.4vw, 3.6rem); line-height: 1.08; letter-spacing: -0.025em; max-width: 18ch; }
  .fkontakt__text { color: var(--dark-lead); max-width: 46ch; font-size: clamp(1.05rem, 2vw, 1.2rem); line-height: 1.6; }
  .fkontakt__actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; margin-top: 8px; }
  .fkontakt__mail { overflow-wrap: anywhere; }
  .fkontakt__zeiten { color: var(--dark-soft); font-size: 0.92rem; }
  @media (max-width: 480px) { .fkontakt__actions { display: grid; width: 100%; } }
</style>
