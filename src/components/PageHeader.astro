---
// Seitenkopf aller Unterseiten im Leitbild „Der Weg“: Eyebrow mit Wegmarke, Überschrift, Einleitung,
// darunter die Markenlinie (gerade Linie mit Endpunkt) – dieselbe Linie wie im Startseiten-Hero.
interface Props {
  eyebrow: string;
  title: string;
  /** optionaler türkiser Schluss der Überschrift */
  accent?: string;
  lead?: string;
}
const { eyebrow, title, accent, lead } = Astro.props;
---

<section class="ph">
  <div class="wrap">
    <span class="eyebrow eyebrow--weg">{eyebrow}</span>
    <h1>{title}{accent && <> <span class="accent">{accent}</span></>}</h1>
    {lead && <p class="lead">{lead}</p>}
    <slot />
    <svg class="ph__linie" viewBox="0 0 440 40" aria-hidden="true" focusable="false">
      <path class="ph__knoten" pathLength="1" d="M2 22 C 14 22, 18 6, 32 8 C 48 10, 44 34, 30 32 C 18 30, 26 4, 50 6 C 72 8, 64 34, 54 32 C 46 30, 60 21, 84 21" />
      <path class="ph__gerade" pathLength="1" d="M84 21 L 410 21" />
      <circle class="ph__ziel" cx="424" cy="21" r="12" /><circle class="ph__ziel" cx="424" cy="21" r="6" />
    </svg>
  </div>
</section>

<style>
  .ph { position: relative; overflow: hidden; padding-block: clamp(40px, 7vw, 88px) clamp(28px, 4vw, 44px); background: var(--paper);
    background-image: radial-gradient(45% 70% at 92% 10%, rgb(0 166 161 / 12%), transparent 70%); }
  .ph .wrap { position: relative; }
  .ph h1 { font-size: clamp(2.1rem, 5.2vw, 3.6rem); line-height: 1.08; letter-spacing: -0.025em; max-width: 20ch; margin-bottom: 0.4em; hyphens: auto; overflow-wrap: break-word; }
  .ph .lead { margin: 0; }
  /* Kleine Fassung der Markenlinie: vom Kringel zum klaren Weg und Ziel (Design-System Jamil, Talk 3622) */
  .ph__linie { display: block; width: min(440px, 100%); height: auto; margin-top: clamp(28px, 4vw, 44px); overflow: visible; }
  .ph__knoten, .ph__gerade { fill: none; stroke-linecap: round; stroke-linejoin: round; stroke-width: 3; stroke-dasharray: 1; }
  .ph__knoten { stroke: #a8a191; animation: ph-zeichnen 0.7s linear both 0.1s; }
  .ph__gerade { stroke: var(--accent); animation: ph-zeichnen 0.6s linear both 0.8s; }
  .ph__ziel { fill: none; stroke: var(--accent); stroke-width: 3; animation: ph-auf 0.2s ease-out both 1.4s; }
  @keyframes ph-zeichnen { from { stroke-dashoffset: 1; } to { stroke-dashoffset: 0; } }
  @keyframes ph-auf { from { opacity: 0; } to { opacity: 1; } }
  @media (prefers-reduced-motion: reduce) { .ph__knoten, .ph__gerade, .ph__ziel { animation: none !important; } }
</style>
