---
// /partner/ – kurze Einladung „Partner werden“ (Jamil, Talk 4208: noch keine Partner, keine leeren Plätze).
// Ehrlicher Text ohne erfundene Partner oder Logos; Kontakt per E-Mail oder Formular.
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import UsKopf from '../components/us/UsKopf.astro';
import { href } from '../lib/paths';
import { company } from '../config/site';
import { PARTNERSEITE as P } from '../config/unterseiten';
import '../styles/denkweise.css';
import '../styles/unterseiten.css';

const mailto = `mailto:${company.email}?subject=${encodeURIComponent(P.werden.betreff)}`;
---

<BaseLayout
  title="Partner werden bei Waybuild"
  description="Partner von Waybuild werden: Sie unterstützen Unternehmen mit etwas, das zu unseren Produkten passt? Schreiben Sie uns, wir melden uns am nächsten Werktag."
  breadcrumb={[{ name: 'Partner', path: '/partner/' }]}
>
  <div class="dw us" data-denkweise>
    <svg class="dw-linie" aria-hidden="true" focusable="false"><path class="dw-strich" d="" /></svg>

    <UsKopf {...P.kopf} />

    <section class="dw-abschnitt dw-ohne-linie" id="partner-werden" aria-labelledby="werden-h">
      <div class="wrap">
        <div class="us-cta us-cta--partner">
          <div>
            <span class="dw-kenn"><Icon name="users" size={18} /> {P.werden.kenn}</span>
            <h2 id="werden-h">{P.werden.titel}</h2>
            <p>{P.werden.text}</p>
          </div>
          <div class="us-cta__aktionen">
            <a class="btn btn--primary btn--lg" href={mailto}><Icon name="mail" size={18} /> E-Mail schreiben<span class="sr-only"> an {company.email}</span></a>
            <a class="pfeil-link" href={href('/kontakt/?leistung=partnerschaft')}>Zum Kontaktformular <Icon name="arrow" size={16} /></a>
          </div>
          <div class="us-cta__unten">
            <h3 class="us-cta__klein">{P.werden.wichtig}</h3>
            <ul class="us-punkte us-punkte--drei us-punkte--flach">
              {P.werden.punkte.map((x) => (
                <li><span class="us-punkte__icon"><Icon name={x.icon} size={20} /></span><div><h4>{x.titel}</h4><p>{x.text}</p></div></li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
