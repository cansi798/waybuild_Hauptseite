---
// Bildsymbole der vier Haltungs-Karten (Jamil 27.10.2026, Talk 3537): Ohr, Gehirn, Glühbirne, Knoten wird gerade.
// Linienstil in Türkis. Bewegung: Die Linien zeichnen sich einmal, sobald die Karte sichtbar wird (Steuerung über
// .reveal/.is-visible der Karte); Details (Schallwellen, Strahlen, Pfeil) folgen kurz danach.
// Ohne JS und bei prefers-reduced-motion: sofort vollständig sichtbar.
interface Props { art: 'ohr' | 'gehirn' | 'licht' | 'knoten' }
const { art } = Astro.props;
---

<svg class="hbild" viewBox="0 0 48 48" width="56" height="56" aria-hidden="true" focusable="false">
  {art === 'ohr' && (
    <>
      <path pathLength="1" d="M13 33c0 4 3 7 7 7s6-3 6-6c0-4 4-5 6-9 1.5-3 2-5.5 2-8 0-7-5.5-12-12-12S10 10 10 17" />
      <path pathLength="1" d="M16 18c0-3 2-5.5 5-5.5s5 2.5 5 5.5c0 3.5-3.5 4.5-3.5 8" />
      <path class="hbild__extra" pathLength="1" d="M37 13c2.5 2.5 3.5 5 3.5 8s-1 5.5-3.5 8" />
      <path class="hbild__extra hbild__extra--2" pathLength="1" d="M41.5 8.5c3.5 3.5 5 7.5 5 12.5s-1.5 9-5 12.5" />
    </>
  )}
  {art === 'gehirn' && (
    <>
      <path pathLength="1" d="M24 11c-1.5-3-7.5-3.5-9 .5-4 .2-6 4.3-4.2 7.4-3.3 2.2-3 7.4.8 8.6-.4 4 3.6 6.4 7 5.2 1.2 3.2 5.4 3.4 5.4.3" />
      <path pathLength="1" d="M24 11c1.5-3 7.5-3.5 9 .5 4 .2 6 4.3 4.2 7.4 3.3 2.2 3 7.4-.8 8.6.4 4-3.6 6.4-7 5.2-1.2 3.2-5.4 3.4-5.4.3" />
      <path pathLength="1" d="M24 11v26" />
      <path class="hbild__extra" pathLength="1" d="M15.5 19c2.8 0 4.3 1.8 4.3 4.2M32.5 19c-2.8 0-4.3 1.8-4.3 4.2M16 28.5c2-1 4.2-.3 5 2M32 28.5c-2-1-4.2-.3-5 2" />
    </>
  )}
  {art === 'licht' && (
    <>
      <path pathLength="1" d="M24 9a10.5 10.5 0 0 0-6.5 18.7c1.2 1 2 2.7 2 4.3h9c0-1.6.8-3.3 2-4.3A10.5 10.5 0 0 0 24 9z" />
      <path pathLength="1" d="M19.5 36h9M21 40h6" />
      <path class="hbild__extra" pathLength="1" d="M24 2.5v2.5M38.5 9.5l-2 1.6M9.5 9.5l2 1.6M43 21h-2.5M5 21h2.5" />
    </>
  )}
  {art === 'knoten' && (
    <>
      <path pathLength="1" d="M4 30c4 0 6-11 11.5-10s4 10-.5 9.5S14 17 23 24h20" />
      <path class="hbild__extra" pathLength="1" d="M38 19l5 5-5 5" />
    </>
  )}
</svg>

<style>
  .hbild { display: block; overflow: visible; }
  .hbild path { fill: none; stroke: var(--accent-mid, #008f8a); stroke-width: 2.6; stroke-linecap: round; stroke-linejoin: round; stroke-dasharray: 1; }
  .hbild .hbild__extra { stroke: var(--accent); }
  /* Zeichnen beim Einblenden der Karte (nur mit JS) */
  :global(html.js) :global(.reveal:not(.is-visible)) .hbild path { stroke-dashoffset: 1; }
  :global(.reveal.is-visible) .hbild path { animation: hbild-zeichnen 1.1s cubic-bezier(.4,0,.2,1) both; animation-delay: calc(var(--d, 0ms) + 150ms); }
  :global(.reveal.is-visible) .hbild .hbild__extra { animation-duration: 0.6s; animation-delay: calc(var(--d, 0ms) + 1.1s); }
  :global(.reveal.is-visible) .hbild .hbild__extra--2 { animation-delay: calc(var(--d, 0ms) + 1.35s); }
  @keyframes hbild-zeichnen { from { stroke-dashoffset: 1; } to { stroke-dashoffset: 0; } }
  @media (prefers-reduced-motion: reduce) {
    .hbild path { animation: none !important; stroke-dashoffset: 0 !important; }
  }
</style>
