---
// Szene „Idee“ (Jamil, Talk 4007): Sechs Ideen schweben als kleine türkise Ideen-Karten um den Knoten auf der Linie.
// Beim Scrollen werden sie nacheinander in den Knoten gezogen (wandern, schrumpfen, verschmelzen); danach leuchtet der
// Knoten auf: aus vielen Ideen wird eine. Keine Verbindungslinien mehr („Spinnenbeine“).
// Technik: Alle Karten sitzen im Knoten; ihre Ruhelage ist ein Versatz in Container-Einheiten (--ox/--oy in cqw), den
// die Spur „fliessen“ in denkweise.ts auf 0 zieht. Ohne JS / reduzierte Bewegung: Ideen ruhig um den Knoten.
import Icon from '../Icon.astro';
import { DW_IDEE } from '../../config/denkweise';
const W = 440, H = 400, MX = 220, MY = 232;
const f = (n: number) => n.toFixed(3);
const ideen = DW_IDEE.ideen.map((i, k) => ({
  ...i, k,
  ox: f(((i.x - MX) / W) * 100), oy: f(((i.y - MY) / W) * 100),
  // fließen, während die Linie auf den Knoten zuläuft (Spitze erreicht ihn bei p ≈ 0.68)
  an: `auf:${f(0.02 + k * 0.04)}-${f(0.12 + k * 0.04)} fliessen:${f(0.48 + k * 0.05)}-${f(0.64 + k * 0.05)}`,
}));
const pc = (a: number, c: number) => `${((a / c) * 100).toFixed(2)}%`;
---
<div class="dw-bild dw-ideebild" data-szene style={`aspect-ratio: ${W} / ${H}`}>
  <svg viewBox={`0 0 ${W} ${H}`} aria-hidden="true" focusable="false">
    <circle class="dw-ideebild__hof" cx={MX} cy={MY} r="22" data-an="erscheinen:0.86-0.97" />
    <circle class="dw-knoten" cx={MX} cy={MY} r="7" data-an="erscheinen:0.3-0.4" />
    <circle class="dw-knoten dw-knoten--akzent" cx={MX} cy={MY} r="7" data-an="erscheinen:0.84-0.94" />
  </svg>
  <span class="dw-anker" style="left:50%;top:0%" data-weg></span>
  <span class="dw-anker" style={`left:50%;top:${pc(MY, H)}`} data-weg></span>
  <span class="dw-anker" style="left:50%;top:100%" data-weg></span>
  {ideen.map((i) => (
    <span class="dw-pos" style={`left:${pc(MX, W)};top:${pc(MY, H)}`}>
      <span class="dw-ideebild__idee" style={`--ox:${i.ox};--oy:${i.oy}`} data-an={i.an}><Icon name="idee" size={14} />{i.text}</span>
    </span>
  ))}
</div>
