---
// SCHRITT 1 · VORHER und DANN KOMMT WAYBUILD – zwei Szenen mit klarem Anfang und Ende (Jamil, Talk 3714–3753; Can 3750:
// gute Scroll-Storytelling-Praxis). Beide Szenen sind scroll-gekoppelt (kein Zeitablauf), stehen beim Scrollen (sticky),
// laufen rückwärts sauber und nutzen nur transform/opacity.
//   Szene 1 (grau): Der Brief aus dem Hero reist an der leicht welligen Linie durch sechs kurze Stationen und endet an der
//   letzten („Endlich Rückmeldung …“). Dort endet auch die graue Linie.
//   Szene 2 (türkis): Eine neue, gerade türkise Linie beginnt oben und zeichnet sich mit dem Scrollen; der Brief reist durch
//   vier Stationen im selben kompakten Kärtchen-Stil, nur türkis; die Linie läuft bis unten weiter in den nächsten Abschnitt.
// Ohne JS, bei reduzierter Bewegung oder sehr niedrigem Fenster: statische Listen.
// Bestätigt (Talk 3726): erste Rückmeldung < 1 Std. während der Servicezeiten; feste monatliche Pakete, keine Nachkalkulation.
import Icon from '../Icon.astro';
import type { IconName } from '../../config/site';

const VORHER: { t: string; icon: IconName }[] = [
  { t: 'Trifft beim Dienstleister ein', icon: 'home' },
  { t: 'Erst einmal Rückfragen …', icon: 'chat' },
  { t: '… Rückfragen geklärt', icon: 'check' },
  { t: 'Intern: Wer ist zuständig?', icon: 'users' },
  { t: 'Ein bis zwei Tage vergehen', icon: 'clock' },
  { t: 'Endlich Rückmeldung: Aufwand? Extrakosten?', icon: 'euro' },
];
// Gleich kleine Kärtchen wie oben, nur türkis (Talk 3751); Kerninfo als kurze zweite Zeile
const WAYBUILD: { t: string; info: string; icon: IconName }[] = [
  { t: 'Eine Nachricht genügt.', info: 'Text, Foto, Video oder Sprachnachricht', icon: 'chat' },
  { t: 'Ein fester Ansprechpartner.', info: 'Rückmeldung < 1 Std. (Servicezeiten)', icon: 'user' },
  { t: 'Ein klarer Ablauf.', info: 'Erst Prüfung, dann Bearbeitung', icon: 'layers' },
  { t: 'Verlässlich umgesetzt.', info: 'Fester Monatspreis, keine Nachkalkulation', icon: 'check' },
];

// Graue Linie: aus der senkrechten Hauptlinie (weicher Bogen) durch die Stationen, endet an der letzten Station
const P: [number, number][] = [[0, 0], [9, 8.3], [3, 25], [13, 41.7], [4, 58.3], [14, 75], [5, 91.7]];
const cr = (pts: [number, number][], a = 0.2) => pts.slice(0, -1).map((p1, i) => {
  const p0 = pts[i - 1] ?? p1, p2 = pts[i + 1], p3 = pts[i + 2] ?? p2;
  const f = (v: number) => v.toFixed(2);
  let c1: [number, number] = [p1[0] + (p2[0] - p0[0]) * a, p1[1] + (p2[1] - p0[1]) * a];
  const c2: [number, number] = [p2[0] - (p3[0] - p1[0]) * a, p2[1] - (p3[1] - p1[1]) * a];
  if (i === 0) c1 = [p1[0], p1[1] + (p2[1] - p1[1]) * 0.6]; // senkrechter Start: keine Ecke (Talk 3743)
  return ` C ${f(c1[0])} ${f(c1[1])}, ${f(c2[0])} ${f(c2[1])}, ${p2[0]} ${p2[1]}`;
}).join('');
const WEG = `M 0 0${cr(P)}`;
const STATIONEN = P.slice(1);
const Y2 = WAYBUILD.map((_, i) => 12 + i * 25); // Höhen der türkisen Stationen in %
---

<!-- SZENE 1 · VORHER -->
<section class="wandel wandel--1" id="so-arbeiten-wir" aria-labelledby="vorher-h" data-buehne="1">
  <div class="wrap wandel__grid">
    <div class="wandel__text">
      <span class="schritt-kenn">Schritt 1 · Vorher</span>
      <h2 id="vorher-h">Was mit einer Anfrage oft passiert.</h2>
      <p class="lead">Eine kleine Änderung, eine kurze Nachricht. Und dann?</p>
    </div>
    <div class="wandel__spur">
      <div class="tafel">
        <span class="anfrage" aria-hidden="true"><Icon name="mail" size={18} /></span>
        <div class="tafel__kopf">
          <p class="tafel__hinweis" aria-hidden="true"><Icon name="chevron" size={18} /> Weiterscrollen: Die Anfrage macht sich auf den Weg</p>
        </div>
        <div class="tafel__flaeche">
          <div class="reise">
            <svg class="reise__weg" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true" focusable="false"><path d={WEG} /></svg>
            <ol class="reise__stationen" aria-label="Stationen einer üblichen Anfrage">
              {VORHER.map((s, i) => (
                <li class="station" style={`--sx:${STATIONEN[i][0]}%;--sy:${STATIONEN[i][1]}%`}>
                  <span class="station__punkt" aria-hidden="true"></span>
                  <span class="k station__karte"><span class="station__icon" aria-hidden="true"><Icon name={s.icon} size={16} /></span><span>{s.t}</span></span>
                </li>
              ))}
            </ol>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- SZENE 2 · DANN KOMMT WAYBUILD: neue türkise Linie -->
<section class="wandel wandel--2" aria-labelledby="waybuild-h" data-buehne="2">
  <div class="wrap wandel__grid">
    <div class="wandel__text">
      <span class="schritt-kenn">Dann kommt Waybuild</span>
      <h2 id="waybuild-h">Schritt für Schritt entsteht Ordnung.</h2>
      <p class="kenn-ende" data-ende><strong>Mit Waybuild:</strong> Ein klarer Weg. Gerade Abläufe.</p>
    </div>
    <div class="wandel__spur">
      <div class="tafel tafel--klar">
        <span class="anfrage anfrage--klar" aria-hidden="true"><Icon name="mail" size={18} /></span>
        <div class="tafel__flaeche">
          <div class="reise">
            <span class="reise__gerade" aria-hidden="true"></span>
            <ol class="reise__stationen" aria-label="So läuft es mit Waybuild">
              {WAYBUILD.map((s, i) => (
                <li class="station station--klar" style={`--sx:0%;--sy:${Y2[i]}%`}>
                  <span class="station__punkt" aria-hidden="true"></span>
                  <span class="k station__karte"><span class="station__icon" aria-hidden="true"><Icon name={s.icon} size={16} /></span><span><strong>{s.t}</strong><small>{s.info}</small></span></span>
                </li>
              ))}
            </ol>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  const niedrig = window.matchMedia('(max-height: 559px)');
  const kopf = document.getElementById('siteHeader');
  const clamp = (v: number, a = 0, b = 1) => Math.min(b, Math.max(a, v));
  const glatt = (t: number) => t * t * (3 - 2 * t);
  const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
  const breitMq = window.matchMedia('(min-width: 960px)');
  const buehnen = Array.from(document.querySelectorAll<HTMLElement>('[data-buehne]'));

  // Verbindungsstück über der Fläche (Szene 1, auch statisch)
  const stubSetzen = () => buehnen.forEach((b) => { const t = b.querySelector<HTMLElement>('.tafel'), f = b.querySelector<HTMLElement>('.tafel__flaeche'); if (t && f) t.style.setProperty('--stub-h', `${f.offsetTop}px`); });
  stubSetzen(); addEventListener('resize', stubSetzen); document.fonts?.ready.then(stubSetzen);

  if (buehnen.length && !reduce.matches && !niedrig.matches) {
    buehnen.forEach((b) => b.classList.add('wandel--live'));
    // Nur schreiben, was sich wirklich ändert: spart Stil-Neuberechnungen in jedem Frame
    const alt = new WeakMap<HTMLElement, Record<string, string>>();
    const setz = (el: HTMLElement, prop: 'transform' | 'opacity' | 'visibility', wert: string) => {
      let c = alt.get(el); if (!c) { c = {}; alt.set(el, c); }
      if (c[prop] !== wert) { c[prop] = wert; el.style[prop] = wert; }
    };
    const vergessen = (el: HTMLElement | null) => { if (el) alt.delete(el); };
    const oben = () => (kopf ? kopf.getBoundingClientRect().bottom : 72);
    const fortschritt = (b: HTMLElement) => {
      const spur = b.querySelector<HTMLElement>('.wandel__spur')!, tafel = b.querySelector<HTMLElement>('.tafel')!;
      return clamp((oben() - spur.getBoundingClientRect().top) / Math.max(1, spur.offsetHeight - tafel.offsetHeight));
    };
    // Reise mit Halten: n Stationen, Start S, je Weg T und Halt W → liefert Anteil 0…1 entlang der Ziele
    const plan = (p: number, n: number, S: number, T: number, W: number) => {
      if (p <= S) return { k: -1, f: 0, halt: false };
      for (let k = 0; k < n; k++) {
        const ab = S + k * (T + W);
        if (p < ab + T) return { k, f: glatt((p - ab) / T), halt: false };
        if (p < ab + T + W) return { k, f: 1, halt: true };
      }
      return { k: n, f: 0, halt: false };
    };

    // ── Szene 1 ──
    const b1 = buehnen[0];
    const t1 = b1.querySelector<HTMLElement>('.tafel')!;
    const svg1 = b1.querySelector<SVGSVGElement>('.reise__weg')!;
    const weg1 = svg1.querySelector<SVGPathElement>('path')!;
    const st1 = Array.from(b1.querySelectorAll<HTMLElement>('.station'));
    const brief1 = b1.querySelector<HTMLElement>('.anfrage')!;
    const hinweis = b1.querySelector<HTMLElement>('.tafel__hinweis');
    const S1 = 0.04, T1 = 0.1, W1 = 0.05;
    let frac: number[] = [], len1 = 1, lut1: { x: number; y: number }[] = [];
    // ── Szene 2 ──
    const b2 = buehnen[1];
    const t2 = b2.querySelector<HTMLElement>('.tafel')!;
    const reise2 = b2.querySelector<HTMLElement>('.reise')!;
    const st2 = Array.from(b2.querySelectorAll<HTMLElement>('.station'));
    const brief2 = b2.querySelector<HTMLElement>('.anfrage')!;
    const gerade2 = b2.querySelector<HTMLElement>('.reise__gerade')!;
    const ende = b2.querySelector<HTMLElement>('[data-ende]');
    const S2 = 0.03, T2 = 0.1, W2 = 0.07;
    // ── Startpunkt im Hero (Vorphase) ──
    const startpunkt = document.querySelector<HTMLElement>('.hlinie__start');
    const heroSvg = document.querySelector<SVGSVGElement>('.hlinie svg');
    const heroWeg = heroSvg?.querySelector<SVGPathElement>('path');
    const label = document.querySelector<HTMLElement>('.hlinie__label');
    let heroPunkte: { x: number; y: number }[] = [];

    const messen = () => {
      len1 = weg1.getTotalLength();
      lut1 = Array.from({ length: 401 }, (_, s) => { const pt = weg1.getPointAtLength((s / 400) * len1); return { x: pt.x, y: pt.y }; });
      frac = st1.map((_, i) => {
        const yZiel = [8.3, 25, 41.7, 58.3, 75, 91.7][i];
        let best = 0, d = 1e9;
        for (let s = 0; s <= 240; s++) { const pt = weg1.getPointAtLength((s / 240) * len1); const dd = Math.abs(pt.y - yZiel); if (dd < d) { d = dd; best = s / 240; } }
        return best;
      });
      { const sr = svg1.getBoundingClientRect(), tr = t1.getBoundingClientRect(); so = { x: sr.left - tr.left, y: sr.top - tr.top, w: sr.width, h: sr.height }; }
      if (heroWeg) { const L = heroWeg.getTotalLength(); heroPunkte = Array.from({ length: 121 }, (_, s) => { const pt = heroWeg.getPointAtLength((s / 120) * L); return { x: pt.x, y: pt.y }; }); }
    };
    let so = { x: 0, y: 0, w: 1, h: 1 };
    const punkt1 = (f: number) => {
      const u = clamp(f) * 400, i = Math.min(399, Math.floor(u)), t = u - i, a = lut1[i], b = lut1[i + 1];
      const pt = { x: lerp(a.x, b.x, t), y: lerp(a.y, b.y, t) };
      return { x: so.x + (pt.x / 100) * so.w, y: so.y + (pt.y / 100) * so.h };
    };

    // Vorphase: Der Brief im Hero reitet beim Scrollen an der Linie hinunter bis zum Startpunkt von Szene 1 (Übergabe ohne Sprung).
    // Alle Maße werden in messen() in Dokument-Koordinaten erfasst; pro Frame nur noch scrollY lesen (kein Layout-Thrash).
    // Achtung: Die Kopfzeile schrumpft beim Scrollen (72 → 62 px) und schiebt den Inhalt darunter um die Differenz nach oben –
    // deshalb wird ihre Höhe beim Messen gemerkt und pro Frame ausgeglichen.
    let vm: { bx: number; by: number; hl: number; ht: number; hw: number; hh: number; zielX: number; zielY: number; stub: number; kh: number } | null = null;
    const vorMessen = () => {
      if (!startpunkt || !heroSvg) return;
      startpunkt.style.transform = ''; vergessen(startpunkt);
      const sy = window.scrollY, b = startpunkt.getBoundingClientRect(), hr = heroSvg.getBoundingClientRect();
      const f1 = b1.querySelector<HTMLElement>('.tafel__flaeche')!;
      const lx = parseFloat(getComputedStyle(t1).getPropertyValue('--linie-x')) || 0;
      const spur1 = b1.querySelector<HTMLElement>('.wandel__spur')!;
      vm = { bx: b.left + b.width / 2, by: b.top + b.height / 2 + sy, hl: hr.left, ht: hr.top + sy, hw: hr.width, hh: hr.height,
        zielX: t1.getBoundingClientRect().left + lx, zielY: spur1.getBoundingClientRect().top + sy + f1.offsetTop, stub: f1.offsetTop, kh: kopf ? kopf.offsetHeight : 0 };
    };
    const vorphase = (p1: number, sy: number, ob: number, tTop: number, kh: number) => {
      if (!startpunkt || !vm) return;
      const dk = kh - vm.kh, by = vm.by + dk, ht = vm.ht + dk;
      // Viewport-Höhe des Briefs: mitreiten auf Höhe des späteren Übergabepunkts (= Start der reisenden Anfrage), nie über dem
      // Start im Hero, nie unter dem Ziel; beim Anheften der Bühne fallen beide Werte exakt zusammen (Übergabe ohne Sprung)
      const yDoc = Math.min(Math.max(sy + ob + so.y, by), sy + tTop + so.y);
      let x = vm.zielX;
      if (yDoc <= ht + vm.hh && heroPunkte.length) {
        let d = 1e9;
        for (const pt of heroPunkte) { const dd = Math.abs(ht + (pt.y / 100) * vm.hh - yDoc); if (dd < d) { d = dd; x = vm.hl + (pt.x / 100) * vm.hw; } }
      }
      setz(startpunkt, 'transform', `translate(${(x - vm.bx).toFixed(1)}px, ${(yDoc - by).toFixed(1)}px)`);
      const uebergabe = clamp(p1 / 0.01);
      setz(startpunkt, 'opacity', (1 - uebergabe).toFixed(3));
      setz(brief1, 'visibility', uebergabe > 0 ? '' : 'hidden');
      if (label) setz(label, 'opacity', (1 - clamp((yDoc - by) / 80)).toFixed(3));
    };

    const szene1 = (p: number) => {
      const r = plan(p, st1.length, S1, T1, W1);
      let f = 0;
      if (r.k >= st1.length) f = frac[frac.length - 1];
      else if (r.k >= 0) f = lerp(r.k ? frac[r.k - 1] : 0, frac[r.k], r.f);
      const a = punkt1(f);
      setz(brief1, 'transform', `translate(${a.x.toFixed(1)}px, ${a.y.toFixed(1)}px)`);
      setz(brief1, 'opacity', clamp(p / 0.01).toFixed(3));
      brief1.classList.toggle('anfrage--wartet', r.k === 4 && r.halt);
      st1.forEach((s, k) => {
        const ank = S1 + k * (T1 + W1) + T1;
        setz(s, 'opacity', clamp((p - ank + 0.02) / 0.02).toFixed(3));
        s.classList.toggle('station--hier', p >= ank - 0.005 && (k === st1.length - 1 || p < ank + W1));
      });
      if (hinweis) setz(hinweis, 'opacity', (1 - clamp(p / 0.03)).toFixed(3));
    };

    const szene2 = (p: number) => {
      const r = plan(p, st2.length, S2, T2, W2);
      const { fh, top, ziele, lx } = m2;
      let y = 0;
      if (r.k < 0) y = 0;
      else if (r.k >= st2.length) y = lerp(ziele[ziele.length - 1], fh, glatt(clamp((p - (S2 + st2.length * (T2 + W2))) / (1 - (S2 + st2.length * (T2 + W2)) - 0.03))));
      else y = lerp(r.k ? ziele[r.k - 1] : 0, ziele[r.k], r.f);
      // Linie direkt per transform (statt CSS-Variable am Elternteil, die den ganzen Teilbaum neu berechnen lässt)
      setz(gerade2, 'transform', `scaleY(${clamp(y / Math.max(1, fh)).toFixed(4)})`);
      setz(brief2, 'transform', `translate(${lx.toFixed(1)}px, ${(top + y).toFixed(1)}px)`);
      setz(brief2, 'opacity', (clamp(p / 0.015) * (1 - clamp((p - 0.97) / 0.03))).toFixed(3));
      st2.forEach((s, k) => {
        const ank = S2 + k * (T2 + W2) + T2;
        setz(s, 'opacity', clamp((p - ank + 0.02) / 0.02).toFixed(3));
        s.classList.toggle('station--hier', p >= ank - 0.005 && p < ank + W2);
      });
      if (ende && breitMq.matches) setz(ende, 'opacity', clamp((p - 0.86) / 0.05).toFixed(3));
    };

    let laeuft = false, z1 = -1, z2 = -1;
    let m2 = { fh: 1, top: 0, ziele: [] as number[], lx: 0 };
    const zeichnen = () => {
      laeuft = false;
      // Lesen …
      const sy = window.scrollY, ob = oben();
      const p1 = fortschritt(b1), p2 = fortschritt(b2);
      const tTop = t1.getBoundingClientRect().top, kh = kopf ? kopf.offsetHeight : 0;
      // … dann schreiben
      vorphase(p1, sy, ob, tTop, kh);
      // Szene ganz vor oder ganz hinter ihrem Bereich: nur einmal in den Endzustand setzen
      if (p1 !== z1) { z1 = p1; szene1(p1); }
      if (p2 !== z2) { z2 = p2; szene2(p2); }
    };
    const anfordern = () => { if (!laeuft) { laeuft = true; requestAnimationFrame(zeichnen); } };
    const neu = () => {
      startpunkt && (startpunkt.style.transform = ''); vergessen(startpunkt);
      z1 = z2 = -1;
      stubSetzen(); messen(); vorMessen();
      m2 = { fh: reise2.clientHeight, top: reise2.offsetTop + (reise2.parentElement?.offsetTop ?? 0), ziele: st2.map((s) => s.offsetTop), lx: parseFloat(getComputedStyle(t2).getPropertyValue('--linie-x')) || 0 };
      zeichnen();
    };
    neu();
    window.addEventListener('scroll', anfordern, { passive: true });
    window.addEventListener('resize', () => requestAnimationFrame(neu));
    if (document.fonts) document.fonts.ready.then(neu);
    reduce.addEventListener?.('change', () => location.reload());
  }
</script>

<style>
  .wandel { position: relative; background: var(--paper); padding-top: clamp(48px, 7vw, 96px); }
  .wandel--2 { padding-top: clamp(40px, 6vw, 80px); }
  .wandel__grid { display: grid; gap: 28px; }
  .wandel__text h2 { font-size: clamp(2rem, 4.4vw, 3.3rem); line-height: 1.06; letter-spacing: -0.028em; margin-bottom: 16px; }
  .wandel__text .lead { margin: 0; max-width: 46ch; }
  .kenn-ende { margin: 0; font-family: var(--font-head); font-weight: 650; font-size: clamp(1.1rem, 2vw, 1.35rem); color: var(--ink); }
  .kenn-ende strong { color: var(--accent-ink); }

  /* Arbeitsfläche */
  .tafel { --linie-x: 14px; position: relative; padding-bottom: 8px; }
  /* Szene 1: Verbindungsstück aus dem Hero (grau) */
  .wandel--1 .tafel::before { content: ''; position: absolute; left: calc(var(--linie-x) - 1.25px); top: 0; width: 2.5px; height: var(--stub-h, 0px); background: #cdc6b8; }
  .tafel__kopf { position: relative; min-height: 1px; padding-left: calc(var(--linie-x) + 30px); }
  .tafel__hinweis { display: none; }
  .tafel__flaeche { position: relative; }
  .reise { position: relative; height: clamp(520px, 140vw, 600px); margin-left: var(--linie-x); }
  .wandel--2 .reise { height: clamp(420px, 110vw, 480px); }
  .reise__weg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .reise__weg path { fill: none; stroke: #cdc6b8; stroke-width: 2.5; stroke-linecap: round; vector-effect: non-scaling-stroke; }
  /* Szene 2: neue gerade türkise Linie, von oben bis unten (schließt an den nächsten Abschnitt an) */
  .reise__gerade { position: absolute; left: -1.5px; top: 0; bottom: -8px; width: 3px; background: var(--accent); transform-origin: top; }
  .reise__stationen { list-style: none; margin: 0; padding: 0; }
  .station { position: absolute; left: var(--sx); top: var(--sy); width: 0; height: 0; }
  .station__punkt { position: absolute; left: -6px; top: -6px; width: 12px; height: 12px; border-radius: 50%; background: var(--paper); border: 2.5px solid #cdc6b8; box-sizing: border-box; }
  .station__karte {
    position: absolute; left: 26px; top: 0; transform: translateY(-50%); width: max-content; max-width: min(19rem, 62vw);
    --k-pad: 9px 14px; --k-gap: 10px; align-items: center; font-family: var(--font-head); font-weight: 600; font-size: 0.95rem; line-height: 1.3; color: #5b574f;
    transition: border-color 200ms ease, box-shadow 200ms ease;
  }
  .station__icon { flex: none; display: grid; place-items: center; width: 28px; height: 28px; border-radius: 8px; background: rgb(84 84 84 / 7%); color: #6f6a60; }
  .station--hier .station__karte { border-color: #b4ad9e; }
  /* türkise Variante: gleiche Größe und Form, nur türkis (Talk 3751) */
  .station--klar .station__punkt { border-color: var(--accent); }
  .station--klar .station__karte { --k-rand: rgb(0 166 161 / 40%); color: var(--ink); }
  .station--klar .station__icon { background: rgb(0 166 161 / 12%); color: var(--accent-ink); }
  .station__karte strong { display: block; font-weight: 650; }
  .station__karte small { display: block; font-family: var(--font-body); font-weight: 500; font-size: 0.82rem; color: var(--ink-soft); }
  .station--klar.station--hier .station__karte { border-color: var(--accent); box-shadow: 0 0 0 4px rgb(0 166 161 / 16%), inset 0 0 0 999px rgb(0 166 161 / 6%); }

  .anfrage { display: none; }

  /* Handy: Text vor der Bühne; in Szene 1 läuft die Linie links neben dem Text weiter */
  @media (max-width: 959px) {
