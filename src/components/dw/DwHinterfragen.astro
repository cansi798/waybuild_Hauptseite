---
// Szene „Hinterfragen“ (Jamil, Talk 4106): ein kurzer Dialog in Sprechblasen, der beim Scrollen Schritt für Schritt
// erscheint – links der Kunde, rechts waybuild (türkises W), an der Linie in der Mitte. Am Ende eine türkise
// Ergebnis-Karte mit den drei Wegen (die bei „Entscheiden“ abgewogen werden), darunter dezent durchgestrichen
// „Nicht unbedingt eine komplett neue Website“. Danach läuft die Linie weiter. Ohne JS / reduzierte Bewegung:
// kompletter Dialog sichtbar.
import Icon from '../Icon.astro';
import { DW_HINTERFRAGEN } from '../../config/denkweise';
const T = DW_HINTERFRAGEN;
const f = (n: number) => n.toFixed(2);
---
<div class="dw-bild dw-dialog" data-szene>
  <span class="dw-dialog__linie" data-an="hoch:0-0.95" aria-hidden="true"></span>
  <span class="dw-anker" style="left:50%;top:0" data-weg="ein"></span>
  <ol class="dw-dialog__liste">
    {T.dialog.map((z, i) => (
      <li class:list={['dw-dialog__zeile', `dw-dialog__zeile--${z.wer}`]} data-an={`auf:${f(0.04 + i * 0.15)}-${f(0.14 + i * 0.15)}`}>
        <span class="dw-dialog__blase"><span class="sr-only">{z.wer === 'kunde' ? 'Kunde: ' : 'waybuild: '}</span>{z.text}</span>
        <span class="dw-dialog__wer" aria-hidden="true">{z.wer === 'kunde' ? <Icon name="user" size={16} /> : 'W'}</span>
      </li>
    ))}
  </ol>
  <div class="dw-dialog__ergebnis" data-an="auf:0.64-0.76">
    <ul>{T.ergebnis.map((e) => <li><Icon name="check" size={18} /> {e}</li>)}</ul>
  </div>
  <p class="dw-dialog__nicht" data-an="auf:0.74-0.84"><s>{T.nichtUnbedingt}</s></p>
  <span class="dw-anker" style="left:50%;top:100%" data-weg="aus"></span>
</div>
