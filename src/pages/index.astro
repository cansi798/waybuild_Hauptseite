---

// Startseite „Komplettes Umdenken“ (Jamil, Talk k8oxzjva #4544, 04.11.2026): zehn Abschnitte in seiner Reihenfolge –
// Hero, Warum es Waybuild gibt, Für wen, Wofür wir stehen, Zusammenarbeit, Entscheidungen (bewusst vor den Produkten),
// Lösungen, Projekte und Ergebnisse, Darauf können Sie sich verlassen, Abschluss – dazu das Footer-Markenstatement.
// Texte wörtlich in src/config/startseite.ts. Jeder Abschnitt endet mit einer leisen Besucherfrage (HsFrage).
// Animationen mit der Waybuild-Linie über die vorhandene Engine (src/scripts/denkweise.ts: Szenen [data-szene], Spuren
// [data-an], nur transform/opacity/stroke-dashoffset, reduzierte Bewegung = Endzustand); Hero-Verwandlung einmalig per CSS.
// Vorherige Startseite „Denkweise“: Branch vor-umdenken-20261104 (Komponenten src/components/dw/ bleiben für /ueber-uns/).
// Aufbau seit 04.11.2026 in src/components/hs/Startseite.astro (gemeinsam mit /en/).
import BaseLayout from '../layouts/BaseLayout.astro';
import Startseite from '../components/hs/Startseite.astro';
import { HS_DE } from '../config/startseite';
import { META_START } from '../config/hauptseite';
import '../styles/startseite.css';
---

<BaseLayout title="Website Service und digitale Lösungen" description={META_START} hideFooterKontakt>
  <Startseite S={HS_DE} lang="de" />
</BaseLayout>


<script>
  import '../scripts/denkweise';
</script>
