---
// /zusagen/ im Leitbild „Der Weg“ (27.10.2026). Inhalte unverändert aus config/hauptseite.ts,
// „schriftlich“ entfernt (nicht belegt). Platzhalter-Werte erscheinen nur, solange SHOW_HINTS aktiv ist.
import BaseLayout from '../layouts/BaseLayout.astro';
import WegTrenner from '../components/WegTrenner.astro';
import PageHeader from '../components/PageHeader.astro';
import SectionHead from '../components/SectionHead.astro';
import Weg from '../components/Weg.astro';
import Icon from '../components/Icon.astro';
import { SHOW_HINTS } from '../config/site';
import { SLA_KERN, SLA_HINWEIS, ZUSAGEN, TICKET, PROZESSE, WERTE, VERTRAUEN } from '../config/hauptseite';
const PLATZHALTER = '[Wert einsetzen]';
const teile = (t: string) => t.split(PLATZHALTER);
// Zusagen mit offenem Wert nur in der Vorschau mit Hinweisen zeigen – nie live
const slas = SLA_KERN.filter((z) => SHOW_HINTS || !z.wert.includes(PLATZHALTER));
---

<BaseLayout
  title="Unsere Zusagen"
  description="Unsere Zusagen für alle Produkte: feste Zeiten, ein klarer Ablauf für jede Anfrage und die Werte, nach denen Waybuild arbeitet."
  breadcrumb={[{ name: 'Unsere Zusagen', path: '/zusagen/' }]}
>
  <PageHeader eyebrow="Unsere Zusagen" title="Was Sie von uns" accent="erwarten können." lead="Für alle unsere Produkte: feste Zeiten, ein klarer Ablauf, einfache Worte." />

  <section class="section section--dark etappe" id="zusagen" aria-labelledby="zusagen-h">
    <WegTrenner variante={2} />
    <div class="wrap">
      <SectionHead eyebrow="Service-Zusagen" pre="Feste Zusagen. " accent="Klare Zeiten." text="Feste Zeiten, für jeden Kunden gleich." id="zusagen-h" />
      <ul class="sla">
        {slas.map((z) => (
          <li class="sla__item reveal">
            <span class="sla__icon" aria-hidden="true"><Icon name={z.icon} size={26} /></span>
            <span class="sla__label">{z.label}</span>
            <strong class="sla__wert">{teile(z.wert).map((t, k) => (<>{k > 0 && <mark class="platzhalter">{PLATZHALTER}</mark>}{t}</>))}</strong>
            <p>{z.text}</p>
          </li>
        ))}
      </ul>
      <ul class="zusagen">
        {ZUSAGEN.map((z) => (
          <li><span class="zusagen__icon" aria-hidden="true"><Icon name={z.icon} size={20} /></span><span><strong>{z.title}.</strong> {z.text}</span></li>
        ))}
      </ul>
      <p class="sla__hinweis">{SLA_HINWEIS}</p>
    </div>
  </section>

  <section class="section etappe" id="ticketsystem" aria-labelledby="ticket-h">
    <WegTrenner variante={1} />
    <div class="wrap">
      <SectionHead eyebrow="So läuft eine Anfrage" pre="Eine Nachricht. " accent="Ein fester Ablauf." text="Sie müssen nichts ausfüllen. Den Rest erledigen wir." id="ticket-h" />
      <Weg art="gerade" stationen={TICKET.map((t) => ({ titel: t.title, text: t.text, icon: t.icon }))} zeichnen nummern />
    </div>
  </section>

  <section class="section section--sand etappe" id="prozesse" aria-labelledby="prozesse-h">
    <WegTrenner variante={2} />
    <div class="wrap prozesse">
      <SectionHead eyebrow="Abläufe & Transparenz" pre="Struktur statt " accent="Zufall." text="Jedes Anliegen läuft nach einem festen Ablauf, und den verbessern wir laufend." id="prozesse-h" />
      <ul class="liste">
        {PROZESSE.map((p) => (
          <li class="reveal">
            <span class="liste__icon" aria-hidden="true"><Icon name={p.icon} size={22} /></span>
            <div><h3>{p.title}</h3><p>{p.text}</p></div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section etappe" id="werte" aria-labelledby="werte-h">
    <WegTrenner variante={1} />
    <div class="wrap">
      <SectionHead eyebrow="Wofür wir stehen" pre="Sechs Werte. " accent="Jeden Tag." text="Was diese Werte für Sie als Kunde ganz konkret bedeuten." id="werte-h" />
      <ul class="werte">
        {WERTE.map((w) => (
          <li class="wert reveal">
            <span class="liste__icon" aria-hidden="true"><Icon name={w.icon} size={24} /></span>
            <h3>{w.title}</h3>
            <p class="wert__lead">{w.lead}</p>
            <p class="wert__text">{w.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section--sand etappe" id="vertrauen" aria-labelledby="vertrauen-h">
    <WegTrenner variante={2} />
    <div class="wrap">
      <SectionHead eyebrow="Darauf können Sie sich verlassen" pre="Gute Gründe für " accent="Vertrauen." id="vertrauen-h" />
      <ul class="vertrauen">
        {VERTRAUEN.map((v) => (
          <li>
            <span class="liste__icon" aria-hidden="true"><Icon name={v.icon} size={22} /></span>
            <div><h3>{v.title}</h3><p>{v.text}</p></div>
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .section h3 { font-size: 1.1rem; margin: 0 0 4px; }
  .sla { list-style: none; margin: 0; padding: 0; display: grid; gap: 18px; }
  @media (min-width: 760px) { .sla { grid-template-columns: 1fr 1fr; gap: 24px; } }
  .sla__item { background: rgb(255 255 255 / 6%); border: 1px solid var(--dark-line); border-radius: 20px; padding: clamp(22px, 3vw, 30px); display: grid; gap: 8px; justify-items: start; }
  .sla__icon { display: grid; place-items: center; width: 52px; height: 52px; border-radius: 50%; border: 2px solid var(--accent-light); color: var(--accent-light); margin-bottom: 6px; }
  .sla__label { font-size: 0.8rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--dark-soft); }
  .sla__wert { font-family: var(--font-head); font-size: clamp(1.3rem, 2.6vw, 1.6rem); line-height: 1.25; color: var(--white); }
  .sla__item p { margin: 0; color: var(--dark-lead); line-height: 1.6; }
  .platzhalter { background: #ffe58a; color: var(--ink); padding: 0 6px; border-radius: 4px; font-size: 0.8em; white-space: nowrap; }
  .zusagen { list-style: none; margin: 28px 0 0; padding: 0; display: grid; gap: 14px 24px; }
  @media (min-width: 760px) { .zusagen { grid-template-columns: 1fr 1fr; } }
  .zusagen li { display: flex; gap: 12px; align-items: flex-start; line-height: 1.5; color: var(--dark-lead); }
  .zusagen strong { color: var(--white); font-weight: 600; }
  .zusagen__icon { flex: none; display: grid; place-items: center; width: 36px; height: 36px; border-radius: 50%; border: 1px solid var(--dark-line); color: var(--accent-light); }
  .sla__hinweis { margin: 28px 0 0; font-size: 0.92rem; color: var(--dark-soft); }

  .prozesse { display: grid; gap: 28px; }
  @media (min-width: 960px) { .prozesse { grid-template-columns: 0.9fr 1.1fr; gap: 56px; align-items: start; } .prozesse :global(.section-head) { margin-bottom: 0; } }
  .liste, .vertrauen { list-style: none; margin: 0; padding: 0; display: grid; gap: 22px; }
  .liste li, .vertrauen li { display: flex; gap: 16px; align-items: flex-start; }
  .liste p, .vertrauen p { margin: 0; color: var(--ink-soft); line-height: 1.65; }
  .liste__icon { flex: none; display: grid; place-items: center; width: 48px; height: 48px; border-radius: 50%; background: rgb(0 166 161 / 13%); color: var(--accent-ink); }

  .werte { list-style: none; margin: 0; padding: 0; display: grid; gap: 20px; }
  @media (min-width: 720px) { .werte { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1000px) { .werte { grid-template-columns: repeat(3, 1fr); gap: 24px; } }
  .wert { background: var(--paper); border: 1px solid var(--line); border-radius: 20px; padding: clamp(22px, 3vw, 28px); }
  .wert .liste__icon { margin-bottom: 14px; }
  .wert__lead { margin: 0 0 10px; font-weight: 600; line-height: 1.45; color: var(--accent-ink); }
  .wert__text { margin: 0; font-size: 0.97rem; line-height: 1.7; color: var(--ink-soft); }

  @media (min-width: 640px) { .vertrauen { grid-template-columns: repeat(2, 1fr); gap: 24px 32px; } }
  @media (min-width: 1000px) { .vertrauen { grid-template-columns: repeat(3, 1fr); } }
</style>
