---

// /ueber-uns/ (Jamil, Talk 4192): wer Waybuild ist, Mission, Denkweise kompakt, Prinzipien, Menschen.
// Stil der Startseite: eine Scroll-Linie läuft durch die drei ersten Abschnitte (Steckbrief → Kernsatz → Denkweise)
// und endet wie auf der Startseite im Verbessern-Kreis; Prinzipien und Team ohne Linie. Nur Fakten aus Impressum/Configs.
// Aufbau seit 04.11.2026 in src/components/us/UeberUnsInhalt.astro (gemeinsam mit /en/about/).
import BaseLayout from '../layouts/BaseLayout.astro';
import UeberUnsInhalt from '../components/us/UeberUnsInhalt.astro';
import { absolute } from '../lib/paths';
import { UEBER_UNS as U } from '../config/unterseiten';
import '../styles/denkweise.css';
import '../styles/unterseiten.css';
---

<BaseLayout
  title={U.meta.title}
  description={U.meta.description}
  breadcrumb={[{ name: U.meta.crumb, path: '/ueber-uns/' }]}
  schema={[{
    '@context': 'https://schema.org',
    '@type': 'AboutPage',
    name: U.meta.pageName,
    url: absolute('/ueber-uns/', Astro.site),
    about: { '@id': `${absolute('/', Astro.site)}#organization` },
  }]}
>
  <UeberUnsInhalt U={U} lang="de" />
</BaseLayout>

<script>
  import '../scripts/denkweise';
</script>
