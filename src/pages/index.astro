---
// Startseite der Dachmarke Waybuild – Aufbau GENAU nach Jamils kompaktem Design- und Strukturbriefing (Talk 3636,
// 28.10.2026; hat Vorrang vor früheren Briefings). Texte wörtlich, wo das Briefing sie vorgibt.
// Leitidee: eine durchgehende Linie – vom Chaos über Klarheit und Vertrauen bis zum Ziel.
//   Hero (Hero.astro): Text + Weg-Illustration (graue Linie durch E-Mail … Freigabe, am Ende kurz türkis)
//   Schritt 1 · Vorher → Dann kommt Waybuild (Wandel.astro): Chaos-Karten, Situationen, die Linie wird geordnet
//   Schritt 2 · Verständnis · Selbstreflexion (Selbstcheck.astro)
//   Schritt 3 · Orientierung (drei Säulen + „So beginnt die Zusammenarbeit“, fünf Schritte) ·
//   Schritt 4 · Verlässlichkeit (Petrol; „Das dürfen Sie von uns erwarten“, Talk 3690) · Schritt 5 · Leichtigkeit ·
//   Schritt 6 · Produkte · Schritt 7 · Ziel + „Wer kümmert sich eigentlich?“ (FooterKontakt: Zielpunkt).
// 29.10.2026 (Jamil, Talk 3639–3654): eine durchgehende Linie ab dem Hero, Abschnitt „Einblicke“ und Verständnis-Bild
// entfernt, keine Abzweigungen zu Überschriften/Texten, Kästchen leuchten bei Berührung, Menschen in Schritt 6.
// Keine Preise, keine Telefonnummer, nichts erfunden.
// Frühere Fassungen: Git-Historie (bec9a95 Storytelling, ffa6292 davor).
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/story/Hero.astro';
import Wandel from '../components/story/Wandel.astro';
import Selbstcheck from '../components/story/Selbstcheck.astro';
import Icon from '../components/Icon.astro';
import { href } from '../lib/paths';
import Produkte from '../components/Produkte.astro';
import { START_ABLAUF, QUALITAETEN } from '../config/hauptseite';

// Schritt 4 · Verlässlichkeit und Schritt 5 · Leichtigkeit – Texte aus Jamils Brief (Talk 3690), knapp gehalten.
// „dokumentiert“ steht genau einmal in „Nichts geht verloren“ (Erwartungen), daher hier nicht doppelt.
const ZUFALL = ['Jede Aufgabe hat einen Verantwortlichen.', 'Jeder Schritt ist nachvollziehbar.', 'Wichtige Anliegen werden als solche behandelt.'];
const OHNE = ['kein Projektantrag', 'kein Formular', 'keine fünf Ansprechpartner', 'keine technische Fachsprache'];

---

<BaseLayout
  title="Wir machen Veränderungen einfach"
  description="Waybuild entwickelt digitale Produkte und Lösungen, die Veränderungen verständlich, verlässlich und einfach machen. Ein fester Ansprechpartner, klare Abläufe."
  rueckgrat
>
  <Hero />

  <!-- SCHRITT 1 · VORHER → DANN KOMMT WAYBUILD -->
  <Wandel />

  <!-- SCHRITT 2 · VERSTÄNDNIS + SELBSTREFLEXION -->
  <section class="kapitel kapitel--anschluss" id="unternehmen" aria-labelledby="weg-h">
    <div class="wrap">
      <div class="pfad">
        <div class="halt halt--l kopf">
          <span class="schritt-kenn">Schritt 2 · Verständnis</span>
          <h2 id="weg-h" class="plakat">Nicht die Technik macht Veränderungen schwer. <span class="accent">Sondern der Weg dorthin.</span></h2>
        </div>
        <div class="halt halt--r halt--text entstehung">
          <p class="lead">Waybuild ist aus einer einfachen Beobachtung entstanden: Kleine Veränderungen führen häufig zu vielen Nachrichten, unklaren Zuständigkeiten und langen Wartezeiten.</p>
          <p class="lead">Deshalb fragen wir zuerst: Was möchten Sie erreichen? Anschließend suchen wir den einfachsten und sinnvollsten Weg dorthin.</p>
        </div>
      </div>
      <Selbstcheck />
    </div>
  </section>

  <!-- SCHRITT 3 · ORIENTIERUNG: drei Säulen + „So beginnt die Zusammenarbeit“ (Jamil, Talk 3725) -->
  <section class="kapitel kapitel--weiss" id="haltung" aria-labelledby="haltung-h">
    <div class="wrap">
      <div class="pfad">
        <div class="halt halt--l kopf">
          <span class="schritt-kenn">Schritt 3 · Orientierung</span>
          <h2 id="haltung-h">Klarheit. Verlässlichkeit. <span class="accent">Einfachheit.</span></h2>
        </div>
        <p class="halt halt--r halt--text lead kopf__text">Darauf baut alles auf, was wir tun – vom ersten Gespräch an.</p>
        <h3 class="halt halt--voll halt--still ablauf__titel" id="ablauf-h">So beginnt die Zusammenarbeit</h3>
        <ol class="pfad ablauf" aria-labelledby="ablauf-h">
          {START_ABLAUF.map((a, i) => (
            <li class="halt halt--r k ablauf__schritt leuchtet">
              <span class="k__nr" aria-hidden="true">{i + 1}</span>
              <div class="k__inhalt">
                <h4 class="k__titel">{a.titel}</h4>
                <p>{a.text}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- SCHRITT 4 · VERLÄSSLICHKEIT (Petrol; Jamil, Talk 3690: „Nicht Vertrauen. Nicht Werte.“) -->
  <section class="kapitel kapitel--dunkel" id="verlaesslichkeit" aria-labelledby="verl-h">
    <div class="wrap">
      <div class="pfad">
        <div class="halt halt--l kopf">
          <span class="schritt-kenn">Schritt 4 · Verlässlichkeit</span>
          <h2 id="verl-h">So sorgen wir dafür, dass Dinge <span class="accent">nicht liegenbleiben.</span></h2>
        </div>
        <div class="halt halt--r halt--text schiefe">
          <p class="schiefe__frage">Was passiert, wenn etwas schiefläuft?</p>
          <p>Viele Unternehmen haben erlebt, dass Themen vergessen werden, Mitarbeiter wechseln und Wissen verloren geht. Deshalb haben wir dafür gesorgt, dass wir zuverlässig bleiben.</p>
        </div>
        <div class="halt halt--l k k--akzent zufall leuchtet">
          <span class="k__icon" aria-hidden="true"><Icon name="layers" size={24} /></span>
          <div class="k__inhalt">
            <p class="zufall__vor">Warum funktioniert die Zusammenarbeit mit Waybuild anders?</p>
            <h3>Wir verlassen uns nicht auf Zufall.</h3>
            <p>Wenn Sie uns schreiben, beginnt ein klarer Ablauf:</p>
            <ul class="zufall__liste">
              {ZUFALL.map((x) => <li><Icon name="check" size={16} /> {x}</li>)}
            </ul>
          </div>
        </div>
        <h3 class="halt halt--r halt--text erwarten">Das dürfen Sie von uns erwarten</h3>
        <ul class="pfad qual" aria-label="Das dürfen Sie von uns erwarten">
          {QUALITAETEN.map((q, i) => (
            <li class:list={['halt', i % 2 ? 'halt--r' : 'halt--l', 'k', 'qual__q', 'leuchtet']}>
              <span class="k__icon" aria-hidden="true"><Icon name={q.icon} size={24} /></span>
              <div class="k__inhalt">
                <h3>{q.titel}</h3>
                <p>{q.text}</p>
              </div>
            </li>
          ))}
        </ul>
        <p class="halt halt--r halt--still qual__mehr"><a class="pfeil-link" href={href('/zusagen/')}>Unsere Zusagen im Detail <Icon name="arrow" size={16} /></a></p>
      </div>
    </div>
  </section>

  <!-- SCHRITT 5 · LEICHTIGKEIT (Talk 3690: „Veränderung sollte sich nicht wie Arbeit anfühlen.“) -->
  <section class="kapitel" id="leichtigkeit" aria-labelledby="leicht-h">
    <div class="wrap">
      <div class="pfad">
        <div class="halt halt--l kopf">
          <span class="schritt-kenn">Schritt 5 · Leichtigkeit</span>
          <h2 id="leicht-h">Veränderung sollte sich nicht wie <span class="accent">Arbeit anfühlen.</span></h2>
        </div>
        <p class="halt halt--r halt--text lead kopf__text">Bei uns bekommen Sie vor allem eines: weniger Aufwand.</p>
        <div class="halt halt--l k k--flaeche leicht leuchtet">
          <div class="k__inhalt">
            <h3>Wenn Sie etwas ändern möchten:</h3>
            <ul class="leicht__nicht">
              {OHNE.map((x) => <li><span class="leicht__x" aria-hidden="true"><Icon name="close" size={16} /></span> {x}</li>)}
            </ul>
          </div>
        </div>
        <div class="halt halt--r k k--akzent leicht leicht--ja leuchtet">
          <span class="k__icon" aria-hidden="true"><Icon name="check" size={24} /></span>
          <div class="k__inhalt">
            <h3>Einfach sagen, was Sie verändern möchten.</h3>
            <p>Per Text, Screenshot, Video oder Sprachnachricht. Den Rest organisieren wir.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SCHRITT 5 · PRODUKTE -->
  <section class="kapitel kapitel--sand" id="produkte" aria-labelledby="produkte-h">
    <div class="wrap">
      <div class="pfad">
        <div class="halt halt--l kopf">
          <span class="schritt-kenn">Schritt 6 · Produkte</span>
          <h2 id="produkte-h">Eine Haltung. <span class="accent">Unterschiedliche Produkte.</span></h2>
        </div>
        <p class="halt halt--r halt--text lead kopf__text">Jedes Waybuild-Produkt löst ein konkretes Problem und besitzt einen eigenen Namen und Auftritt. Was alle Produkte verbindet, sind dieselben Werte, Zusagen und Arbeitsweisen.</p>
      </div>
      <Produkte />
    </div>
  </section>
  <!-- SCHRITT 7 · ZIEL + Menschen hinter Waybuild: FooterKontakt (Petrol, die Linie erreicht den Zielpunkt; Jamil, Talk 3653) -->
</BaseLayout>

<script>
  // Ersatz für Browser ohne CSS scroll-driven animations: Rückgrat wächst mit dem Scrollen, Punkte erscheinen.
  if (!CSS.supports('animation-timeline: view()') && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.documentElement.classList.add('zug-js');
    const kapitel = Array.from(document.querySelectorAll<HTMLElement>('.kapitel'));
    const halte = Array.from(document.querySelectorAll<HTMLElement>('.pfad .halt'));
    let laeuft = false;
    const zeichnen = () => {
      laeuft = false;
      const vh = window.innerHeight;
      kapitel.forEach((k) => {
        const r = k.getBoundingClientRect();
        const start = k.classList.contains('kapitel--anschluss') ? vh : vh * 0.6;
        const z = Math.min(1, Math.max(0, (start - r.top) / (r.height + start - vh * 0.6)));
        k.style.setProperty('--zug', z.toFixed(3));
      });
      halte.forEach((h) => { h.classList.toggle('halt--da', h.getBoundingClientRect().top < vh * 0.6); });
    };
    window.addEventListener('scroll', () => { if (!laeuft) { laeuft = true; requestAnimationFrame(zeichnen); } }, { passive: true });
    zeichnen();
  }
</script>

<style>
  /* Einheitlicher Rhythmus (Jamil, Talk 3641: „Abstände ins Verhältnis bringen“): Station = erste Zeile der Überschrift;
     Text rechts beginnt auf Höhe der Überschrift, Verbinder enden mit Abstand vor dem Text. */
  .kopf { --hy: 54px; }
  .kopf h2 { margin-bottom: 0; }
  .kopf .lead { margin-top: 20px; margin-bottom: 0; }
  .kopf__text { margin: 0; }
  .halt--text { --hy: 54px; align-self: start; }
  @media (min-width: 960px) { .halt--text { padding-top: 36px; } }
  /* Keine Abzweigungen zu Überschriften und Fließtexten (Jamil, Talk 3647–3649): nur Kästchen hängen an der Linie */
  .kopf::before, .kopf::after, .halt--text::before, .halt--text::after { display: none !important; }
  .kapitel--dunkel .lead { color: var(--dark-lead); }
  .kapitel--dunkel .pfeil-link { color: var(--accent-light); }
  .plakat { font-size: clamp(2.1rem, 3.9vw, 3.3rem) !important; line-height: 1.06; }

  /* Verständnis */
  .entstehung { display: grid; gap: 16px; align-content: start; }
  .entstehung .lead { margin: 0; }

  /* So beginnt die Zusammenarbeit: Handy senkrecht an der Linie, Desktop waagerecht (Abgrenzung zur Anfrage-Reise) */
  .ablauf__titel { --hy: 50%; margin: clamp(32px, 5vw, 56px) 0 0; font-size: clamp(1.2rem, 2.2vw, 1.5rem); color: var(--accent-ink); }
  .ablauf { list-style: none; margin: 0; padding-left: 0; row-gap: 14px; }
  .ablauf__schritt { --hy: 30px; align-self: stretch; }
  .ablauf__schritt .k__titel { font-size: 1.05rem; }
  @media (min-width: 960px) {
    .ablauf__titel { justify-self: center; text-align: center; background: var(--sec-bg); border: 3px solid var(--accent); border-radius: 999px; padding: 12px 28px; }
    .ablauf__titel::before, .ablauf__titel::after { display: none; }
    .ablauf { grid-column: 1 / -1; grid-template-columns: repeat(5, minmax(0, 1fr)); column-gap: 14px; position: relative; z-index: 1; margin-top: 8px; }
    /* waagerechter Fluss durch die Nummern statt Verbinder zur Mittellinie */
    .ablauf::before { content: ''; position: absolute; left: 10%; right: 10%; top: calc(var(--k-pad) + 15px); height: 3px; margin-top: -1.5px; background: var(--accent); }
    .ablauf__schritt { grid-column: auto !important; flex-direction: column; gap: 10px; }
    .ablauf__schritt::before, .ablauf__schritt::after { display: none; }
    .ablauf__schritt .k__nr { position: relative; z-index: 1; background: #d9efee; }
  }

  /* Vertrauen */
  .qual { list-style: none; margin: 0; padding: 0; row-gap: 18px; }
  .qual__q { --hy: 36px; }
  .qual__mehr { margin: 0; }
  @media (min-width: 960px) { .qual { grid-column: 1 / -1; } }

  /* Orientierung */

  /* Verlässlichkeit */
  .schiefe p { margin: 0 0 10px; color: var(--dark-lead); line-height: 1.6; }
  .schiefe__frage { font-family: var(--font-head); font-weight: 650; font-size: 1.2rem; color: var(--white) !important; }
  .zufall__liste, .leicht__nicht { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }
  .zufall { align-self: start; margin-top: clamp(16px, 3vw, 32px); }
  .zufall__vor { font-size: 0.82rem; font-weight: 700; letter-spacing: 0.06em; color: var(--accent-light) !important; margin-bottom: 6px !important; }
  .zufall .k__inhalt > p { margin-bottom: 10px; }
  .zufall__liste li { display: flex; gap: 8px; align-items: center; color: var(--dark-lead); }
  .zufall__liste :global(.icon) { color: var(--accent-light); flex: none; }
  .erwarten { margin: 0; align-self: end; font-size: clamp(1.3rem, 2.4vw, 1.7rem); }
  @media (min-width: 960px) { .erwarten { padding-top: 0 !important; } }
  .qual { margin-top: 8px; }

  /* Leichtigkeit */
  .leicht { align-self: start; margin-top: clamp(16px, 3vw, 32px); }
  .leicht__nicht li { display: flex; gap: 10px; align-items: center; color: var(--ink-soft); text-decoration: line-through; text-decoration-color: rgb(84 84 84 / 45%); }
  .leicht__x { display: grid; place-items: center; width: 24px; height: 24px; border-radius: 50%; background: rgb(84 84 84 / 8%); color: #6f6a60; flex: none; }
  .leicht h3 { margin-bottom: 10px; }

  /* Produkte */
  .kapitel--sand .pfad + :global(.pweg) { margin-top: clamp(48px, 6vw, 80px); }
</style>
