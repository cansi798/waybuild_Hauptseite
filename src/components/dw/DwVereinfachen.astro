---
// Szene „Vereinfachen“: Der verschlungene Weg löst sich auf, eine ruhige gerade Linie bleibt. Daneben erscheinen
// Weniger Aufwand, Mehr Klarheit, Schnellere Entscheidungen, Mehr Fortschritt.
import { DW_VEREINFACHEN as T } from '../../config/denkweise';
const W = 440, H = 440, X = 150;
const KNOTEN = 'M 150 0 C 262 48, 38 92, 150 140 C 252 182, 58 236, 132 204 C 206 172, 252 298, 150 310 C 48 322, 232 390, 150 440';
const n = T.nutzen.map((t, k) => ({ t, k, y: 20 + k * 20 }));
---
<div class="dw-bild" data-szene style={`aspect-ratio: ${W} / ${H}`}>
  <svg viewBox={`0 0 ${W} ${H}`} aria-hidden="true" focusable="false">
    <path class="dw-s" pathLength="1" d={KNOTEN} data-an="zeichnen:0-0.3 aus:0.42-0.62:0" />
    <path class="dw-s" pathLength="1" d={`M ${X} 0 L ${X} ${H}`} data-an="zeichnen:0.4-0.62" />
  </svg>
  <span class="dw-anker" style={`left:${(X / W) * 100}%;top:0%`} data-weg="ein"></span>
  <span class="dw-anker" style={`left:${(X / W) * 100}%;top:100%`} data-weg="aus"></span>
  {n.map((x) => (
    <>
      <span class="dw-pos" style={`left:${(X / W) * 100}%;top:${x.y}%`}><span class="dw-punkt" data-an={`erscheinen:${(0.6 + x.k * 0.08).toFixed(2)}-${(0.68 + x.k * 0.08).toFixed(2)}`}></span></span>
      <span class="dw-pos dw-pos--rechts" style={`left:calc(${(X / W) * 100}% + 22px);top:${x.y}%`}>
        <span class="dw-wort" data-an={`auf:${(0.62 + x.k * 0.08).toFixed(2)}-${(0.72 + x.k * 0.08).toFixed(2)}`}>{x.t}</span>
      </span>
    </>
  ))}
</div>
