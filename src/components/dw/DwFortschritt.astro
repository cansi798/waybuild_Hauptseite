---
// Finale: Die Linie läuft mittig auf den Kreis zu, teilt sich am oberen Scheitel, beide Äste bilden den Kreis und
// treffen sich unten in der Mitte (Jamil, Talk 3920); von dort läuft die Linie mittig weiter und blendet aus (der Weg
// geht weiter). Der Kreis füllt sich, darin „Fortschritt“.
// Danach färbt sich die ganze Linie leicht türkis (Klasse dw--fertig am Wurzel-Element, gesetzt vom Skript).
import { DW_ABSCHLUSS as T } from '../../config/denkweise';
const W = 260, H = 260, CX = 130, CY = 140, R = 96;
// Spitze erreicht den oberen Scheitel bei p = (CY - R) / H / 0.85 ≈ 0.2
const TEIL = 0.2, ZU = 0.5;
---
<div class="dw-bild dw-bild--klein" data-szene data-szene-ende style={`aspect-ratio: ${W} / ${H}`}>
  <svg viewBox={`0 0 ${W} ${H}`} aria-hidden="true" focusable="false">
    <defs>
      <linearGradient id="dw-weiter" gradientUnits="userSpaceOnUse" x1="0" y1={CY + R} x2="0" y2={CY + R + 54}>
        <stop offset="0" style="stop-color: var(--weg)" />
        <stop offset="1" style="stop-color: var(--weg); stop-opacity: 0" />
      </linearGradient>
    </defs>
    <circle class="dw-fuell" cx={CX} cy={CY} r={R - 4} data-an="wachsen:0.5-0.76" />
    <path class="dw-s dw-s--stark" pathLength="1" d={`M ${CX} ${CY - R} A ${R} ${R} 0 0 0 ${CX} ${CY + R}`} data-an={`linear:${TEIL}-${ZU}`} />
    <path class="dw-s dw-s--stark" pathLength="1" d={`M ${CX} ${CY - R} A ${R} ${R} 0 0 1 ${CX} ${CY + R}`} data-an={`linear:${TEIL}-${ZU}`} />
    <path class="dw-s dw-s--stark dw-s--weiter" pathLength="1" d={`M ${CX} ${CY + R} L ${CX} ${CY + R + 54}`} data-an={`zeichnen:${ZU}-${(ZU + 0.2).toFixed(2)}`} />
    <circle class="dw-knoten" cx={CX} cy={CY - R} r="6" data-an={`erscheinen:${(TEIL - 0.02).toFixed(2)}-${(TEIL + 0.04).toFixed(2)}`} />
    <circle class="dw-knoten" cx={CX} cy={CY + R} r="6" data-an={`erscheinen:${(ZU - 0.03).toFixed(2)}-${(ZU + 0.03).toFixed(2)}`} />
  </svg>
  <span class="dw-anker" style={`left:50%;top:${(((CY - R) / H) * 100).toFixed(2)}%`} data-weg="ein"></span>
  <span class="dw-pos" style={`left:50%;top:${((CY / H) * 100).toFixed(2)}%`}>
    <span class="dw-mitte dw-mitte--gross" data-an="auf:0.66-0.84">{T.kreis}</span>
  </span>
</div>
