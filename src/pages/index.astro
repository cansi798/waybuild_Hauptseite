---
// Startseite „Denkweise“ nach Jamils neuem Konzept (Talk 3798/3799, 30.10.2026) – ab jetzt maßgeblich.
// Die Linie zeigt keinen Projektablauf und keinen Website-Prozess, sondern die Waybuild-Denkweise:
// Idee → Verstehen → Hinterfragen → Vereinfachen → Umsetzen → Verbessern. Produkte sind mögliche Ergebnisse.
// Danach Verlässlichkeit (sechs Pfeiler docken an), die drei Prinzipien AUF der Linie und der Abschluss mit dem
// Kreis „Fortschritt“; dann wird die ganze Linie türkis. Eine einzige SVG-Linie über die ganze Geschichte
// (src/scripts/denkweise.ts), Bildszenen in src/components/dw/.
// Vorherige Fassung (Anfrage-Reise, Selbstcheck, Zusammenarbeit): Git-Tag startseite-v3-anfragereise-20261030;
// die Komponenten liegen weiter in src/components/story/ (Jamil-Frage c, Talk 3800: bleiben sie?).
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import DwIdee from '../components/dw/DwIdee.astro';
import DwVerstehen from '../components/dw/DwVerstehen.astro';
import DwHinterfragen from '../components/dw/DwHinterfragen.astro';
import DwVereinfachen from '../components/dw/DwVereinfachen.astro';
import DwUmsetzen from '../components/dw/DwUmsetzen.astro';
import DwVerbessern from '../components/dw/DwVerbessern.astro';
import DwFortschritt from '../components/dw/DwFortschritt.astro';
import { href } from '../lib/paths';
import {
  DW_HERO, DW_REISE, DW_IDEE, DW_VERSTEHEN, DW_HINTERFRAGEN, DW_VEREINFACHEN, DW_UMSETZEN, DW_VERBESSERN,
  DW_VERLAESSLICH, DW_PRINZIPIEN, DW_ABSCHLUSS,
} from '../config/denkweise';
import '../styles/denkweise.css';

const K = DW_UMSETZEN.karte;
// Handy-Wegpunkte: links neben jedem Textblock (die Linie läuft am Rand, Texte sind eingerückt)
---

<BaseLayout
  title="Website-Service und digitale Produkte"
  description="Waybuild hilft Unternehmen, Veränderungen zu verstehen, sinnvoll zu gestalten und zuverlässig umzusetzen. Mit festem Ansprechpartner und klaren Zusagen."
  hideFooterKontakt
>
  <div class="dw" data-denkweise>
    <svg class="dw-linie" aria-hidden="true" focusable="false"><path class="dw-strich" d="" /></svg>

    <!-- 1 · HERO -->
    <section class="dw-abschnitt dw-hero" aria-labelledby="dw-h1">
      <div class="wrap dw-raster dw-raster--hero">
        <div class="dw-hero__text">
          <h1 id="dw-h1">Wir machen Veränderungen <span class="accent">einfach.</span></h1>
          <p class="dw-hero__lead">{DW_HERO.lead}</p>
          <a class="btn btn--primary btn--lg" href={href('/kontakt/')}>{DW_HERO.cta} <Icon name="arrow" size={18} /></a>
        </div>
        <div class="dw-start" data-szene>
          <span class="dw-idee"><span class="dw-idee__kreis" data-weg="start"><Icon name="idee" size={24} /></span><span class="dw-idee__wort">Idee</span></span>
          <ol class="dw-reise" aria-label="Die Waybuild-Denkweise">
            {DW_REISE.map((r, i) => (
              <li style={`--dx:${[-34, 30, -26, 34, -18][i]}px`}>
                <span class="dw-punkt" data-weg {...(i === DW_REISE.length - 1 ? { 'data-intro-ende': '' } : {})} data-an="erscheinen:auto"></span>
                <span class="dw-wort" data-an="auf:auto">{r.wort}</span>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    <!-- 2 · IDEE -->
    <section class="dw-abschnitt" id="denkweise" aria-labelledby="dw-idee-h">
      <div class="wrap dw-raster dw-raster--spiegel">
        <div class="dw-text reveal">
          <span class="dw-wp" data-weg data-weg-nur="m" data-weg-x="links"></span>
          <span class="dw-kenn"><Icon name="idee" size={18} /> Idee</span>
          <h2 id="dw-idee-h">{DW_IDEE.titel}</h2>
          <p class="dw-zeilen">{DW_IDEE.zeilen.map((z) => <span>{z}</span>)}</p>
          <p>{DW_IDEE.gefuehl}</p>
          <blockquote class="dw-zitat">{DW_IDEE.zitat}</blockquote>
          <p>{DW_IDEE.schluss}</p>
          <span class="dw-wp" data-weg data-weg-nur="m" data-weg-x="links"></span>
        </div>
        <DwIdee />
      </div>
    </section>

    <!-- 3 · VERSTEHEN -->
    <section class="dw-abschnitt" id="verstehen" aria-labelledby="dw-verstehen-h">
      <div class="wrap dw-raster">
        <div class="dw-text reveal">
          <span class="dw-wp" data-weg data-weg-nur="m" data-weg-x="links"></span>
          <span class="dw-kenn"><Icon name="search" size={18} /> Verstehen</span>
          <h2 id="dw-verstehen-h">{DW_VERSTEHEN.titel}</h2>
          <p>{DW_VERSTEHEN.einleitung}</p>
          <ul class="dw-liste">{DW_VERSTEHEN.punkte.map((p) => <li>{p}</li>)}</ul>
          <p>{DW_VERSTEHEN.schluss}</p>
          <span class="dw-wp" data-weg data-weg-nur="m" data-weg-x="links"></span>
        </div>
        <DwVerstehen />
      </div>
    </section>

    <!-- 4 · HINTERFRAGEN (wichtigste Animation, breit) -->
    <section class="dw-abschnitt" id="hinterfragen" aria-labelledby="dw-hinterfragen-h">
      <div class="wrap">
        <div class="dw-text dw-text--oben reveal">
          <span class="dw-wp" data-weg data-weg-nur="m" data-weg-x="links"></span>
          <span class="dw-wp" data-weg data-weg-nur="d" data-weg-x="rechts"></span>
          <span class="dw-kenn"><Icon name="frage" size={18} /> Hinterfragen</span>
          <h2 id="dw-hinterfragen-h">{DW_HINTERFRAGEN.titel}</h2>
          <p class="dw-zeilen">{DW_HINTERFRAGEN.zeilen.map((z) => <span>{z}</span>)}</p>
          <p>{DW_HINTERFRAGEN.schluss}</p>
          <span class="dw-wp" data-weg data-weg-nur="m" data-weg-x="links"></span>
          <span class="dw-wp" data-weg data-weg-nur="d" data-weg-x="rechts"></span>
        </div>
        <DwHinterfragen />
      </div>
    </section>

    <!-- 5 · VEREINFACHEN -->
    <section class="dw-abschnitt" id="vereinfachen" aria-labelledby="dw-vereinfachen-h">
      <div class="wrap dw-raster dw-raster--spiegel">
        <div class="dw-text reveal">
          <span class="dw-wp" data-weg data-weg-nur="m" data-weg-x="links"></span>
          <span class="dw-kenn"><Icon name="spark" size={18} /> Vereinfachen</span>
          <h2 id="dw-vereinfachen-h">{DW_VEREINFACHEN.titel}</h2>
          <p class="dw-zeilen">{DW_VEREINFACHEN.zeilen.map((z) => <span>{z}</span>)}</p>
          <p class="dw-zeilen dw-zeilen--betont">{DW_VEREINFACHEN.ziel.map((z) => <span>{z}</span>)}</p>
          <span class="dw-wp" data-weg data-weg-nur="m" data-weg-x="links"></span>
        </div>
        <DwVereinfachen />
      </div>
    </section>

    <!-- 6 · UMSETZEN -->
    <section class="dw-abschnitt" id="umsetzen" aria-labelledby="dw-umsetzen-h">
      <div class="wrap dw-raster dw-raster--umsetzen">
        <div class="dw-text reveal">
          <span class="dw-wp" data-weg data-weg-nur="m" data-weg-x="links"></span>
          <span class="dw-kenn"><Icon name="rocket" size={18} /> Umsetzen</span>
          <h2 id="dw-umsetzen-h">{DW_UMSETZEN.titel}</h2>
          <p class="dw-zeilen">{DW_UMSETZEN.zeilen.map((z) => <span>{z}</span>)}</p>
          <span class="dw-wp" data-weg data-weg-nur="m" data-weg-x="links"></span>
        </div>
        <div class="dw-umsetzen__bild"><DwUmsetzen /></div>
        <div class="dw-karte-wrap reveal">
          <span class="dw-wp" data-weg data-weg-nur="m" data-weg-x="links"></span>
          <article class="k k--akzent dw-karte" aria-labelledby="dw-karte-h">
            <span class="k__icon"><Icon name="layout" size={22} /></span>
            <div class="k__inhalt">
              <p class="dw-karte__kenn">{K.kenn}</p>
              <h3 id="dw-karte-h">{K.titel}</h3>
              <p>{K.text}</p>
              <ul class="dw-haken">{K.punkte.map((p) => <li><Icon name="check" size={16} /> {p}</li>)}</ul>
              <p class="dw-karte__preis">{K.preis}</p>
              <a class="btn btn--primary" href={href('/angebot/')}>{K.cta} <Icon name="arrow" size={18} /></a>
            </div>
          </article>
          <span class="dw-wp" data-weg data-weg-nur="m" data-weg-x="links"></span>
          <span class="dw-wp dw-wp--karte" data-weg data-weg-nur="d" data-weg-x="rechts"></span>
        </div>
      </div>
    </section>

    <!-- 7 · VERBESSERN -->
    <section class="dw-abschnitt" id="verbessern" aria-labelledby="dw-verbessern-h">
      <div class="wrap dw-raster dw-raster--spiegel">
        <div class="dw-text reveal">
          <span class="dw-wp" data-weg data-weg-nur="m" data-weg-x="links"></span>
          <span class="dw-kenn"><Icon name="chart" size={18} /> Verbessern</span>
          <h2 id="dw-verbessern-h">{DW_VERBESSERN.titel}</h2>
          <p class="dw-zeilen">{DW_VERBESSERN.zeilen.map((z) => <span>{z}</span>)}</p>
          <span class="dw-wp" data-weg data-weg-nur="m" data-weg-x="links"></span>
        </div>
        <DwVerbessern />
      </div>
    </section>

    <!-- 8 · VERLÄSSLICHKEIT: sechs Pfeiler docken an die Linie an, die Linie wird stabiler -->
    <section class="dw-abschnitt" id="verlaesslichkeit" aria-labelledby="dw-verlaesslich-h">
      <div class="wrap">
        <div class="dw-text dw-text--oben reveal">
          <span class="dw-wp" data-weg data-weg-nur="m" data-weg-x="links"></span>
          <span class="dw-wp" data-weg data-weg-nur="d" data-weg-x="rechts"></span>
          <span class="dw-kenn"><Icon name="shield" size={18} /> Verlässlichkeit</span>
          <h2 id="dw-verlaesslich-h">{DW_VERLAESSLICH.titel}</h2>
          <p>{DW_VERLAESSLICH.text}</p>
          <span class="dw-wp" data-weg data-weg-nur="m" data-weg-x="links"></span>
          <span class="dw-wp" data-weg data-weg-nur="d" data-weg-x="rechts"></span>
        </div>
        <div class="dw-pfeiler" data-szene>
          <span class="dw-saeule" data-an="hoch:0-0.96"></span>
          <span class="dw-anker dw-anker--saeule" style="top:0" data-weg="ein"></span>
          <span class="dw-anker dw-anker--saeule" style="top:100%" data-weg="aus"></span>
          <ul class="dw-pfeiler__liste">
            {DW_VERLAESSLICH.pfeiler.map((p, i) => (
              <li class:list={['dw-pfeiler__item', i % 2 ? 'dw-pfeiler__item--r' : 'dw-pfeiler__item--l']}>
                <span class="dw-steg" data-an="breit:auto"></span>
                <div class="k dw-pfeiler__karte" data-an={`${i % 2 ? 'rechts' : 'links'}:auto`}>
                  <span class="k__icon"><Icon name={p.icon} size={22} /></span>
                  <div class="k__inhalt">
                    <h3>{p.titel}</h3>
                    <p>{p.text}</p>
                    {p.zusatz && <p class="dw-pfeiler__zusatz">{p.zusatz}</p>}
                  </div>
                </div>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- 9 · DIE DREI PRINZIPIEN: direkt auf der Linie -->
    <section class="dw-abschnitt dw-prinzipien" aria-labelledby="dw-prinzipien-h">
      <div class="wrap">
        <h2 id="dw-prinzipien-h" class="dw-prinzipien__titel">
          <span class="dw-wp" data-weg data-weg-nur="m" data-weg-x="links"></span>
          {DW_PRINZIPIEN.titel}
        </h2>
        <ol class="dw-prinzipien__liste" data-szene>
          {DW_PRINZIPIEN.liste.map((p) => (
            <li class="dw-prinzip">
              <span class="dw-prinzip__wort" data-an="blende:auto"><span class="dw-prinzip__punkt" data-weg></span>{p.wort}</span>
              <span class="dw-prinzip__text" data-an="auf:auto">{p.text}</span>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- 10 · ABSCHLUSS -->
    <section class="dw-abschnitt dw-abschluss" id="kontakt-start" aria-labelledby="dw-abschluss-h">
      <div class="wrap dw-raster">
        <div class="dw-text reveal">
          <span class="dw-wp" data-weg data-weg-nur="m" data-weg-x="links"></span>
          <h2 id="dw-abschluss-h">{DW_ABSCHLUSS.titel}</h2>
          <p class="dw-zeilen">{DW_ABSCHLUSS.zeilen.map((z) => <span>{z}</span>)}</p>
          <p class="dw-einladung">{DW_ABSCHLUSS.einladung}</p>
          <a class="btn btn--primary btn--lg" href={href('/kontakt/')}>{DW_ABSCHLUSS.cta} <Icon name="arrow" size={18} /></a>
          <ul class="dw-vertrauen">{DW_ABSCHLUSS.vertrauen.map((v) => <li><Icon name="check" size={16} /> {v}</li>)}</ul>
          <span class="dw-wp" data-weg data-weg-nur="m" data-weg-x="links"></span>
        </div>
        <DwFortschritt />
      </div>
      <p class="dw-slogan">{DW_ABSCHLUSS.slogan}</p>
    </section>
  </div>
</BaseLayout>

<script>
  import '../scripts/denkweise';
</script>
