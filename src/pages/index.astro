---
// Startseite der Dachmarke Waybuild – NEUAUFBAU als Scroll-Geschichte (Jamil, Sprachnachricht Talk 3632, 28.10.2026:
// „Diese Linie soll den Weg mit Waybuild darstellen. Vorher Chaos und dann kommt langsam die Ordnung mit Waybuild.
// Gerade Prozesse.“; Design-System Talk 3622: „Die Linie erzählt die komplette Geschichte von Waybuild.“).
//
// Die Linie ist das Rückgrat der Seite, nicht Randverzierung:
//   START (Start.astro): Versprechen + Arbeitsfläche voller Chaos (Zettel, verknotete Linie). Beim Scrollen entwirrt
//          sich die Linie, wird türkis, die Zettel sortieren sich in vier klare Schritte an der geraden Linie.
//   Danach läuft die gerade Linie mittig (Handy: links) durch die Kapitel; die Inhalte hängen an ihr:
//   2 Verständnis → 3 Orientierung (Haltung) → 4 Vertrauen (Qualitäten) → 5 Produkte (alle an der Marke) → 6 Ziel
//   (FooterKontakt: die Linie endet im Zielpunkt, „Was möchten Sie verändern?“).
// Ohne JS / bei reduzierter Bewegung: statischer Endzustand (Chaos oben als Bild, Ordnung darunter), alles lesbar.
// Inhalte und Entscheidungen aus Jamils/Cans früheren Runden bleiben (Zielgruppe, digital, Haltung, Qualitäten,
// Nachdenk-Fragen, Produkte alle verfügbar, keine Preise, keine Telefonnummer). Frühere Fassung: Git-Historie (ffa6292).
import BaseLayout from '../layouts/BaseLayout.astro';
import Start from '../components/story/Start.astro';
import SkizzeWhiteboard from '../components/SkizzeWhiteboard.astro';
import Icon from '../components/Icon.astro';
import { href } from '../lib/paths';
import Produkte from '../components/Produkte.astro';
import HaltungBild from '../components/HaltungBild.astro';
import { HALTUNG, QUALITAETEN } from '../config/hauptseite';

// Nachdenk-Fragen – Strategiebriefing Talk 3401
const FRAGEN = [
  'Wie einfach lassen sich Änderungen bei Ihnen heute umsetzen?',
  'Wie schnell kommen Ideen tatsächlich in die Umsetzung?',
  'Wie abhängig ist Ihr Unternehmen von einzelnen Personen?',
  'Wie transparent sind Ihre Dienstleister?',
  'Wie viel Aufwand entsteht bei kleinen Veränderungen?',
];
---

<BaseLayout
  title="Wir machen Veränderungen einfach"
  description="Waybuild macht digitale Veränderungen für Unternehmen einfach – verständlich, verlässlich und ohne Fachchinesisch. Mit festem Ansprechpartner, klaren Abläufen."
  rueckgrat
>
  <!-- SCHRITT 1 – CHAOS → ORDNUNG (die Linie entwirrt sich) -->
  <Start />

  <!-- SCHRITT 2 – VERSTÄNDNIS: Waybuild versteht das Problem -->
  <section class="kapitel kapitel--anschluss" id="verstaendnis" aria-labelledby="weg-h">
    <div class="wrap">
      <div class="pfad">
        <div class="halt halt--l kopf">
          <span class="schritt-kenn">Schritt 2 · Verständnis</span>
          <h2 id="weg-h" class="plakat">Nicht die Technik macht Veränderungen schwer. <span class="accent">Sondern der Weg dorthin.</span></h2>
        </div>
        <div class="halt halt--r entstehung">
          <p class="lead">Waybuild ist aus Frust entstanden: Eine einfache Veränderung bedeutete viele Nachrichten, Missverständnisse und Warten. Deshalb fragen wir zuerst: Was möchten Sie erreichen? Und machen den Weg dorthin kurz und einfach.</p>
          <SkizzeWhiteboard />
        </div>
      </div>

      <div class="pfad fragen">
        <h3 class="halt halt--voll fragen__marke">Wie leicht ist Veränderung bei Ihnen heute?</h3>
        <ol class="pfad pfad--zickzack fragen__liste">
          {FRAGEN.map((f, i) => (
            <li class:list={['halt', i % 2 ? 'halt--r' : 'halt--l', 'frage']} style={`--zeile:${i + 1}`}>{f}</li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- SCHRITT 3 – ORIENTIERUNG: es gibt einen klaren Weg (unsere Haltung) -->
  <section class="kapitel kapitel--weiss" id="haltung" aria-labelledby="haltung-h">
    <div class="wrap">
      <div class="pfad pfad--zickzack">
        <div class="halt halt--l kopf" style="--zeile:1">
          <span class="schritt-kenn">Schritt 3 · Orientierung</span>
          <h2 id="haltung-h">Es gibt <span class="accent">einen klaren Weg.</span></h2>
          <p class="lead">Vier Sätze, nach denen wir arbeiten – bei allem, was wir tun.</p>
        </div>
        {HALTUNG.map((h, i) => (
          <div class:list={['halt', i % 2 ? 'halt--l' : 'halt--r', 'karte', 'haltung']} style={`--zeile:${i + 2}`}>
            <span class="haltung__icon"><HaltungBild art={h.bild} /></span>
            <div>
              <h3>{h.titel}</h3>
              <p>{h.text}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- SCHRITT 4 – VERTRAUEN: so arbeiten wir (Qualitäten) -->
  <section class="kapitel kapitel--dunkel" id="qualitaeten" aria-labelledby="qual-h">
    <div class="wrap">
      <div class="pfad">
        <div class="halt halt--l kopf">
          <span class="schritt-kenn">Schritt 4 · Vertrauen</span>
          <h2 id="qual-h">Weil Zusammenarbeit <span class="accent">leicht sein darf.</span></h2>
        </div>
        <p class="halt halt--r halt--still lead kopf__text">Fast jede digitale Veränderung braucht Klarheit, Struktur und einen verlässlichen Partner. Ihre Leichtigkeit in der Zusammenarbeit ist unser Maßstab.</p>
        <ul class="pfad qual">
          {QUALITAETEN.map((q, i) => (
            <li class:list={['halt', i % 2 ? 'halt--r' : 'halt--l', 'qual__q']}>
              <span class="qual__icon" aria-hidden="true"><Icon name={q.icon} size={34} /></span>
              <div>
                <h3>{q.titel}</h3>
                <p>{q.text}</p>
              </div>
            </li>
          ))}
        </ul>
        <p class="halt halt--r halt--still qual__mehr"><a class="pfeil-link" href={href('/zusagen/')}>Unsere Zusagen im Detail <Icon name="arrow" size={16} /></a></p>
      </div>
    </div>
  </section>

  <!-- SCHRITT 5 – PRODUKTE: so setzen wir den Weg um, alle mit der Marke verbunden -->
  <section class="kapitel kapitel--sand" id="produkte" aria-labelledby="produkte-h">
    <div class="wrap">
      <div class="pfad">
        <div class="halt halt--l kopf">
          <span class="schritt-kenn">Schritt 5 · Produkte</span>
          <h2 id="produkte-h">Jetzt starten wir. <span class="accent">Und das ist erst der Anfang.</span></h2>
        </div>
        <p class="halt halt--r halt--still lead kopf__text">Jedes unserer Produkte trägt einen eigenen Namen und hat einen eigenen Auftritt. Was sie verbindet, sind dieselben Werte und dieselben Zusagen.</p>
      </div>
      <Produkte />
    </div>
  </section>
  <!-- SCHRITT 6 – ZIEL: Kontakt (FooterKontakt, die Linie endet im Zielpunkt) -->
</BaseLayout>

<script>
  // Ersatz für Browser ohne CSS scroll-driven animations: Rückgrat wächst mit dem Scrollen, Punkte erscheinen.
  if (!CSS.supports('animation-timeline: view()') && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.documentElement.classList.add('zug-js');
    const kapitel = Array.from(document.querySelectorAll<HTMLElement>('.kapitel'));
    const halte = Array.from(document.querySelectorAll<HTMLElement>('.pfad .halt'));
    let laeuft = false;
    const zeichnen = () => {
      laeuft = false;
      const vh = window.innerHeight;
      kapitel.forEach((k) => {
        const r = k.getBoundingClientRect();
        const start = k.classList.contains('kapitel--anschluss') ? vh : vh * 0.6;
        const z = Math.min(1, Math.max(0, (start - r.top) / (r.height + start - vh * 0.6)));
        k.style.setProperty('--zug', z.toFixed(3));
      });
      halte.forEach((h) => { if (h.getBoundingClientRect().top < vh * 0.7) h.classList.add('halt--da'); });
    };
    window.addEventListener('scroll', () => { if (!laeuft) { laeuft = true; requestAnimationFrame(zeichnen); } }, { passive: true });
    zeichnen();
  }
</script>

<style>
  /* Kapitel-Köpfe */
  .kopf { --hy: 10px; }
  .kopf__text { margin: 0; align-self: end; }
  .kapitel--dunkel .pfeil-link { color: var(--accent-light); }
  .kopf h2 { margin-bottom: 0; }
  .kopf .lead { margin-top: 18px; margin-bottom: 0; }
  .kapitel--dunkel .lead { color: var(--dark-lead); }
  .plakat { font-size: clamp(2.1rem, 3.9vw, 3.3rem) !important; line-height: 1.06; }

  /* Verständnis */
  .entstehung { --hy: 10px; display: grid; gap: 24px; padding-top: 0; }
  @media (min-width: 960px) { .entstehung .lead { margin-top: -6px !important; } }
  .entstehung .lead { margin: 0; }
  .entstehung :global(.skizze) { max-width: 420px; margin: 0; }
  .fragen { margin-top: clamp(56px, 8vw, 96px); row-gap: 20px; }
  .fragen__marke { --hy: 50%; margin: 0; font-size: clamp(1.15rem, 2vw, 1.35rem); color: var(--accent-ink); }
  @media (min-width: 960px) {
    .fragen__marke { justify-self: center; text-align: center; background: var(--sec-bg); border: 3px solid var(--accent); border-radius: 999px; padding: 12px 26px; }
    .fragen__marke::before, .fragen__marke::after { display: none; }
  }
  .fragen__liste { list-style: none; margin: 0; padding: 0; row-gap: 0; }
  @media (min-width: 960px) { .fragen__liste { grid-column: 1 / -1; } }
  .frage { --hy: 50%; align-self: start; margin: 0 0 12px; padding: 14px 18px; background: var(--white); border: 1px solid var(--line); border-radius: 14px; font-family: var(--font-head); font-weight: 600; font-size: 1.04rem; line-height: 1.4; }
  @media (min-width: 960px) { .frage { margin: 0 0 18px; } .frage.halt--l { text-align: right; } }

  /* Karten an der Linie (Haltung) */
  .karte { --hy: 40px; align-self: start; display: flex; gap: 16px; align-items: flex-start; padding: 22px 22px 20px; background: var(--paper); border: 1px solid var(--line); border-radius: 18px; margin-bottom: 14px; }
  .karte h3 { margin: 4px 0 6px; font-size: clamp(1.12rem, 1.8vw, 1.28rem); line-height: 1.25; }
  .karte p { margin: 0; color: var(--ink-soft); line-height: 1.6; }
  .haltung__icon { flex: none; display: block; width: 56px; height: 56px; }
  .haltung__icon :global(.hbild) { width: 56px; height: 56px; }
  .kapitel--weiss .kopf { padding-bottom: 20px; }

  /* Vertrauen */
  .qual { list-style: none; margin: 0; padding: 0; row-gap: 18px; }
  .qual__q { --hy: 30px; display: flex; gap: 16px; align-items: flex-start; padding: 20px 20px 18px; border: 1px solid var(--dark-line); border-radius: 18px; }
  .qual__icon { flex: none; color: var(--accent-light); margin-top: 2px; }
  .qual__q h3 { margin: 0 0 6px; font-size: 1.18rem; line-height: 1.25; }
  .qual__q p { margin: 0; color: var(--dark-lead); line-height: 1.55; }
  .qual__mehr { margin: 0; }
  @media (min-width: 960px) { .qual { grid-column: 1 / -1; } }

  /* Produkte */
  .kapitel--sand .pfad + :global(.pweg) { margin-top: clamp(32px, 5vw, 56px); }
</style>
