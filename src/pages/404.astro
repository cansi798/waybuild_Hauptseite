---
import BaseLayout from '../layouts/BaseLayout.astro';
import { href } from '../lib/paths';
---

<BaseLayout title="Seite nicht gefunden" description="Diese Seite gibt es nicht (mehr). Unsere neue Website entsteht gerade." noindex>
  <section class="wrap nf">
    <h1>Diese Seite gibt es nicht (mehr).</h1>
    <p>Hier entsteht gerade unsere neue Website. Auf der Startseite finden Sie, was Sie bald erwartet, und wie Sie uns erreichen.</p>
    <a class="btn" href={href('/')}>Zur Startseite</a>
  </section>
</BaseLayout>
