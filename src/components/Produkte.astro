---
// Produkte an der geraden Linie (Jamils kompaktes Design-Briefing, Talk 3636): Die Linie verzweigt sich von Waybuild zu
// den einzelnen Produkten – Waybuild ist die Dachmarke, die Produkte sind eigenständige Ergebnisse derselben Haltung.
// Jede Karte: Status, Produktname, Kundennutzen, kurze Erklärung, Link zur eigenen Produktseite (falls vorhanden).
// Kein „Erstgespräch anfragen“ auf jeder Karte (Talk 3636). Keine Platzhalter-Marken auf den Karten; offene Namen,
// Nutzen-Texte und Produktseiten stehen in der Launch-Checkliste. Kommende Produkte als Satz statt interner Kategorien.
import Icon from './Icon.astro';
import { href } from '../lib/paths';
import { PRODUKTE, produktName } from '../config/hauptseite';

const produkte = PRODUKTE.filter((p) => p.art === 'produkt' && p.aktiv);
const [haupt, ...weitere] = produkte;
const ziel = (p: (typeof PRODUKTE)[number]) => (p.url ? { href: p.url, extern: true } : p.pfad ? { href: href(p.pfad), extern: false } : null);
---

<div class="pfad pweg">
  <div class="halt halt--voll halt--still marke">
    <span class="marke__knoten" aria-hidden="true"><span></span></span>
    <p><strong>Waybuild</strong>Dieselben Werte, Zusagen und Arbeitsweisen für jedes Produkt.</p>
  </div>

  {[haupt, ...weitere].filter(Boolean).map((p, i) => {
    const z = ziel(p);
    return (
      <article class:list={['halt', i === 0 ? 'halt--l' : 'halt--r', 'produkt', { 'produkt--gross': i === 0 }]} style={i === 0 ? '--zeile: 2 / span 3' : `--zeile: ${i + 1}`}>
        <div class="produkt__kopf">
          <span class="produkt__icon" aria-hidden="true"><Icon name={p.icon} size={i === 0 ? 30 : 26} /></span>
          <div>
            <span class="produkt__status">Verfügbar</span>
            <h3>{produktName(p)}</h3>
          </div>
        </div>
        {(p.nutzen ?? p.zweck) && <p class="produkt__nutzen">{p.nutzen ?? p.zweck}</p>}
        {p.erklaerung && <p class="produkt__erkl">{p.erklaerung}</p>}
        {z ? (
          <a class="btn btn--primary" href={z.href} {...(z.extern ? { target: '_blank', rel: 'noopener' } : {})}>
            {p.cta ?? 'Produkt kennenlernen'} <Icon name="arrow" size={18} /><span class="sr-only"> – {produktName(p)}</span>{z.extern && <span class="sr-only"> (öffnet in neuem Tab)</span>}
          </a>
        ) : (
          <p class="produkt__folgt">Eigene Produktseite folgt.</p>
        )}
      </article>
    );
  })}

  <div class="halt halt--r halt--bald weitere" style={`--zeile: ${weitere.length + 2}`}>
    <h3>Weitere Produkte entstehen.</h3>
    <p>Wir arbeiten an Lösungen für Zusammenarbeit, digitale Arbeitsplätze, Cloud-Anwendungen und einfachere Unternehmensabläufe.</p>
  </div>
</div>

<style>
  .pweg { row-gap: 22px; }
  @media (min-width: 960px) { .pweg > .produkt, .pweg > .weitere { grid-row: var(--zeile); } }

  .marke { display: flex; align-items: center; gap: 16px; padding-bottom: 6px; margin-left: -48px; }
  .marke__knoten { flex: none; display: grid; place-items: center; width: 36px; height: 36px; border-radius: 50%; background: var(--sec-bg); border: 3px solid var(--accent); }
  .marke__knoten span { width: 16px; height: 16px; border-radius: 50%; background: var(--accent); }
  .marke p { margin: 0; color: var(--ink-soft); line-height: 1.5; }
  .marke strong { display: block; font-family: var(--font-head); font-size: 1.35rem; letter-spacing: -0.01em; color: var(--ink); }
  @media (min-width: 960px) {
    .marke { margin-left: 0; justify-content: center; flex-direction: column; text-align: center; gap: 12px; padding-bottom: 18px; }
    .marke__knoten { width: 44px; height: 44px; }
    .marke__knoten span { width: 20px; height: 20px; }
    .marke p { max-width: 34ch; background: var(--sec-bg); padding: 4px 8px; }
  }

  .produkt { --hy: 38px; align-self: start; display: grid; gap: 12px; justify-items: start; align-content: start; background: var(--white); border: 1px solid rgb(0 166 161 / 45%); border-radius: 20px; padding: clamp(18px, 2.4vw, 26px); }
  .produkt--gross { --hy: 38px; gap: 16px; padding: clamp(22px, 3vw, 34px); }
  .produkt__kopf { display: flex; gap: 16px; align-items: center; }
  .produkt__icon { flex: none; display: grid; place-items: center; width: 48px; height: 48px; border-radius: 14px; background: var(--accent); color: var(--on-accent); }
  .produkt--gross .produkt__icon { width: 58px; height: 58px; border-radius: 16px; }
  .produkt__status { font-size: 0.74rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--accent-ink); }
  .produkt h3 { margin: 2px 0 0; font-size: clamp(1.15rem, 2vw, 1.35rem); }
  .produkt--gross h3 { font-size: clamp(1.4rem, 2.8vw, 1.9rem); }
  .produkt__nutzen { margin: 0; font-weight: 600; line-height: 1.5; }
  .produkt--gross .produkt__nutzen { font-size: 1.12rem; }
  .produkt__erkl { margin: 0; color: var(--ink-soft); line-height: 1.6; }
  .produkt__folgt { margin: 0; font-size: 0.92rem; color: #6f6a60; }
  .produkt .btn { min-height: 44px; }

  .weitere { --hy: 14px; padding-top: 2px; }
  .weitere h3 { margin: 0 0 4px; font-size: 1.12rem; color: #3f3c37; }
  .weitere p { margin: 0; color: var(--ink-soft); line-height: 1.55; }
</style>
