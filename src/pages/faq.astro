---
// /faq/ im Leitbild „Der Weg“ (27.10.2026). FAQPage-Markup NUR hier (Quelle: faqs).
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Faq from '../components/Faq.astro';
import Icon from '../components/Icon.astro';
import { href } from '../lib/paths';
import { faqs } from '../config/site';
---

<BaseLayout
  title="Häufige Fragen"
  description="Antworten auf häufige Fragen zum Website Service von Waybuild: Preise, Laufzeit, Ablauf, Eigentum an Website und Domain."
  breadcrumb={[{ name: 'Häufige Fragen', path: '/faq/' }]}
  schema={[{
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  }]}
>
  <PageHeader eyebrow="Häufige Fragen" title="Kurz und ehrlich" accent="beantwortet." lead="Ihre Frage ist nicht dabei? Schreiben Sie uns – wir antworten spätestens am nächsten Werktag." />
  <section class="section section--sand" id="faq" aria-label="Fragen und Antworten">
    <div class="wrap faq-wrap">
      <Faq items={faqs} />
      <p class="faq-weiter"><a class="pfeil-link" href={href('/angebot/')}>Zum Angebot <Icon name="arrow" size={16} /></a></p>
    </div>
  </section>
</BaseLayout>

<style>
  .faq-wrap :global(.faq) { max-width: 820px; }
  .faq-weiter { margin: 28px 0 0; }
</style>
