---
// Gemeinsamer Abschluss (dunkel) vor dem Footer: Frage + Erstgespräch + E-Mail.
// Letzter Schritt des Wegs (Design-System Jamil, Talk 3622: „Die Linie endet im Zielpunkt. Symbolisch: Veränderung umgesetzt.“).
// Startseite (rueckgrat): Das Rückgrat der Seite läuft hier hinein – Desktop gerade von der Mitte, Handy biegt es von links
// zur Mitte – und endet im Zielpunkt. Unterseiten: kurzes gerades Wegstück von oben in den Zielpunkt.
import { href } from '../lib/paths';
import { company, HOURS } from '../config/site';
import { FOOTER_KONTAKT as F } from '../config/home';
import Icon from './Icon.astro';
interface Props { rueckgrat?: boolean }
const { rueckgrat = false } = Astro.props;
---

<section class:list={['fkontakt', 'section--dark', { 'fkontakt--rueckgrat': rueckgrat }]} aria-labelledby="fkontakt-titel">
  <div class="zielweg" aria-hidden="true">
    <svg class="zielweg__bogen" viewBox="0 0 100 100" preserveAspectRatio="none" focusable="false"><path pathLength="1" d="M0 0 C 0 55, 100 40, 100 100" /></svg>
    <span class="zielweg__gerade"></span>
  </div>
  <svg class="zielpunkt" viewBox="0 0 48 48" aria-hidden="true" focusable="false"><circle cx="24" cy="24" r="20" /><circle cx="24" cy="24" r="11" /><circle class="zielpunkt__mitte" cx="24" cy="24" r="4.5" /></svg>
  <div class="wrap fkontakt__inner">
    {rueckgrat && <span class="fkontakt__kenn">Schritt 6 · Ziel</span>}
    <h2 id="fkontakt-titel">{F.pre}<span class="accent">{F.accent}</span></h2>
    <p class="fkontakt__text">{F.text}</p>
    <div class="fkontakt__actions">
      <a class="btn btn--primary btn--lg" href={href('/kontakt/')}>Erstgespräch anfragen <Icon name="arrow" size={18} /></a>
      <a class="btn btn--ghost btn--lg fkontakt__mail" href={`mailto:${company.email}`}><Icon name="mail" size={18} /> {company.email}</a>
    </div>
    <p class="fkontakt__zeiten">Servicezeiten: {HOURS}</p>
  </div>
</section>

<style>
  .fkontakt { --spine-x: calc((100% - min(100% - 32px, var(--wrap))) / 2 + 14px); position: relative; display: flow-root; padding-block: 0 clamp(48px, 7vw, 80px); background: var(--dark); view-timeline: --ziel; }
  .zielweg { position: absolute; top: 0; left: calc(50% - 1.5px); width: 3px; height: 72px; pointer-events: none; }
  .zielweg__bogen { display: none; }
  .zielweg__gerade { position: absolute; inset: 0; background: var(--accent-light); transform-origin: top; }
  .zielpunkt { position: relative; display: block; width: 52px; height: 52px; margin: 70px auto 22px; overflow: visible; }
  .zielpunkt circle { fill: var(--dark); stroke: var(--accent-light); stroke-width: 3.5; }
  .zielpunkt .zielpunkt__mitte { fill: var(--accent-light); stroke: none; }
  /* Startseite: Rückgrat läuft hinein */
  .fkontakt--rueckgrat .zielweg { height: 120px; }
  .fkontakt--rueckgrat .zielpunkt { margin-top: 118px; }
  @media (max-width: 959px) {
    .fkontakt--rueckgrat .zielweg { left: calc(var(--spine-x) - 1.5px); right: 50%; width: auto; }
    .fkontakt--rueckgrat .zielweg__gerade { display: none; }
    .fkontakt--rueckgrat .zielweg__bogen { display: block; width: 100%; height: 100%; overflow: visible; }
    .zielweg__bogen path { fill: none; stroke: var(--accent-light); stroke-width: 3; stroke-linecap: round; vector-effect: non-scaling-stroke; stroke-dasharray: 1; }
  }
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .zielweg__gerade { animation: ziel-wachsen linear both; }
      .zielweg__bogen path { animation: ziel-zeichnen linear both; }
      .zielpunkt { animation: ziel-auf linear both; }
      section.fkontakt span.zielweg__gerade, section.fkontakt .zielweg__bogen path { animation-timeline: --ziel; animation-range: entry 0% entry 45%; }
      section.fkontakt svg.zielpunkt { animation-timeline: --ziel; animation-range: entry 40% entry 55%; }
    }
  }
  @keyframes ziel-wachsen { from { transform: scaleY(0); } to { transform: none; } }
  @keyframes ziel-zeichnen { from { stroke-dashoffset: 1; } to { stroke-dashoffset: 0; } }
  @keyframes ziel-auf { from { opacity: 0; transform: scale(0.4); } to { opacity: 1; transform: none; } }
  .fkontakt__inner { display: grid; justify-items: center; text-align: center; gap: 18px; }
  .fkontakt__inner h2, .fkontakt__inner p { margin: 0; }
  .fkontakt__kenn { font-size: 0.8rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--accent-light); }
  .fkontakt h2 { font-size: clamp(2rem, 5.4vw, 3.6rem); line-height: 1.08; letter-spacing: -0.025em; max-width: 18ch; }
  .fkontakt__text { color: var(--dark-lead); max-width: 46ch; font-size: clamp(1.05rem, 2vw, 1.2rem); line-height: 1.6; }
  .fkontakt__actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; margin-top: 8px; }
  .fkontakt__mail { overflow-wrap: anywhere; }
  .fkontakt__zeiten { color: var(--dark-soft); font-size: 0.92rem; }
  @media (max-width: 480px) { .fkontakt__actions { display: grid; width: 100%; } }
</style>
