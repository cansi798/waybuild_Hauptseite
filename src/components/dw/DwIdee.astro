---
// Szene „Impuls“ (erster Schritt, bis Talk 4132 „Idee“; Jamil, Talk 4007): Ideen-Karten schweben als kleine türkise Karten um den Knoten auf der Linie.
// Talk 4122: passend zu „Eine Idee. Ein Wunsch. Ein Problem.“ sind es drei Gruppen à zwei Karten (Ideen, Wünsche,
// Probleme; seit Talk 4128 alle über dem Knoten), jede mit eigenem Symbol und einem kleinen Label, das auf der Linie sitzt. Beim Scrollen fließen die Gruppen
// nacheinander in den Knoten (wandern, schrumpfen, verschmelzen; die Labels blenden vorher aus); danach leuchtet der Knoten
// (groß, seit Talk 4132 mit dem Impuls-Blitz) auf: aus vielen Anliegen wird eine Idee. Keine Verbindungslinien („Spinnenbeine“).
// Technik: Alle Karten sitzen im Knoten; ihre Ruhelage ist ein Versatz in Container-Einheiten (--ox/--oy in cqw), den
// die Spur „einfaedeln“ in denkweise.ts auf 0 zieht (erst seitlich auf die Linie, dann hinab). Ohne JS / reduzierte Bewegung: ruhiges, gruppiertes Bild.
import Icon from '../Icon.astro';
import { DW_IDEE } from '../../config/denkweise';
const W = 440, H = 420, MX = 220, MY = 336;
const f = (n: number) => n.toFixed(3);
const ox = (x: number) => f(((x - MX) / W) * 100);
const oy = (y: number) => f(((y - MY) / W) * 100);
// Talk 4037: erst gut lesbar stehen lassen, dann (wenn die Linie den Knoten erreicht) einfließen – Talk 4122 gruppenweise
const gruppen = DW_IDEE.gruppen.map((g, gi) => {
  const fl = 0.7 + gi * 0.085;   // Talk 4128: alle Gruppen über dem Knoten, die Linie erreicht ihn später
  return {
    ...g,
    // Labels blenden gemeinsam aus, kurz bevor die erste Gruppe einfließt (sonst kreuzen die Karten mobil ein Label)
    an: `auf:${f(0.02 + gi * 0.09)}-${f(0.1 + gi * 0.09)} weg:0.640-0.690`,
    karten: g.karten.map((k, j) => ({
      ...k,
      an: `auf:${f(0.04 + gi * 0.09 + j * 0.03)}-${f(0.13 + gi * 0.09 + j * 0.03)} einfaedeln:${f(fl + j * 0.02)}-${f(fl + 0.1 + j * 0.02)}`,
    })),
  };
});
const pc = (a: number, c: number) => `${((a / c) * 100).toFixed(2)}%`;
const knoten = `left:${pc(MX, W)};top:${pc(MY, H)}`;
---
<div class="dw-bild dw-ideebild" data-szene style={`aspect-ratio: ${W} / ${H}`}>
  <svg viewBox={`0 0 ${W} ${H}`} aria-hidden="true" focusable="false">
  </svg>
  <span class="dw-anker" style="left:50%;top:0%" data-weg></span>
  {/* Talk 4179: hier beginnt die Scroll-Linie am Desktop – kleiner Startpunkt (am Handy läuft sie von der Kennzeile her durch) */}
  <span class="dw-pos dw-nur-d" style="left:50%;top:0%"><span class="dw-ideebild__start"></span></span>
  <span class="dw-anker" style={`left:50%;top:${pc(MY, H)}`} data-weg></span>
  <span class="dw-anker" style="left:50%;top:100%" data-weg></span>
  {/* Talk 4128: obere Gruppen zuletzt im DOM, damit einfließende Karten VOR den noch wartenden unteren Karten laufen */}
  {[...gruppen].reverse().map((g) => g.karten.map((k) => (
    <span class="dw-pos" style={knoten}>
      <span class="dw-ideebild__idee" style={`--ox:${ox(k.x)};--oy:${oy(k.y)}`} data-an={k.an}><Icon name={g.icon} size={14} />{k.text}</span>
    </span>
  )))}
  {/* Labels nach den Karten: einfließende Karten laufen unter dem Label durch (Talk 4122, mobil) */}
  {gruppen.map((g) => (
    <span class="dw-pos" style={knoten}>
      <span class="dw-ideebild__lage" style={`--ox:0;--oy:${oy(g.y)}`}><span class="dw-ideebild__gruppe" data-an={g.an}><Icon name={g.icon} size={13} />{g.label}</span></span>
    </span>
  ))}
  {/* Talk 4037: größerer Knoten (wie der Impuls-Kreis im Hero), Symbol seit Talk 4132 der Impuls-Blitz; füllt sich, wenn alle Ideen drin sind */}
  <span class="dw-pos" style={knoten}>
    <span class="dw-ideebild__knoten" data-an="erscheinen:0.3-0.4">
      <span class="dw-ideebild__fuell" data-an="blende:0.92-0.99"></span>
      <Icon name="impuls" size={22} />
    </span>
  </span>
</div>
