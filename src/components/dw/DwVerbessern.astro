---
// Szene „Verbessern“ (Jamil, Talk 3920): Die Linie läuft mittig auf den Kreis zu, teilt sich am oberen Scheitel in
// zwei Äste, die links und rechts herum den Kreis zeichnen und sich unten in der Mitte wieder treffen; von dort läuft
// sie mittig weiter. Ist der Kreis geschlossen (Klasse ist-zu, gesetzt vom Skript über data-zu), wird er türkis,
// zwischen den Begriffen entstehen Pfeile, und ein ruhiger Lichtpunkt kreist (ständiges Verbessern); die Begriffe
// leuchten kurz auf, wenn er sie erreicht. Ohne JS / reduzierte Bewegung: geschlossener türkiser Kreis mit Pfeilen.
import { DW_VERBESSERN as T } from '../../config/denkweise';
const W = 440, H = 440, CX = 220, CY = 210, R = 120;
// Laufrichtung der Pfeile und des Lichtpunkts: -1 = gegen den Uhrzeigersinn (Feedback → Lernen → Optimieren →
// Weiterentwickeln → Feedback, wie die Reihenfolge im Text), +1 = im Uhrzeigersinn.
const RICHTUNG: 1 | -1 = -1;
// Szenen-Fortschritt: Zulauf 0–0.22, Teilung + beide Äste 0.22–0.72, Kreis geschlossen ab 0.72, Weiterlauf bis 0.92
const TEIL = 0.22, ZU = 0.72, WEITER = 0.92;
const oben = CY - R, unten = CY + R;
// Winkel ab 12 Uhr im Uhrzeigersinn: Optimieren 0°, Lernen 90°, Feedback 180°, Weiterentwickeln 270°
const punkt = (grad: number, r = R) => { const a = (grad * Math.PI) / 180; return { x: CX + r * Math.sin(a), y: CY - r * Math.cos(a) }; };
const punkte = [
  { t: T.kreis[2], grad: 0, an: `${(TEIL - 0.03).toFixed(2)}-${(TEIL + 0.05).toFixed(2)}` },
  { t: T.kreis[1], grad: 90, an: `${((TEIL + ZU) / 2 - 0.04).toFixed(2)}-${((TEIL + ZU) / 2 + 0.03).toFixed(2)}` },
  { t: T.kreis[0], grad: 180, an: `${(ZU - 0.03).toFixed(2)}-${(ZU + 0.04).toFixed(2)}` },
  { t: T.kreis[3], grad: 270, an: `${((TEIL + ZU) / 2 - 0.04).toFixed(2)}-${((TEIL + ZU) / 2 + 0.03).toFixed(2)}` },
].map((p) => ({ ...p, ...punkt(p.grad) }));
// Reihenfolge, in der der Lichtpunkt (Start bei Feedback, 180°) die Begriffe erreicht → Verzögerung in Vierteln
const viertel = (grad: number) => (((RICHTUNG * (grad - 180)) % 360) + 360) % 360 / 90;
// Pfeile zwischen den Begriffen (45°, 135°, 225°, 315°), Spitze in Laufrichtung; gezeichnet bei 12 Uhr, dann gedreht
const pfeilD = `M ${CX - 5 * RICHTUNG} ${oben - 7} L ${CX + 3 * RICHTUNG} ${oben} L ${CX - 5 * RICHTUNG} ${oben + 7}`;
const pfeile = [45, 135, 225, 315].map((grad, i) => ({ grad, i, k: viertel(grad) }));
// Lichtpunkt: kurzer Schweif (36°) hinter dem Kopf bei Feedback
const kopf = punkt(180), schweif = punkt(180 - 36 * RICHTUNG);
const schweifD = `M ${schweif.x.toFixed(1)} ${schweif.y.toFixed(1)} A ${R} ${R} 0 0 ${RICHTUNG > 0 ? 1 : 0} ${kopf.x.toFixed(1)} ${kopf.y.toFixed(1)}`;
const pc = (a: number, c: number) => `${((a / c) * 100).toFixed(2)}%`;
---
<div class="dw-bild dw-kreis" data-szene data-zu={ZU} style={`aspect-ratio: ${W} / ${H}; --dw-r: ${RICHTUNG}`}>
  <svg viewBox={`0 0 ${W} ${H}`} aria-hidden="true" focusable="false">
    <defs>
      <linearGradient id="dw-schweif" x1={RICHTUNG > 0 ? 1 : 0} y1="0" x2={RICHTUNG > 0 ? 0 : 1} y2="0">
        <stop offset="0" style="stop-color: var(--accent); stop-opacity: 0" />
        <stop offset="1" style="stop-color: var(--accent); stop-opacity: 0.95" />
      </linearGradient>
    </defs>
    <path class="dw-s" pathLength="1" d={`M ${CX} 0 L ${CX} ${oben}`} data-an={`linear:0-${TEIL}`} />
    <path class="dw-s" pathLength="1" d={`M ${CX} ${oben} A ${R} ${R} 0 0 0 ${CX} ${unten}`} data-an={`linear:${TEIL}-${ZU}`} />
    <path class="dw-s" pathLength="1" d={`M ${CX} ${oben} A ${R} ${R} 0 0 1 ${CX} ${unten}`} data-an={`linear:${TEIL}-${ZU}`} />
    <path class="dw-s" pathLength="1" d={`M ${CX} ${unten} L ${CX} ${H}`} data-an={`linear:${ZU}-${WEITER}`} />
    <circle class="dw-kreis__ring" cx={CX} cy={CY} r={R} />
    {pfeile.map((p) => (
      <g transform={`rotate(${p.grad} ${CX} ${CY})`}>
        <g class="dw-pfeil" style={`--i:${p.i};--k:${p.k}`}><path d={pfeilD} /></g>
      </g>
    ))}
    <g class="dw-fluss" style={`transform-origin:${CX}px ${CY}px`}>
      <path class="dw-fluss__schweif" d={schweifD} stroke="url(#dw-schweif)" />
      <circle class="dw-fluss__hof" cx={kopf.x} cy={kopf.y} r="9" />
      <circle class="dw-fluss__kopf" cx={kopf.x} cy={kopf.y} r="4.5" />
    </g>
  </svg>
  <span class="dw-anker" style="left:50%;top:0%" data-weg="ein"></span>
  <span class="dw-anker" style="left:50%;top:100%" data-weg="aus"></span>
  {punkte.map((p) => (
    <span class="dw-pos" style={`left:${pc(p.x, W)};top:${pc(p.y, H)}`}>
      <span class="dw-chip dw-chip--auf-linie" style={`--k:${viertel(p.grad)}`} data-an={`auf:${p.an}`}>{p.t}</span>
    </span>
  ))}
</div>
