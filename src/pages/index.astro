---
// Startseite waybuild IT nach Jamils Konzept (Talk 3373) und Kreativbriefing (Talk 3378, gilt bei Widerspruch).
// Roter Faden: „Wir machen Veränderungen einfach.“ Jede Animation erklärt etwas:
//  2 Neues fließt zu „Fortschritt“ zusammen · 3 Problem-Kette (Warten pulsiert, weil man wartet)
//  4 Methode + andere Frage/eigene Frage · 5 vier Kreise beim Scrollen · 6 Services (Hover) · 7 Website wächst · 8 Abschluss.
// 26.10. Jamil (3381–3388): Abschluss-Schrift kleiner, „So arbeiten wir“ und Wachstums-Grafik entfernt, Fortschritt statisch mit Text, Hero-Unterzeile neu.
// Alles HTML/CSS/Inline-SVG; nur transform/opacity. Ohne JS sichtbar; bei prefers-reduced-motion Endbild.
// Bisherige Inhalte: /angebot/ (Preise, So starten wir), /faq/, /zusagen/ (Unsere Zusagen).
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { href } from '../lib/paths';
import type { IconName } from '../config/site';

const NEUES = ['Neue Idee', 'Neue Leistung', 'Neuer Mitarbeiter', 'Neue Abläufe'];

const PROBLEM: { icon: IconName; label: string; warten?: boolean }[] = [
  { icon: 'spark', label: 'Idee' },
  { icon: 'mail', label: 'E-Mail' },
  { icon: 'clock', label: 'Warten', warten: true },
  { icon: 'chat', label: 'Missverständnisse' },
  { icon: 'refresh', label: 'Korrekturen' },
  { icon: 'clock', label: 'Warten', warten: true },
  { icon: 'check', label: 'Umsetzung' },
];

const METHODE: { icon: IconName; label: string }[] = [
  { icon: 'spark', label: 'Idee' },
  { icon: 'eye', label: 'Verstehen' },
  { icon: 'zap', label: 'Umsetzen' },
  { icon: 'chart', label: 'Verbessern' },
];

const ANDERE_VERKAUFEN = ['Websites', 'Hosting', 'Cloud', 'Software'];
const WIR_VERKAUFEN = ['Klarheit', 'Fortschritt', 'Umsetzung', 'Veränderbarkeit'];

const SERVICES: { name: string; icon: IconName; aktiv?: boolean; text?: string }[] = [
  { name: 'Website Service', icon: 'layout', aktiv: true, text: 'Moderne Websites, die sich mit Ihrem Unternehmen weiterentwickeln.' },
  { name: 'Software Service', icon: 'code' },
  { name: 'Cloud Service', icon: 'cloud' },
  { name: 'Workplace Service', icon: 'users' },
  { name: 'Process Service', icon: 'layers' },
];

---

<BaseLayout
  title="Wir machen Veränderungen einfach"
  description="waybuild IT hilft Unternehmen, Veränderungen einfacher umzusetzen: verstehen, planen, umsetzen, verbessern. Heute mit dem Website Service."
  hideFooterKontakt
>
  <!-- 1 HERO -->
  <section class="hero" aria-labelledby="hero-h">
    <div class="hero__bg" aria-hidden="true"><i></i><i></i><i></i></div>
    <div class="wrap hero__inner">
      <span class="eyebrow">waybuild IT</span>
      <h1 id="hero-h">Wir machen Veränderungen <span class="accent">einfach.</span></h1>
      <p class="hero__sub">Sie haben eine Idee. Wir hören zu, verstehen und setzen um – ohne endloses Hin und Her.</p>
      <div class="hero__cta">
        <a class="btn btn--primary btn--lg" href={href('/kontakt/')}>Erstgespräch anfragen <Icon name="arrow" size={18} /></a>
        <a class="btn btn--ghost btn--lg" href={href('/angebot/')}>Angebot ansehen</a>
      </div>
    </div>
    <a class="hero__scroll" href={href('/#fortschritt')} aria-label="Nach unten scrollen"><Icon name="chevron" size={22} /></a>
  </section>

  <!-- 2 FORTSCHRITT BEGINNT MIT VERÄNDERUNG – Neues fließt zusammen -->
  <section class="section fort" id="fortschritt" aria-labelledby="fort-h">
    <div class="wrap">
      <div class="head head--center">
        <span class="eyebrow">Veränderung</span>
        <h2 id="fort-h">Fortschritt beginnt mit <span class="accent">Veränderung.</span></h2>
        <p class="lead">Ein neuer Mitarbeiter, eine neue Idee, neue Abläufe: In jedem Unternehmen verändert sich ständig etwas. Jede dieser Veränderungen ist Fortschritt – wenn sie einfach umzusetzen ist.</p>
      </div>
      <div class="fliessen">
        <ul class="fliessen__neu" aria-label="Was sich in einem Unternehmen verändert">
          {NEUES.map((t, i) => <li style={`--i:${i}`}>{t}</li>)}
        </ul>
        <span class="fliessen__pfeil" aria-hidden="true"></span>
        <p class="fliessen__ziel">Fortschritt</p>
      </div>
    </div>
  </section>

  <!-- 3 WARUM ES UNS GIBT – Entstehung + Problem-Kette -->
  <section class="section problem" id="warum" aria-labelledby="problem-h">
    <div class="wrap">
      <div class="head">
        <span class="eyebrow">Warum es uns gibt</span>
        <h2 id="problem-h">Warum ist eine Veränderung <span class="muted">so kompliziert?</span></h2>
        <p class="lead">Waybuild ist aus Frust entstanden. Eine Website zu bekommen, war unnötig schwer: E-Mails, Screenshots, WhatsApp-Nachrichten, Abstimmungsschleifen. Die Technik war nie das Problem. Der Weg von der Idee bis zur Umsetzung war es.</p>
      </div>
      <ol class="kette kette--problem reveal" aria-label="So läuft Zusammenarbeit oft">
        {PROBLEM.map((n, i) => (
          <li class:list={['node', { 'node--warten': n.warten, 'node--ende': i === PROBLEM.length - 1 }]} style={`--i:${i}`}>
            <span class="node__kreis"><Icon name={n.icon} size={26} /></span>
            <span class="node__label">{n.label}</span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 4 WIE WIR DENKEN – Methode + andere Frage / eigene Frage -->
  <section class="section methode" id="methode" aria-labelledby="methode-h">
    <div class="wrap">
      <div class="head head--center">
        <span class="eyebrow">Wie wir denken</span>
        <h2 id="methode-h">Wir beginnen beim <span class="accent">Verstehen.</span></h2>
      </div>
      <ol class="kette kette--methode reveal" aria-label="Der Weg mit waybuild">
        {METHODE.map((n, i) => (
          <li class="node" style={`--i:${i}`}>
            <span class="node__kreis"><Icon name={n.icon} size={30} /></span>
            <span class="node__label">{n.label}</span>
          </li>
        ))}
      </ol>
      <div class="fragen">
        <div class="frage frage--andere reveal">
          <h3>Andere fragen</h3>
          <p class="frage__satz">„Welche Software benötigen Sie?“</p>
          <p class="frage__titel">Sie verkaufen</p>
          <ul>{ANDERE_VERKAUFEN.map((t) => <li>{t}</li>)}</ul>
        </div>
        <div class="frage frage--wir reveal" style="--d:200ms">
          <h3>Wir fragen</h3>
          <p class="frage__satz">„Was möchten Sie erreichen?“</p>
          <p class="frage__titel">Wir verkaufen</p>
          <ul>{WIR_VERKAUFEN.map((t, i) => <li style={`--i:${i}`}>{t}</li>)}</ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 6 SERVICES – Produktwelt -->
  <section class="section services" id="services" aria-labelledby="services-h">
    <div class="wrap">
      <div class="head">
        <span class="eyebrow">Unsere Services</span>
        <h2 id="services-h">Heute starten wir mit dem <span class="accent">Website Service.</span></h2>
        <p class="lead">Weitere Angebote folgen.</p>
      </div>
      <ul class="karten">
        {SERVICES.map((s, i) => (
          <li class:list={['karte', 'reveal', s.aktiv ? 'karte--aktiv' : 'karte--bald']} style={`--i:${i}`}>
            <span class="karte__status">{s.aktiv ? 'Aktiv' : 'Bald verfügbar'}</span>
            <span class="karte__icon" aria-hidden="true"><Icon name={s.icon} size={s.aktiv ? 32 : 26} /></span>
            <h3>{s.name}</h3>
            {s.text && <p>{s.text}</p>}
            {s.aktiv && <a class="btn btn--primary" href={href('/angebot/')}>Zum Angebot <Icon name="arrow" size={18} /></a>}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 8 ABSCHLUSS -->
  <section class="abschluss" aria-labelledby="abschluss-h">
    <div class="abschluss__bg" aria-hidden="true"><i></i><i></i></div>
    <div class="wrap abschluss__inner">
      <h2 id="abschluss-h" class="reveal">Veränderungen gehören zu jedem <span class="accent">Unternehmen.</span></h2>
      <p class="abschluss__sub reveal" style="--d:150ms">Wir sorgen dafür, dass sie einfacher werden.</p>
      <p class="reveal" style="--d:300ms"><a class="btn btn--primary btn--lg" href={href('/kontakt/')}>Erstgespräch anfragen <Icon name="arrow" size={18} /></a></p>
    </div>
  </section>
</BaseLayout>

<style>
  /* Gemeinsam */
  .head { max-width: 760px; margin-bottom: clamp(28px, 6vw, 64px); }
  .head--center { margin-inline: auto; text-align: center; }
  .head h2 { font-size: clamp(2rem, 6vw, 3.6rem); line-height: 1.08; letter-spacing: -0.02em; }
  .head .eyebrow { display: inline-block; margin-bottom: 12px; }
  .muted { color: #8a857b; }
  .section--dark .muted { color: var(--dark-soft); }

  /* 1 HERO – Vollbild, ruhige Hintergrundbewegung */
  .hero { position: relative; overflow: hidden; display: grid; align-items: center; min-height: calc(100svh - var(--header-h, 72px)); padding-block: 48px 96px; background: var(--paper); }
  .hero__bg { position: absolute; inset: 0; pointer-events: none; }
  .hero__bg::before { content: ''; position: absolute; inset: 0; background-image: radial-gradient(rgb(0 79 76 / 14%) 1px, transparent 1.4px); background-size: 28px 28px; mask-image: radial-gradient(ellipse at 70% 40%, #000 0%, transparent 70%); }
  .hero__bg i { position: absolute; border-radius: 50%; will-change: transform; }
  .hero__bg i:nth-child(1) { width: min(70vw, 640px); aspect-ratio: 1; right: -12%; top: -8%; background: radial-gradient(closest-side, rgb(0 166 161 / 26%), transparent); animation: drift1 22s ease-in-out infinite alternate; }
  .hero__bg i:nth-child(2) { width: min(60vw, 520px); aspect-ratio: 1; left: -16%; bottom: -14%; background: radial-gradient(closest-side, rgb(0 107 104 / 18%), transparent); animation: drift2 28s ease-in-out infinite alternate; }
  .hero__bg i:nth-child(3) { width: min(40vw, 360px); aspect-ratio: 1; right: 22%; bottom: 8%; background: radial-gradient(closest-side, rgb(0 166 161 / 14%), transparent); animation: drift3 18s ease-in-out infinite alternate; }
  @keyframes drift1 { to { transform: translate3d(-8%, 10%, 0) scale(1.1); } }
  @keyframes drift2 { to { transform: translate3d(12%, -8%, 0) scale(1.15); } }
  @keyframes drift3 { to { transform: translate3d(-14%, -10%, 0) scale(0.9); } }
  .hero__inner { position: relative; }
  .hero h1 { font-size: clamp(2.5rem, 8.6vw, 5.8rem); line-height: 1.04; letter-spacing: -0.03em; max-width: 14ch; margin-bottom: 24px; }
  .hero__sub { font-size: clamp(1.15rem, 2.6vw, 1.6rem); color: var(--ink-soft); max-width: 36ch; line-height: 1.4; margin: 0 0 32px; }
  .hero__cta { display: flex; flex-wrap: wrap; gap: 12px; }
  .hero__scroll { position: absolute; left: 50%; bottom: 24px; translate: -50% 0; display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%; border: 1px solid var(--line); background: rgb(255 255 255 / 70%); color: var(--accent-ink); animation: huepfen 2.4s ease-in-out infinite; }
  @keyframes huepfen { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(6px); } }

  /* Ketten (Problem + Methode): Knoten erscheinen nacheinander, die Linie wächst mit */
  .kette { list-style: none; margin: 0; padding: 0; display: grid; gap: 0; position: relative; counter-reset: k; }
  .node { position: relative; display: flex; align-items: center; gap: 18px; padding-block: 14px; }
  .node__kreis { flex: none; display: grid; place-items: center; width: 64px; height: 64px; border-radius: 50%; background: var(--white); border: 2px solid var(--line); color: var(--ink-soft); position: relative; z-index: 1; }
  .node__label { font-family: var(--font-head); font-weight: 700; font-size: 1.15rem; }
  /* mobil: senkrechte Linie */
  .kette::before { content: ''; position: absolute; left: 31px; top: 36px; bottom: 36px; width: 2px; background: var(--line); transform-origin: top; }
  .kette.reveal { transform: none; }
  :global(html.js) .kette:not(.is-visible)::before { transform: scaleY(0); }
  .kette.is-visible::before { animation: linie-v 1.8s cubic-bezier(.4,0,.2,1) both; }
  @keyframes linie-v { from { transform: scaleY(0); } to { transform: scaleY(1); } }
  :global(html.js) .kette:not(.is-visible) .node { opacity: 0; transform: translateY(14px); }
  .node { transition: opacity 500ms ease, transform 500ms ease; transition-delay: calc(var(--i) * 260ms); }
  @media (min-width: 960px) {
    .kette { grid-template-columns: repeat(var(--n, 7), 1fr); }
    .kette--problem { --n: 7; }
    .kette--methode { --n: 4; }
    .node { flex-direction: column; text-align: center; gap: 14px; padding: 0 4px; }
    .kette::before { left: 6%; right: 6%; top: 32px; bottom: auto; width: auto; height: 2px; transform-origin: left; }
    .kette--methode::before { left: 12.5%; right: 12.5%; }
    .kette--problem::before { left: 7%; right: 7%; }
    :global(html.js) .kette:not(.is-visible)::before { transform: scaleX(0); }
    .kette.is-visible::before { animation-name: linie-h; }
  }
  @keyframes linie-h { from { transform: scaleX(0); } to { transform: scaleX(1); } }

  /* Problem: Warten-Knoten pulsieren unruhig, danach verblassen die Stationen – „die Grafik verwandelt sich“ */
  .problem { background: var(--paper-2); }
  .node--warten .node__kreis { border-color: #b4791f; color: #8a5a10; }
  .node--warten .node__kreis::after { content: ''; position: absolute; inset: -8px; border-radius: 50%; border: 2px solid #b4791f; opacity: 0; }
  .kette.is-visible .node--warten .node__kreis::after { animation: unruhe 2.4s ease-out infinite; animation-delay: calc(var(--i) * 260ms + 600ms); }
  @keyframes unruhe { 0% { transform: scale(0.85); opacity: 0.5; } 100% { transform: scale(1.25); opacity: 0; } }
  .node--ende .node__kreis { border-color: var(--accent); color: var(--accent-ink); }

  /* Methode (dunkel, schnell, türkis) */
  .methode { background: var(--dark); color: var(--paper); }
  .methode h2 { color: var(--white); }
  .methode .eyebrow { color: var(--accent); }
  .methode .accent { color: var(--accent); }
  .methode .node__kreis { background: #0a5f5c; border-color: var(--accent); color: var(--accent); width: 72px; height: 72px; }
  .methode .node__label { color: var(--white); font-size: clamp(1.2rem, 2.4vw, 1.5rem); }
  .methode .kette::before { background: var(--accent); left: 35px; }
  @media (min-width: 960px) { .methode .kette::before { left: 12.5%; right: 12.5%; top: 36px; } }
  .methode .node { transition-delay: calc(var(--i) * 140ms); }
  .methode .kette.is-visible::before { animation-duration: 0.9s; }
  .methode__fertig { display: flex; align-items: center; justify-content: center; gap: 8px; margin: 36px 0 0; font-family: var(--font-head); font-size: 1.4rem; font-weight: 700; color: var(--accent); }

  /* Services */
  .karten { list-style: none; margin: 0; padding: 0; display: grid; gap: 16px; grid-template-columns: 1fr 1fr; }
  .karte--aktiv { grid-column: 1 / -1; }
  @media (min-width: 960px) { .karten { grid-template-columns: repeat(4, 1fr); gap: 20px; } }
  .karte { position: relative; display: grid; gap: 10px; align-content: start; justify-items: start; border-radius: 24px; padding: clamp(20px, 3vw, 36px); overflow: hidden; transition: transform 300ms ease, box-shadow 300ms ease, border-color 300ms ease, background 300ms ease; }
  .karte--bald { min-height: 190px; }
  .karte h3 { margin: 0; font-size: clamp(1.1rem, 2.2vw, 1.4rem); letter-spacing: -0.01em; }
  .karte--aktiv h3 { font-size: clamp(1.5rem, 3vw, 2rem); }
  .karte p { margin: 0; line-height: 1.55; }
  .karte__status { font-size: 0.78rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; padding: 5px 12px; border-radius: 999px; }
  .karte__icon { display: grid; place-items: center; width: 56px; height: 56px; border-radius: 16px; }
  .karte--aktiv { background: var(--white); border: 1px solid var(--line); box-shadow: var(--shadow); }
  .karte--aktiv .karte__status { background: rgb(0 166 161 / 16%); color: var(--accent-ink); }
  .karte--aktiv .karte__icon { background: var(--accent); color: var(--ink); }
  .karte--aktiv p { color: var(--ink-soft); font-size: 1.1rem; max-width: 32ch; }
  .karte--aktiv .btn { margin-top: 8px; }
  .karte--bald { background: var(--paper-2); border: 1px dashed #c9c2b3; color: #77736a; }
  .karte--bald h3 { color: #77736a; }
  .karte--bald .karte__status { background: rgb(0 0 0 / 6%); color: #6f6b62; }
  .karte--bald .karte__icon { background: rgb(0 0 0 / 6%); color: #8a857b; transition: background 300ms ease, color 300ms ease; }
  /* sanftes Hover: Karten heben sich, die ausgegrauten bekommen einen Hauch Farbe (Bedeutung: hier entsteht noch mehr) */
  @media (hover: hover) {
    .karte:hover { transform: translateY(-4px); }
    .karte--aktiv:hover { box-shadow: 0 2px 4px rgb(0 79 76 / 8%), 0 16px 36px rgb(0 79 76 / 14%); border-color: var(--accent); }
    .karte--bald:hover { background: #f1eee6; border-color: var(--accent); }
    .karte--bald:hover .karte__icon { background: rgb(0 166 161 / 16%); color: var(--accent-ink); }
  }

  /* 2 Fortschritt: Neues fließt zusammen (Bedeutung: aus vielen Veränderungen wird Fortschritt) */
  .fort { background: var(--paper); }
  .fliessen { display: grid; justify-items: center; gap: 22px; max-width: 760px; margin-inline: auto; position: relative; }
  .fliessen__neu { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 12px; width: 100%; }
  @media (min-width: 760px) { .fliessen__neu { grid-template-columns: repeat(4, 1fr); } }
  .fliessen__neu li { text-align: center; padding: 16px 10px; border-radius: 16px; background: var(--white); border: 1px solid var(--line); font-family: var(--font-head); font-weight: 700; font-size: 1.02rem; line-height: 1.25; }
  .fliessen__pfeil { width: 2px; height: 44px; background: var(--accent); position: relative; transform-origin: top; }
  .fliessen__pfeil::after { content: ''; position: absolute; left: -5px; bottom: -2px; width: 10px; height: 10px; border-right: 2px solid var(--accent); border-bottom: 2px solid var(--accent); rotate: 45deg; }
  .fliessen__ziel { margin: 0; padding: 18px 44px; border-radius: 999px; background: var(--accent); color: var(--ink); font-family: var(--font-head); font-weight: 800; font-size: clamp(1.6rem, 4.5vw, 2.6rem); letter-spacing: -0.01em; }

  /* 4 Frage / Antwort */
  .fragen { display: grid; gap: 18px; max-width: 900px; margin: clamp(36px, 6vw, 64px) auto 0; }
  @media (min-width: 760px) { .fragen { grid-template-columns: 1fr 1fr; gap: 24px; } }
  .frage { border-radius: 24px; padding: clamp(22px, 4vw, 36px); }
  .frage h3 { font-size: 0.85rem; letter-spacing: 0.12em; text-transform: uppercase; margin: 0 0 14px; }
  .frage__satz { font-family: var(--font-head); font-weight: 700; font-size: clamp(1.2rem, 2.8vw, 1.6rem); line-height: 1.25; margin: 0 0 20px; }
  .frage__titel { margin: 0 0 8px; font-size: 0.85rem; letter-spacing: 0.08em; text-transform: uppercase; opacity: 0.7; }
  .frage ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .frage li { padding: 6px 14px; border-radius: 999px; font-weight: 600; }
  .frage--andere { background: rgb(255 255 255 / 6%); border: 1px solid var(--dark-line); color: var(--dark-soft); }
  .frage--andere h3 { color: var(--dark-soft); }
  .frage--andere li { border: 1px solid var(--dark-line); }
  .frage--wir { background: var(--white); color: var(--ink); }
  .frage--wir h3 { color: var(--accent-ink); }
  .frage--wir li { background: rgb(0 166 161 / 16%); color: var(--accent-ink); }
  :global(html.js) .frage--wir:not(.is-visible) li { opacity: 0; transform: translateY(8px); }
  .frage--wir li { transition: opacity 500ms ease, transform 500ms ease; transition-delay: calc(0.5s + var(--i) * 0.2s); }
  .frage.reveal { transition-delay: var(--d, 0ms); }

  /* So arbeiten wir – tall + sticky nur mit JS */
  .arbeiten { padding-block: clamp(44px, 9vw, 120px); }
  .arbeiten--scroll { height: 300vh; padding-block: 0; }
  .arbeiten--scroll .arbeiten__sticky { position: sticky; top: var(--header-h, 72px); min-height: calc(100svh - var(--header-h, 72px)); display: grid; align-items: center; padding-block: 24px; }
  .arbeiten .head { margin-bottom: clamp(20px, 4vw, 48px); }
  .arbeiten .head h2 { font-size: clamp(1.6rem, 4.4vw, 2.8rem); max-width: 22ch; margin-inline: auto; }
  .kreise { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 24px 16px; max-width: 1000px; margin-inline: auto; position: relative; }
  @media (min-width: 860px) { .kreise { grid-template-columns: repeat(4, 1fr); gap: 24px; } }
  .kreis { display: grid; justify-items: center; text-align: center; gap: 8px; }
  .kreis__ring { display: grid; place-items: center; width: clamp(84px, 22vw, 132px); aspect-ratio: 1; border-radius: 50%; border: 3px solid var(--line); background: var(--white); color: #8a857b; transition: background 500ms ease, border-color 500ms ease, color 500ms ease, transform 500ms ease, box-shadow 500ms ease; }
  .kreis h3 { margin: 6px 0 0; font-size: clamp(1.05rem, 2.6vw, 1.3rem); transition: color 400ms ease; }
  .kreis p { margin: 0; font-size: 0.95rem; line-height: 1.45; color: var(--ink-soft); max-width: 22ch; }
  .arbeiten--scroll .kreis:not(.is-active) { opacity: 0.45; }
  .arbeiten--scroll .kreis { transition: opacity 500ms ease; }
