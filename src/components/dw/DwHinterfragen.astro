---
// Szene „Hinterfragen“ (Talk 4020, verständlicher und neben dem Text nach Talk 4048). Die Linie läuft links, die
// Schritte stehen rechts daneben, jeder mit sichtbarer Nummer:
//   ① Die erste Idee („Neue Website“)   ② Warum? – die Linie stoppt, ein kleiner Kreis entsteht (teilt sich wie alle)
//   ③ Mögliche Ziele (an der Linie)      ④ Ein Ziel wählen – „Mehr Anfragen“ mit Haken, die anderen grau
//   ⑤ Möglichkeiten für mehr Anfragen    ⑥ Eine Richtung – die passenden docken an, „Website“ allein tritt zurück
// Ohne JS / reduzierte Bewegung: fertiges Endbild.
import Icon from '../Icon.astro';
import { DW_HINTERFRAGEN } from '../../config/denkweise';
const T = DW_HINTERFRAGEN.szene;
const W = 440, H = 640, X = 56, STEG = 24, WY = 132;
const ROW = { start: 58, ziele: [236, 270, 304, 338], moeg: [446, 480, 514, 548], knot: 598 };
const CAP = { s1: 24, s2: WY, s3: 204, s4: 374, s5: 414, s6: ROW.knot };
const f = (n: number) => n.toFixed(3);
const pc = (a: number, c: number) => `${((a / c) * 100).toFixed(2)}%`;
// Linie läuft nach dem Kreis bei p = 0.3 weiter und erreicht y bei p(y); Begriffe erscheinen, wenn sie dort ist
const LIN0 = 0.3, LIN1 = 0.97;
const pBei = (y: number) => LIN0 + ((y - WY) / (H - WY)) * (LIN1 - LIN0);
const steg = (y: number) => `M ${X} ${y} L ${X + STEG} ${y}`;
const ziele = T.ziele.map((t, i) => ({ t, i, y: ROW.ziele[i], haupt: i === T.ziel, an: pBei(ROW.ziele[i]) - 0.03 }));
const moeg = T.moeglichkeiten.map((t, i) => ({ t, i, y: ROW.moeg[i], bleibt: T.bleiben.includes(i), an: pBei(ROW.moeg[i]) - 0.03 }));
const WAHL = 0.6, RICHTUNG = 0.88;
const rechts = (y: number) => `left:calc(${pc(X, W)} + ${STEG + 6}px);top:${pc(y, H)}`;
const nr = ['①', '②', '③', '④', '⑤', '⑥'];
---
<div class="dw-bild dw-hf" data-szene style={`aspect-ratio: ${W} / ${H}`}>
  <svg viewBox={`0 0 ${W} ${H}`} aria-hidden="true" focusable="false">
    <path class="dw-s" pathLength="1" d={`M ${X} 0 L ${X} ${WY}`} data-an="linear:0-0.16" />
    <path class="dw-s" pathLength="1" d={`M ${X} ${WY} L ${X} ${H}`} data-an={`linear:${LIN0}-${LIN1}`} />
    <path class="dw-s" pathLength="1" d={steg(ROW.start)} data-an="zeichnen:0.04-0.08" />
    {ziele.map((z) => <path class={z.haupt ? 'dw-s dw-hf__steg--wahl' : 'dw-s'} pathLength="1" d={steg(z.y)} data-an={`zeichnen:${f(z.an)}-${f(z.an + 0.04)}${z.haupt ? '' : ` aus:${WAHL}-${f(WAHL + 0.08)}:0.3`}`} />)}
    {moeg.map((m) => <path class="dw-s" pathLength="1" d={steg(m.y)} data-an={`zeichnen:${f(m.an)}-${f(m.an + 0.04)}${m.bleibt ? '' : ` aus:${RICHTUNG}-${f(RICHTUNG + 0.06)}:0.25`}`} />)}
    <circle class="dw-knoten dw-knoten--akzent" cx={X} cy={ROW.knot} r="7" data-an={`erscheinen:${RICHTUNG}-${f(RICHTUNG + 0.06)}`} />
  </svg>
  <span class="dw-anker" style={`left:${pc(X, W)};top:0%`} data-weg="ein"></span>
  <span class="dw-anker" style={`left:${pc(X, W)};top:100%`} data-weg="aus"></span>

  {/* Schritt-Beschriftungen */}
  <span class="dw-pos dw-pos--rechts" style={rechts(CAP.s1)}><span class="dw-hf__schritt" data-an="auf:0-0.06">{nr[0]} Die erste Idee</span></span>
  <span class="dw-pos dw-pos--rechts" style={`left:calc(${pc(X, W)} + 40px);top:${pc(CAP.s2, H)}`}><span class="dw-hf__schritt" data-an="auf:0.18-0.26">{nr[1]} Wozu soll es dienen?</span></span>
  <span class="dw-pos dw-pos--rechts" style={rechts(CAP.s3)}><span class="dw-hf__schritt" data-an={`auf:${f(pBei(ROW.ziele[0]) - 0.07)}-${f(pBei(ROW.ziele[0]) - 0.03)}`}>{nr[2]} Mögliche Ziele</span></span>
  <span class="dw-pos dw-pos--rechts" style={rechts(CAP.s4)}><span class="dw-hf__schritt" data-an={`auf:${WAHL}-${f(WAHL + 0.07)}`}>{nr[3]} Ein Ziel wählen</span></span>
  <span class="dw-pos dw-pos--rechts" style={rechts(CAP.s5)}><span class="dw-hf__schritt" data-an={`auf:${f(pBei(ROW.moeg[0]) - 0.07)}-${f(pBei(ROW.moeg[0]) - 0.03)}`}>{nr[4]} Möglichkeiten dafür</span></span>
  <span class="dw-pos dw-pos--rechts" style={`left:calc(${pc(X, W)} + 16px);top:${pc(CAP.s6, H)}`}><span class="dw-hf__schritt dw-hf__schritt--ziel" data-an={`auf:${f(RICHTUNG + 0.02)}-${f(RICHTUNG + 0.09)}`}>{nr[5]} {T.richtung}</span></span>

  {/* ① die erste Idee */}
  <span class="dw-pos dw-pos--rechts" style={rechts(ROW.start)}>
    <span class="dw-hf-chip dw-hf-chip--start" data-an="auf:0.02-0.08"><Icon name="idee" size={15} /> {T.start}</span>
  </span>
  {/* ② Warum? – kleiner Kreis auf der Linie, teilt sich */}
  <span class="dw-pos" style={`left:${pc(X, W)};top:${pc(WY, H)}`}>
    <span class="dw-hf__warum">
      <svg class="dw-verstehen__ring" viewBox="0 0 100 100" aria-hidden="true" focusable="false">
        <path class="dw-s dw-verstehen__ast" pathLength="1" d="M 50 1.5 A 48.5 48.5 0 0 0 50 98.5" data-an="linear:0.16-0.26" />
        <path class="dw-s dw-verstehen__ast" pathLength="1" d="M 50 1.5 A 48.5 48.5 0 0 1 50 98.5" data-an="linear:0.16-0.26" />
      </svg>
      <span class="dw-hf__warum-text" data-an="blende:0.2-0.28">{T.warum}</span>
    </span>
  </span>
  {/* ③ + ④ Ziele */}
  {ziele.map((z) => (
    <>
      <span class="dw-pos dw-pos--rechts" style={rechts(z.y)}>
        <span class="dw-hf-chip" data-an={`auf:${f(z.an)}-${f(z.an + 0.06)}${z.haupt ? '' : ` aus:${WAHL}-${f(WAHL + 0.08)}:0.35`}`}>{z.t}</span>
      </span>
      {z.haupt && (
        <span class="dw-pos dw-pos--rechts" style={rechts(z.y)}>
          <span class="dw-hf-chip dw-hf-chip--ziel" data-an={`blende:${WAHL}-${f(WAHL + 0.07)}`}><Icon name="check" size={14} /> {z.t}</span>
        </span>
      )}
    </>
  ))}
  {/* ⑤ + ⑥ Möglichkeiten */}
  {moeg.map((m) => (
    <>
      <span class="dw-pos dw-pos--rechts" style={rechts(m.y)}>
        <span class="dw-hf-chip" data-an={`auf:${f(m.an)}-${f(m.an + 0.06)}${m.bleibt ? '' : ` aus:${RICHTUNG}-${f(RICHTUNG + 0.06)}:0.3`}`}>{m.t}</span>
      </span>
      {m.bleibt && (
        <span class="dw-pos dw-pos--rechts" style={rechts(m.y)}>
          <span class="dw-hf-chip dw-hf-chip--bleibt" data-an={`blende:${f(RICHTUNG + m.i * 0.015)}-${f(RICHTUNG + 0.06 + m.i * 0.015)}`}>{m.t}</span>
        </span>
      )}
    </>
  ))}
</div>
