---
// Schlankes Layout für den Onepager (Jamil #6072, 15.11.2026): Kopf mit Logo, Inhalt, Fußzeile mit Impressum + Datenschutz.
// Marke/Design webgold (WS-0007: Palette start-farben.css, Schrift Plus Jakarta Sans lokal), Rechtsträger Waybuild UG.
import '@fontsource-variable/plus-jakarta-sans/wght.css';
import '../styles/global.css';
import schrift from '@fontsource-variable/plus-jakarta-sans/files/plus-jakarta-sans-latin-wght-normal.woff2?url';
import { company, BESCHREIBUNG, POSITIONIERUNG } from '../config/site';
import { href, absolute } from '../lib/paths';
import { IS_PREVIEW } from '../lib/env';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  /** Startseite: Kopf liegt transparent auf dem Hero */
  start?: boolean;
}
const { title, description, noindex = false, start = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const siteRoot = absolute('/', Astro.site);
const ogImage = absolute('/og-image.png', Astro.site);
const fullTitle = title.includes(company.name) ? title : `${title} | ${company.name}`;

const organization = {
  '@context': 'https://schema.org',
  '@type': ['Organization', 'ProfessionalService'],
  '@id': `${siteRoot}#organization`,
  name: company.legalName,
  alternateName: company.name,
  description: BESCHREIBUNG,
  slogan: POSITIONIERUNG,
  url: siteRoot,
  logo: absolute('/icon-512.png', Astro.site),
  image: ogImage,
  foundingDate: company.foundingYear,
  email: company.email,
  telephone: '+49 ' + company.phone.replace(/^0/, ''),
  address: { '@type': 'PostalAddress', streetAddress: company.street, postalCode: company.zip, addressLocality: company.city, addressCountry: company.country },
  areaServed: { '@type': 'Country', name: 'Deutschland', identifier: 'DE' },
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'customer service',
    email: company.email,
    availableLanguage: ['de'],
    hoursAvailable: { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'], opens: '09:00', closes: '17:00' },
  },
};
const website = { '@context': 'https://schema.org', '@type': 'WebSite', '@id': `${siteRoot}#website`, url: siteRoot, name: company.name, inLanguage: 'de-DE', publisher: { '@id': `${siteRoot}#organization` } };
const jahr = new Date().getFullYear();
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <link rel="preload" href={schrift} as="font" type="font/woff2" crossorigin />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={IS_PREVIEW ? 'noindex, nofollow' : noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1'} />
    <meta name="theme-color" content="#0b6d6b" />
    <link rel="icon" href={href('/favicon.ico')} sizes="any" />
    <link rel="icon" href={href('/icon-192.png')} type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href={href('/apple-touch-icon.png')} />
    <link rel="manifest" href={href('/site.webmanifest')} />
    <link rel="sitemap" href={href('/sitemap-index.xml')} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:site_name" content={company.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="webgold: Hier entsteht unsere neue Website." />
    <meta name="twitter:card" content="summary_large_image" />
    {!noindex && [organization, website].map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)}
  </head>
  <body class={start ? 'ist-start' : undefined}>
    <a class="skip" href="#main">Zum Inhalt springen</a>
    {IS_PREVIEW && <div class="vorschau-leiste" role="note">Vorschau – nicht öffentlich</div>}
    <header class="kopf">
      <div class="wrap kopf__innen">
        <a class="kopf__logo" href={href('/')} aria-label="webgold, zur Startseite">
          <img src={href('/logo-webgold.svg')} alt="webgold" width="132" height="32" />
        </a>
        <a class="btn btn--klein" href={start ? '#kontakt' : href('/#kontakt')}>Kontakt</a>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="fuss">
      <div class="wrap fuss__innen">
        <p>© {jahr} {company.legalName}</p>
        <nav aria-label="Rechtliches">
          <ul>
            <li><a href={href('/impressum/')}>Impressum</a></li>
            <li><a href={href('/datenschutz/')}>Datenschutz</a></li>
          </ul>
        </nav>
      </div>
    </footer>
  </body>
</html>
