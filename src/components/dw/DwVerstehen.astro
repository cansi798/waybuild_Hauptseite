---
// Szene „Verstehen“ (Talk 3920/4042): Der Kreis ist jetzt so groß wie der Ideen-Knoten (52 px) und trägt eine Lupe
// statt des Wortes „Verständnis“ (für Screenreader bleibt „Verständnis“). Die Linie läuft mittig auf ihn zu, teilt sich
// am oberen Scheitel in zwei Äste, die den Kreis bilden und sich unten treffen; von dort läuft sie mittig weiter.
// Unternehmen, Menschen, Ziele, Kommunikation und Prozesse stehen ringsum und verbinden sich mit kurzen Linien mit dem
// Kreis (die Linien enden unter dem Kreis), dann füllt er sich.
// Der Kreis ist ein HTML-Element mit eigenem kleinem SVG für die beiden Äste, damit er auf jeder Breite 52 px bleibt;
// die Anker der Linie sitzen an seinem oberen und unteren Rand. Kein Einblenden per transform (sonst stimmt die Messung nicht).
import Icon from '../Icon.astro';
import { DW_VERSTEHEN } from '../../config/denkweise';
const W = 440, H = 360, CX = 220, CY = 180;
// Spitze erreicht den oberen Kreisrand bei p ≈ (CY − 30) / H / 0.85 ≈ 0.49
const TEIL = 0.46, ZU = 0.6;
const f = (n: number) => n.toFixed(3);
const b = DW_VERSTEHEN.begriffe.map((x, k) => ({ ...x, k, d: `M ${x.x} ${x.y} L ${CX} ${CY}` }));
const pc = (a: number, c: number) => `${((a / c) * 100).toFixed(2)}%`;
---
<div class="dw-bild" data-szene style={`aspect-ratio: ${W} / ${H}`}>
  <svg viewBox={`0 0 ${W} ${H}`} aria-hidden="true" focusable="false">
    {b.map((x) => <path class="dw-s dw-s--fein" pathLength="1" d={x.d} data-an={`zeichnen:${f(0.6 + x.k * 0.04)}-${f(0.7 + x.k * 0.04)}`} />)}
  </svg>
  {b.map((x) => (
    <span class="dw-pos" style={`left:${pc(x.x, W)};top:${pc(x.y, H)}`}>
      <span class="dw-chip" data-an={`auf:${f(0.1 + x.k * 0.06)}-${f(0.2 + x.k * 0.06)}`}>{x.text}</span>
    </span>
  ))}
  <span class="dw-pos" style={`left:${pc(CX, W)};top:${pc(CY, H)}`}>
    <span class="dw-verstehen__kreis">
      <svg class="dw-verstehen__ring" viewBox="0 0 100 100" aria-hidden="true" focusable="false">
        <path class="dw-s dw-verstehen__ast" pathLength="1" d="M 50 1.5 A 48.5 48.5 0 0 0 50 98.5" data-an={`linear:${TEIL}-${ZU}`} />
        <path class="dw-s dw-verstehen__ast" pathLength="1" d="M 50 1.5 A 48.5 48.5 0 0 1 50 98.5" data-an={`linear:${TEIL}-${ZU}`} />
      </svg>
      <span class="dw-verstehen__fuell" data-an="blende:0.82-0.94"></span>
      <span class="dw-verstehen__lupe" data-an={`blende:${f(ZU - 0.06)}-${f(ZU + 0.04)}`}><Icon name="search" size={22} /></span>
      <span class="sr-only">{DW_VERSTEHEN.mitte}</span>
      <span class="dw-anker" style="left:50%;top:0" data-weg="ein"></span>
      <span class="dw-anker" style="left:50%;top:100%" data-weg="aus"></span>
    </span>
  </span>
</div>
