---
// Startseite der DACHMARKE Waybuild – Leitbild „Der Weg“ (27.10.2026, Jamil Talk 3467/3470/3475; Grundlage 3373, 3378, 3395, 3401).
// Die Startseite spricht NUR über uns: Haltung, Werte, Prinzipien, Philosophie, Qualitäten (Jamil, Talk 3540/3541).
// Einzige Ausnahme: „Unsere Produkte“ als zurückhaltender Wegweiser. Leistungsdetails stehen auf Produkt- und Unterseiten.
// Idee: Veränderungen scheitern selten an der Technik, sondern am Weg dorthin (E-Mails, Screenshots, Warten).
// Waybuild baut diesen Weg gerade. Bildsprache: EINE Linie – verknotet = der übliche Weg, gerade = mit Waybuild.
// Aufbau: Hero (Linie) → Unsere Haltung (Entstehung + vier Sätze mit Bildsymbolen) → Unsere Qualitäten → Leichtigkeit in der Zusammenarbeit → Unsere Produkte → Fragen → Abschluss.
// 10 s: Was macht Waybuild? (Hero-Satz)  30 s: Warum gerade Waybuild? (Weg + vier Gründe)
// Bewegung nur zweimal und erklärend: die Hero-Linie entknotet sich einmal; die Weg-Linie zieht sich durch. Dazu sanftes Einblenden.
// Ohne JS alles sichtbar, bei prefers-reduced-motion sofort Endzustand. Zahlen/Zusagen NUR aus src/config.
// Frühere Fassungen: Tag startseite-v2-2026-10-27, Commit 863d489.
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHead from '../components/SectionHead.astro';
import Icon from '../components/Icon.astro';
import { href } from '../lib/paths';
import Produkte from '../components/Produkte.astro';
import HaltungBild from '../components/HaltungBild.astro';
import { HERO, HALTUNG, QUALITAETEN, ZUSAMMENARBEIT } from '../config/hauptseite';


// Vier Gründe – nur belegte Aussagen (site.ts, hauptseite.ts). „schriftlich“ entfernt (nicht belegt, Launch-Checkliste).
// Grund 03 nennt KI wie bisher – offene Entscheidung B (Talk 3469) unverändert. Alle Gründe gelten für alle Produkte (Talk 3475).
const FRAGEN = [
  'Wie einfach lassen sich Änderungen bei Ihnen heute umsetzen?',
  'Wie schnell kommen Ideen tatsächlich in die Umsetzung?',
  'Wie abhängig ist Ihr Unternehmen von einzelnen Personen?',
  'Wie transparent sind Ihre Dienstleister?',
  'Wie viel Aufwand entsteht bei kleinen Veränderungen?',
];
---

<BaseLayout
  title="Wir machen Veränderungen einfach"
  description="Waybuild hilft Unternehmen, Veränderungen einfacher umzusetzen – mit Klarheit, Struktur und einem verlässlichen Partner. Wir machen Veränderungen einfach."
>
  <!-- 1 HERO: roter Faden, was wir tun, die Linie -->
  <section class="hero" aria-labelledby="hero-h">
    <div class="wrap">
      <div class="hero__kopf">
        <div>
          <span class="eyebrow eyebrow--weg">{HERO.eyebrow}</span>
          <h1 id="hero-h">{HERO.pre}<span class="accent">{HERO.accent}</span></h1>
        </div>
        <div class="hero__rechts">
          <p class="hero__was">{HERO.lead}</p>
          <div class="hero__cta">
            <a class="btn btn--primary btn--lg" href={href('/kontakt/')}>Erstgespräch anfragen <Icon name="arrow" size={18} /></a>
            <a class="btn btn--ghost btn--lg" href={href('/#produkte')}>Unsere Produkte</a>
          </div>
        </div>
      </div>

      <figure class="linie" aria-labelledby="linie-cap">
        <figcaption id="linie-cap" class="sr-only">Grafik: Eine verknotete graue Linie mit vielen Zwischenschritten steht für den üblichen, umständlichen Weg. Sie geht über in eine gerade türkise Linie mit nur zwei Schritten – Verstehen und Umsetzen – bis zu einem Ziel-Zeichen: der Weg mit Waybuild.</figcaption>
        <div class="linie__kopf">
          <p class="linie__label linie__label--oft"><span aria-hidden="true"></span>So läuft es oft</p>
          <p class="linie__label linie__label--wir"><span aria-hidden="true"></span>So läuft es mit Waybuild</p>
        </div>
        <svg class="linie__svg linie__svg--breit" viewBox="0 34 1160 166" aria-hidden="true" focusable="false">
          <path class="linie__knoten" pathLength="1" d="M 10 130 C 60 130, 80 60, 130 70 C 190 82, 170 190, 120 180 C 70 170, 110 44, 200 54 C 290 64, 250 200, 200 190 C 150 180, 230 84, 300 110 C 350 130, 330 190, 290 172 C 250 154, 330 125, 420 125" />
          <path class="linie__gerade" pathLength="1" d="M 420 125 L 1108 125" />
          <g class="linie__umwege"><circle cx="130" cy="70" r="8" /><circle cx="120" cy="180" r="8" /><circle cx="200" cy="54" r="8" /><circle cx="200" cy="190" r="8" /><circle cx="300" cy="110" r="8" /></g>
          <g class="linie__stationen">
            <circle cx="640" cy="125" r="8" /><text x="640" y="165" text-anchor="middle">Verstehen</text>
            <circle cx="880" cy="125" r="8" /><text x="880" y="165" text-anchor="middle">Umsetzen</text>
          </g>
          <g class="linie__ziel" aria-hidden="true">
            <circle class="linie__ziel-ring" cx="1130" cy="125" r="22" />
            <circle class="linie__ziel-ring" cx="1130" cy="125" r="12.1" />
            <circle class="linie__ziel-mitte" cx="1130" cy="125" r="4.8" />
          </g>
        </svg>
        <svg class="linie__svg linie__svg--schmal" viewBox="0 36 360 124" aria-hidden="true" focusable="false">
          <path class="linie__knoten" pathLength="1" d="M 6 105 C 30 105, 40 55, 70 60 C 105 66, 95 140, 65 135 C 35 130, 60 42, 110 50 C 160 58, 140 150, 110 140 C 85 132, 130 104, 175 106" />
          <path class="linie__gerade" pathLength="1" d="M 175 106 L 322 106" />
          <g class="linie__umwege"><circle cx="70" cy="60" r="6" /><circle cx="65" cy="135" r="6" /><circle cx="110" cy="50" r="6" /><circle cx="110" cy="140" r="6" /></g>
          <g class="linie__ziel" aria-hidden="true">
            <circle class="linie__ziel-ring" cx="338" cy="106" r="16" />
            <circle class="linie__ziel-ring" cx="338" cy="106" r="8.8" />
            <circle class="linie__ziel-mitte" cx="338" cy="106" r="3.5" />
          </g>
        </svg>
      </figure>

    </div>
  </section>

  <!-- 2 UNSERE HALTUNG: Entstehung + vier Sätze aus dem Strategiebriefing (3401) mit animierten Bildsymbolen (3537) -->
  <section class="section weg-sec" id="haltung" aria-labelledby="weg-h">
    <div class="wrap">
      <SectionHead eyebrow="Unsere Haltung" pre="Nicht die Technik macht Veränderungen schwer. " accent="Sondern der Weg dorthin." ton="leise" id="weg-h"
        text="Waybuild ist aus Frust entstanden: Eine einfache Veränderung bedeutete viele Nachrichten, Missverständnisse und Warten. Deshalb fragen wir zuerst: Was möchten Sie erreichen? Und machen den Weg dorthin kurz und einfach." />
      <ul class="haltung">
        {HALTUNG.map((h, i) => (
          <li class="reveal" style={`--d:${i * 90}ms`}>
            <span class="haltung__icon"><HaltungBild art={h.bild} /></span>
            <h3>{h.titel}</h3>
            <p>{h.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 3 UNSERE QUALITÄTEN: was jede Veränderung braucht (3401) -->
  <section class="section section--dark qual" id="qualitaeten" aria-labelledby="qual-h">
    <div class="wrap">
      <SectionHead eyebrow="Unsere Qualitäten" pre="Was jede Veränderung braucht. " accent="Dafür stehen wir." id="qual-h"
        text="Klarheit, Fortschritt, Umsetzung – und die Freiheit, sich weiter zu verändern." />
      <ul class="qual__liste">
        {QUALITAETEN.map((q, i) => (
          <li class="reveal" style={`--d:${i * 80}ms`}>
            <span class="qual__icon" aria-hidden="true"><Icon name={q.icon} size={26} /></span>
            <h3>{q.titel}</h3>
            <p>{q.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 4 LEICHTIGKEIT IN DER ZUSAMMENARBEIT (3395) – Serviceversprechen allgemein, Details auf /zusagen/ -->
  <section class="section leicht" id="zusammenarbeit" aria-labelledby="leicht-h">
    <div class="wrap leicht__grid">
      <SectionHead eyebrow="Zusammenarbeit" pre="Weil Zusammenarbeit " accent="leicht sein darf." id="leicht-h"
        text="Ihre Leichtigkeit in der ganzen Zusammenarbeit ist unser Maßstab – vom ersten Gespräch an.">
        <p class="leicht__mehr"><a class="pfeil-link" href={href('/zusagen/')}>Unsere Zusagen im Detail <Icon name="arrow" size={16} /></a></p>
      </SectionHead>
      <ul class="leicht__liste">
        {ZUSAMMENARBEIT.map((z, i) => (
          <li class="reveal" style={`--d:${i * 80}ms`}>
            <span class="leicht__icon" aria-hidden="true"><Icon name={z.icon} size={24} /></span>
            <div><h3>{z.titel}</h3><p>{z.text}</p></div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 5 UNSERE PRODUKTE: Wegweiser zu den Produkt-Websites -->
  <section class="section section--sand" id="produkte" aria-labelledby="produkte-h">
    <div class="wrap">
      <SectionHead eyebrow="Unsere Produkte" pre="Jetzt starten wir. " accent="Und das ist erst der Anfang." id="produkte-h"
        text="Jedes Produkt hat einen eigenen Namen und eine eigene Seite. Unsere Werte und Zusagen gelten für alle." />
      <Produkte />
    </div>
  </section>

  <!-- 6 ZUM NACHDENKEN: Fragen statt Druck -->
  <section class="section fragen" id="fragen" aria-labelledby="fragen-h">
    <div class="wrap fragen__grid">
      <SectionHead eyebrow="Zum Nachdenken" pre="Wie leicht ist Veränderung " accent="bei Ihnen heute?" id="fragen-h"
        text="Nicht jede Veränderung braucht etwas Neues. Aber fast jede braucht Klarheit, Struktur und einen verlässlichen Partner." />
      <ol class="fragen__liste">
        {FRAGEN.map((f) => <li class="reveal">{f}</li>)}
      </ol>
    </div>
  </section>
</BaseLayout>

<style>
  /* 1 HERO */
  .hero { position: relative; overflow: hidden; padding-block: clamp(36px, 7vw, 84px) clamp(40px, 6vw, 72px); background: var(--paper);
    background-image: radial-gradient(45% 55% at 92% 8%, rgb(0 166 161 / 14%), transparent 70%); }
  .hero h1 { font-size: clamp(2.5rem, 7.6vw, 5.4rem); line-height: 1.02; letter-spacing: -0.035em; margin: 0 0 22px; max-width: 13ch; }
  .hero__was { font-size: clamp(1.12rem, 2.3vw, 1.4rem); line-height: 1.5; color: var(--ink-soft); max-width: 40ch; margin: 0 0 28px; }
  .hero__cta { display: flex; flex-wrap: wrap; gap: 12px; }
  @media (min-width: 1000px) {
    .hero__kopf { display: grid; grid-template-columns: 1.2fr 1fr; gap: 48px; align-items: end; }
    .hero h1 { margin-bottom: 0; }
    .hero__rechts { padding-bottom: 12px; }
    .hero__rechts .hero__was { font-size: 1.22rem; margin-bottom: 22px; }
    .hero__rechts .btn--lg { min-height: 50px; padding: 0.8em 1.4em; font-size: 1rem; }
    .hero__rechts .hero__cta { flex-wrap: nowrap; }
  }

  .linie { margin: clamp(36px, 6vw, 64px) 0 0; }
  .linie__svg { display: block; width: 100%; height: auto; overflow: visible; }
  .linie__svg--schmal { display: none; }
  @media (max-width: 700px) { .linie__svg--breit { display: none; } .linie__svg--schmal { display: block; } }
  .linie__knoten, .linie__gerade { fill: none; stroke-linecap: round; stroke-linejoin: round; stroke-dasharray: 1; }
  .linie__knoten { stroke: #a8a191; stroke-width: 5; } /* gleich dick wie die gerade Linie (Jamil, Talk 3503) */
  .linie__gerade { stroke: var(--accent); stroke-width: 5; }
  /* Zwischenüberschriften der Linie, deutlich hervorgehoben (Jamil, Talk 3503) */
  .linie__kopf { display: grid; grid-template-columns: 40.5% 1fr; gap: 12px; margin-bottom: 4px; align-items: start; }
  @media (max-width: 700px) { .linie__kopf { grid-template-columns: 48% 1fr; } }
  .linie__label { margin: 0; display: flex; align-items: flex-start; gap: 10px; font-family: var(--font-head); font-weight: 700; font-size: clamp(1rem, 1.9vw, 1.3rem); line-height: 1.25; letter-spacing: -0.01em; }
  .linie__label span { flex: none; width: 28px; height: 5px; border-radius: 3px; margin-top: 0.5em; }
  .linie__label--oft { color: #57534b; }
  .linie__label--oft span { background: #a8a191; }
  .linie__label--wir { color: var(--accent-ink); }
  .linie__label--wir span { background: var(--accent); }
  @media (max-width: 420px) { .linie__label span { width: 18px; } .linie__label { gap: 8px; } }
  .linie__umwege circle { fill: var(--paper); stroke: #a8a191; stroke-width: 4; }
  .linie__svg--schmal .linie__umwege circle { stroke-width: 3.5; }
  .linie__stationen circle { fill: var(--white); stroke: var(--accent); stroke-width: 4; }
  .linie__stationen text { font: 600 16px var(--font-body); fill: var(--ink); }
  /* Ziel-Zeichen (Zielscheibe) statt Endpunkt + „Erledigt.“ (Jamil, Talk 3512) */
  .linie__ziel-ring { fill: var(--paper); stroke: var(--accent); stroke-width: 5; }
  .linie__svg--schmal .linie__ziel-ring { stroke-width: 4; }
  .linie__ziel-mitte { fill: var(--accent-ink); }
  /* Bewegung 1: Knoten erscheint, dann zieht sich die gerade Linie bis „Erledigt“ – einmal, ohne Schleife */
  .linie__knoten { animation: zeichnen 1.1s ease-out both 0.2s; }
  .linie__gerade { animation: zeichnen 1.2s cubic-bezier(.4,0,.2,1) both 1.2s; }
  .linie__umwege { animation: auftauchen 0.4s ease both 1.0s; }
  .linie__stationen, .linie__ziel { animation: auftauchen 0.4s ease both 2.2s; }
  @keyframes zeichnen { from { stroke-dashoffset: 1; } to { stroke-dashoffset: 0; } }
  @keyframes auftauchen { from { opacity: 0; } to { opacity: 1; } }


  /* 2 DER WEG */
  .weg-sec { background: var(--white); }
  /* Vier Haltungs-Sätze: bewusst ohne Linie/Stationen, damit sie sich klar von der Hero-Linie unterscheiden */
  .haltung { list-style: none; margin: 0; padding: 0; display: grid; gap: 16px; }
  @media (min-width: 680px) { .haltung { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1060px) { .haltung { grid-template-columns: repeat(4, 1fr); gap: 20px; } }
  .haltung li { display: grid; align-content: start; gap: 10px; padding: clamp(22px, 2.6vw, 28px); border-radius: 20px; background: var(--paper); border: 1px solid var(--line); transition-delay: var(--d, 0ms); }
  .haltung__icon { display: grid; place-items: center; width: 76px; height: 76px; border-radius: 22px; background: var(--white); border: 1px solid rgb(0 166 161 / 30%); margin-bottom: 6px; }
  .haltung h3 { margin: 0; font-size: clamp(1.15rem, 1.8vw, 1.3rem); line-height: 1.25; }
  .haltung p { margin: 0; color: var(--ink-soft); line-height: 1.6; }

  /* 3 QUALITÄTEN */
  .qual__liste { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; }
  @media (min-width: 640px) { .qual__liste { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1060px) { .qual__liste { grid-template-columns: repeat(5, 1fr); gap: 16px; } }
  .qual__liste li { display: grid; align-content: start; gap: 8px; padding: 24px 22px; border-radius: 20px; background: rgb(255 255 255 / 6%); border: 1px solid var(--dark-line); transition-delay: var(--d, 0ms); }
  .qual__icon { display: grid; place-items: center; width: 52px; height: 52px; border-radius: 50%; border: 2px solid var(--accent-light); color: var(--accent-light); margin-bottom: 6px; }
  .qual__liste h3 { margin: 0; color: var(--white); font-size: 1.2rem; line-height: 1.25; }
  .qual__liste p { margin: 0; color: var(--dark-lead); line-height: 1.55; }

  /* 4 LEICHTIGKEIT */
  .leicht { background: var(--paper); }
  .leicht__grid { display: grid; gap: 28px; }
  @media (min-width: 960px) { .leicht__grid { grid-template-columns: 0.9fr 1.1fr; gap: 64px; align-items: start; } .leicht__grid :global(.section-head) { margin-bottom: 0; } }
  .leicht__mehr { margin: 22px 0 0; }
  .leicht__liste { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
  .leicht__liste li { display: flex; gap: 16px; align-items: flex-start; padding: 20px 22px; border-radius: 18px; background: var(--white); border: 1px solid var(--line); transition-delay: var(--d, 0ms); }
  .leicht__icon { flex: none; display: grid; place-items: center; width: 48px; height: 48px; border-radius: 14px; background: rgb(0 166 161 / 14%); color: var(--accent-ink); }
  .leicht__liste h3 { margin: 0 0 4px; font-size: 1.15rem; }
  .leicht__liste p { margin: 0; color: var(--ink-soft); line-height: 1.55; }

  /* 6 FRAGEN */
  .fragen { background: var(--white); }
  .fragen__grid { display: grid; gap: 28px; }
  @media (min-width: 960px) { .fragen__grid { grid-template-columns: 1fr 1fr; gap: 64px; align-items: start; } .fragen__grid :global(.section-head) { margin-bottom: 0; } }
  .fragen__liste { list-style: none; margin: 0; padding: 0; counter-reset: f; }
  .fragen__liste li { counter-increment: f; display: grid; grid-template-columns: 34px 1fr; gap: 12px; padding: 16px 0; border-top: 1px solid var(--line); font-family: var(--font-head); font-weight: 600; font-size: 1.08rem; line-height: 1.4; }
  .fragen__liste li:last-child { border-bottom: 1px solid var(--line); }
  .fragen__liste li::before { content: '?'; display: grid; place-items: center; width: 28px; height: 28px; border-radius: 50%; border: 2px solid var(--accent); color: var(--accent-ink); font-size: 0.9rem; }

  @media (prefers-reduced-motion: reduce) {
    .linie__knoten, .linie__gerade, .linie__umwege, .linie__stationen, .linie__ziel { animation: none !important; }
  }
</style>
