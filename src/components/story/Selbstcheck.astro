---
// Selbstreflexion (Jamils kompaktes Design-Briefing, Talk 3636): fünf Fragen als leichte Selbsteinschätzung
// (sehr einfach / meistens einfach / oft aufwendig / unnötig kompliziert). Danach eine kurze Einordnung –
// ohne Kontaktdaten, nichts wird gesendet oder gespeichert. Ohne JS: Fragen + Gesprächs-Link bleiben nutzbar.
// Die Fragen hängen im Zickzack an der Linie (Desktop links/rechts, Handy rechts).
import { href } from '../../lib/paths';
import Icon from '../Icon.astro';

const FRAGEN = [
  'Wie einfach lassen sich kleine Änderungen umsetzen?',
  'Wie schnell kommen Ideen tatsächlich in die Umsetzung?',
  'Wie abhängig ist Ihr Unternehmen von einzelnen Personen?',
  'Wie transparent arbeiten Ihre Dienstleister?',
  'Wie viel Abstimmung entsteht bei kleinen Veränderungen?',
];
const STUFEN = ['sehr einfach', 'meistens einfach', 'oft aufwendig', 'unnötig kompliziert'];
---

<div class="pfad check" data-selbstcheck>
  <h3 class="halt halt--voll fragen__marke" id="check-h">Wie leicht ist Veränderung bei Ihnen heute?</h3>
  <div class="pfad pfad--zickzack check__liste">
    {FRAGEN.map((f, i) => (
      <fieldset class:list={['halt', i % 2 ? 'halt--r' : 'halt--l', 'k', 'frage', 'leuchtet']} style={`--zeile:${i + 1}`}>
        <legend><span class="k__nr" aria-hidden="true">{i + 1}</span><span>{f}</span></legend>
        <div class="frage__wahl">
          {STUFEN.map((s, k) => (
            <label><input type="radio" name={`frage-${i}`} value={k} /><span>{s}</span></label>
          ))}
        </div>
      </fieldset>
    ))}
  </div>
  <div class="halt halt--voll halt--still k k--flaeche einordnung leuchtet">
    <p class="einordnung__text" aria-live="polite" data-einordnung>Wählen Sie bei jeder Frage, was am ehesten passt. Ihre Antworten bleiben auf Ihrem Gerät.</p>
    <a class="btn btn--ghost" href={href('/kontakt/')}>Über Ihren Weg sprechen <Icon name="arrow" size={18} /></a>
  </div>
</div>

<script>
  const box = document.querySelector<HTMLElement>('[data-selbstcheck]');
  if (box) {
    const text = box.querySelector<HTMLElement>('[data-einordnung]')!;
    const n = box.querySelectorAll('fieldset').length;
    box.addEventListener('change', () => {
      const werte = Array.from(box.querySelectorAll<HTMLInputElement>('input:checked')).map((i) => Number(i.value));
      if (werte.length < n) {
        text.textContent = `Noch ${n - werte.length} ${n - werte.length === 1 ? 'Frage' : 'Fragen'} – dann sehen Sie eine kurze Einordnung.`;
        return;
      }
      const aufwendig = werte.filter((v) => v >= 2).length;
      text.innerHTML = aufwendig >= 2 || werte.includes(3)
        ? '<strong>Ihr Veränderungsweg hat Potenzial zur Vereinfachung.</strong> Wo es heute hakt, schauen wir uns gern gemeinsam an.'
        : '<strong>Ihr Veränderungsweg ist schon recht einfach.</strong> Wenn er noch leichter werden soll, sprechen wir gern darüber.';
    });
  }
</script>

<style>
  .check { margin-top: clamp(56px, 8vw, 96px); row-gap: 20px; }
  .fragen__marke { --hy: 50%; margin: 0; font-size: clamp(1.2rem, 2.2vw, 1.5rem); color: var(--accent-ink); }
  @media (min-width: 960px) {
    .fragen__marke { justify-self: center; text-align: center; background: var(--sec-bg); border: 3px solid var(--accent); border-radius: 999px; padding: 12px 28px; }
    .fragen__marke::before, .fragen__marke::after { display: none; }
    .check__liste { grid-column: 1 / -1; }
  }
  .check__liste { row-gap: 0; }
  .frage { --hy: 28px; display: block; align-self: start; margin: 0 0 14px; min-width: 0; }
  .frage legend { float: left; width: 100%; display: flex; gap: 12px; align-items: flex-start; margin: 0 0 14px; padding: 0; font-family: var(--font-head); font-weight: 650; font-size: 1.05rem; line-height: 1.4; }
  .frage legend > span:last-child { padding-top: 4px; }
  /* Antworten gleichmäßig: zwei in einer Reihe, gleich breit (Jamil, Talk 3643) */
  .frage__wahl { clear: both; display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  .frage__wahl label { position: relative; cursor: pointer; }
  .frage__wahl input { position: absolute; opacity: 0; width: 1px; height: 1px; }
  .frage__wahl label { display: flex; }
  .frage__wahl span { display: flex; align-items: center; justify-content: center; width: 100%; min-height: 40px; text-align: center; padding: 7px 10px; border-radius: 999px; border: 1.5px solid var(--line); background: var(--paper); font-size: 0.9rem; font-weight: 600; color: #4a4741; transition: background 150ms ease, border-color 150ms ease; }
  .frage__wahl label:hover span { border-color: var(--accent); }
  .frage__wahl input:checked + span { background: var(--accent); border-color: var(--accent); color: var(--on-accent); }
  .frage__wahl input:focus-visible + span { outline: 3px solid var(--accent); outline-offset: 2px; }
  .einordnung { display: grid; justify-items: start; gap: 14px; margin-top: 10px; }
  @media (max-width: 959px) { .einordnung { background: none; border: 0; padding: 0; } }
  .einordnung__text { margin: 0; max-width: 52ch; color: var(--ink-soft); line-height: 1.6; }
  .einordnung__text :global(strong) { display: block; font-family: var(--font-head); font-size: 1.2rem; color: var(--ink); margin-bottom: 4px; }
  @media (min-width: 960px) {
    .einordnung { justify-items: center; text-align: center; padding: 24px 32px; justify-self: center; z-index: 1; background: linear-gradient(rgb(0 79 76 / 4%), rgb(0 79 76 / 4%)), var(--sec-bg); }
  }
</style>
