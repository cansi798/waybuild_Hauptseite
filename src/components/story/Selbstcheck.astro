---
// Selbstreflexion (Jamils kompaktes Design-Briefing, Talk 3636) – seit Talk 3712 mit einem Schieberegler pro Frage und
// einem Diagramm als Ergebnis. Die vier bisherigen Antworten bleiben als Stufen des Reglers erhalten
// (sehr einfach · meistens einfach · teils, teils · oft aufwendig · unnötig kompliziert).
// Startzustand: „noch nicht eingeschätzt“ (Griff blass in der Mitte, zählt nicht mit) – ein vorgegebener Mittelwert würde
// das Ergebnis verfälschen, deshalb zählt eine Frage erst, wenn sie bewegt oder per Tastatur verändert wurde.
// Seit Talk 3758/3761: fünf Stufen (1–5) und als Ergebnis EIN Balken mit dem Durchschnitt; Knopf türkis. Nichts wird gesendet oder gespeichert. Ohne JS: Regler + Gesprächs-Link.
import { href } from '../../lib/paths';
import Icon from '../Icon.astro';

const FRAGEN = [
  { f: 'Wie einfach lassen sich kleine Änderungen umsetzen?', kurz: 'Kleine Änderungen' },
  { f: 'Wie schnell kommen Ideen tatsächlich in die Umsetzung?', kurz: 'Ideen umsetzen' },
  { f: 'Wie abhängig ist Ihr Unternehmen von einzelnen Personen?', kurz: 'Abhängigkeit von Personen' },
  { f: 'Wie transparent arbeiten Ihre Dienstleister?', kurz: 'Transparenz der Dienstleister' },
  { f: 'Wie viel Abstimmung entsteht bei kleinen Veränderungen?', kurz: 'Abstimmung' },
];
// Fünf Stufen (Jamil, Talk 3758); „teils, teils“ als natürliche Mitte zwischen den bisherigen vier Aussagen
const STUFEN = ['sehr einfach', 'meistens einfach', 'teils, teils', 'oft aufwendig', 'unnötig kompliziert'];
---

<div class="pfad check" data-selbstcheck data-stufen={JSON.stringify(STUFEN)}>
  <h3 class="halt halt--voll fragen__marke" id="check-h">Wie leicht ist Veränderung bei Ihnen heute?</h3>
  <div class="pfad pfad--zickzack check__liste">
    {FRAGEN.map((q, i) => (
      <div class:list={['halt', i % 2 ? 'halt--r' : 'halt--l', 'k', 'frage', 'leuchtet']} style={`--zeile:${i + 1}`}>
        <div class="k__inhalt frage__inhalt">
          <label class="frage__text" for={`regler-${i}`}><span class="k__nr" aria-hidden="true">{i + 1}</span><span>{q.f}</span></label>
          <div class="regler">
            <input class="regler__input regler--offen" id={`regler-${i}`} type="range" min="1" max="5" step="1" value="3"
              aria-valuetext="noch nicht eingeschätzt" aria-describedby={`regler-${i}-stufen`} data-i={i} />
            <ol class="regler__stufen" id={`regler-${i}-stufen`} aria-hidden="true">
              {STUFEN.map((s) => <li>{s}</li>)}
            </ol>
          </div>
          <p class="regler__wert" aria-hidden="true" data-wert={i}>noch nicht eingeschätzt</p>
        </div>
      </div>
    ))}
  </div>
  <div class="halt halt--voll halt--still k k--flaeche einordnung leuchtet">
    <figure class="schnitt-balken" aria-live="polite">
      <figcaption class="schnitt-balken__titel">Ihr Durchschnitt: <span data-schnitt-text>noch keine Antwort</span></figcaption>
      <div class="schnitt-balken__spur" aria-hidden="true"><span class="schnitt-balken__fuellung" data-schnitt></span></div>
      <div class="schnitt-balken__achse" aria-hidden="true"><span>{STUFEN[0]}</span><span>{STUFEN[4]}</span></div>
    </figure>
    <p class="einordnung__text" aria-live="polite" data-einordnung>Schieben Sie bei jeder Frage den Regler dorthin, wo es am ehesten passt. Ihre Antworten bleiben auf Ihrem Gerät.</p>
    <a class="btn btn--primary" href={href('/kontakt/')}>Über Ihren Weg sprechen <Icon name="arrow" size={18} /></a>
  </div>
</div>

<script>
  const box = document.querySelector<HTMLElement>('[data-selbstcheck]');
  if (box) {
    box.classList.add('check--js');
    const STUFEN: string[] = JSON.parse(box.dataset.stufen || '[]');
    const regler = Array.from(box.querySelectorAll<HTMLInputElement>('.regler__input'));
    const text = box.querySelector<HTMLElement>('[data-einordnung]')!;
    const fuellung = box.querySelector<HTMLElement>('[data-schnitt]')!;
    const schnittText = box.querySelector<HTMLElement>('[data-schnitt-text]')!;
    const beantwortet = new Set<number>();
    const zeigen = (r: HTMLInputElement) => {
      const i = Number(r.dataset.i), v = Number(r.value), offen = !beantwortet.has(i);
      const t = offen ? 'noch nicht eingeschätzt' : STUFEN[v - 1];
      r.setAttribute('aria-valuetext', t);
      r.classList.toggle('regler--offen', offen);
      r.style.setProperty('--wert', `${((v - 1) / 4) * 100}%`);
      box.querySelector<HTMLElement>(`[data-wert="${i}"]`)!.textContent = t;
    };
    const auswerten = () => {
      const werte = regler.filter((r) => beantwortet.has(Number(r.dataset.i))).map((r) => Number(r.value));
      if (werte.length) {
        // Durchschnitt aller beantworteten Fragen in EINEM Balken (Jamil, Talk 3761)
        const schnitt = werte.reduce((a, b) => a + b, 0) / werte.length;
        fuellung.style.width = `${Math.max(4, ((schnitt - 1) / 4) * 100)}%`;
        fuellung.classList.toggle('schnitt-balken__fuellung--hoch', schnitt >= 3);
        schnittText.textContent = `${schnitt.toLocaleString('de-DE', { maximumFractionDigits: 1 })} von 5 (${STUFEN[Math.round(schnitt) - 1]})`;
      }
      if (werte.length < regler.length) {
        const rest = regler.length - werte.length;
        text.textContent = `Noch ${rest} ${rest === 1 ? 'Frage' : 'Fragen'}, dann sehen Sie eine kurze Einordnung.`;
        return;
      }
      const schnitt = werte.reduce((a, b) => a + b, 0) / werte.length;
      const aufwendig = werte.filter((v) => v >= 4).length;
      text.innerHTML = aufwendig >= 2 || werte.includes(5) || schnitt >= 3
        ? '<strong>Ihr Veränderungsweg hat Potenzial zur Vereinfachung.</strong> Wo es heute hakt, schauen wir uns gern gemeinsam an.'
        : '<strong>Ihr Veränderungsweg ist schon recht einfach.</strong> Wenn er noch leichter werden soll, sprechen wir gern darüber.';
    };
    regler.forEach((r) => {
      const markieren = () => { beantwortet.add(Number(r.dataset.i)); zeigen(r); auswerten(); };
      r.addEventListener('input', markieren);
      r.addEventListener('change', markieren);
      zeigen(r);
    });
  }
</script>

<style>
  .check { margin-top: clamp(56px, 8vw, 96px); row-gap: 20px; }
  .fragen__marke { --hy: 50%; margin: 0; font-size: clamp(1.2rem, 2.2vw, 1.5rem); color: var(--accent-ink); }
  @media (min-width: 960px) {
    .fragen__marke { justify-self: center; text-align: center; background: var(--sec-bg); border: 3px solid var(--accent); border-radius: 999px; padding: 12px 28px; }
    .fragen__marke::before, .fragen__marke::after { display: none; }
    .check__liste { grid-column: 1 / -1; }
  }
  .check__liste { row-gap: 0; }
  .frage { --hy: 28px; align-self: start; margin: 0 0 14px; min-width: 0; }
  .frage__inhalt { width: 100%; }
  .frage__text { display: flex; gap: 12px; align-items: flex-start; margin: 0 0 18px; font-family: var(--font-head); font-weight: 650; font-size: 1.05rem; line-height: 1.4; }
  .frage__text > span:last-child { padding-top: 4px; }

  /* Schieberegler (Jamil, Talk 3712): große Griffe, ruhige Spur; vertikales Scrollen bleibt möglich (touch-action) */
  .regler { position: relative; }
  .regler__input {
    --wert: 50%;
    -webkit-appearance: none; appearance: none; display: block; width: 100%; height: 44px; margin: 0; background: transparent; cursor: pointer;
    touch-action: pan-y;
  }
  .regler__input::-webkit-slider-runnable-track { height: 8px; border-radius: 4px; background: linear-gradient(to right, var(--accent) 0 var(--wert), var(--paper-2) var(--wert) 100%); }
  .regler__input::-moz-range-track { height: 8px; border-radius: 4px; background: var(--paper-2); }
  .regler__input::-moz-range-progress { height: 8px; border-radius: 4px; background: var(--accent); }
  .regler__input::-webkit-slider-thumb { -webkit-appearance: none; width: 28px; height: 28px; margin-top: -10px; border-radius: 50%; background: var(--white); border: 3px solid var(--accent); box-shadow: 0 1px 3px rgb(0 0 0 / 15%); }
  .regler__input::-moz-range-thumb { width: 24px; height: 24px; border-radius: 50%; background: var(--white); border: 3px solid var(--accent); }
  .regler__input:focus-visible { outline: none; }
  .regler__input:focus-visible::-webkit-slider-thumb { outline: 3px solid var(--accent); outline-offset: 3px; }
  .regler__input:focus-visible::-moz-range-thumb { outline: 3px solid var(--accent); outline-offset: 3px; }
  /* noch nicht eingeschätzt: Spur neutral, Griff blass gestrichelt */
  .regler--offen::-webkit-slider-runnable-track { background: var(--paper-2); }
  .regler--offen::-moz-range-progress { background: transparent; }
  .regler--offen::-webkit-slider-thumb { border-style: dashed; border-color: #a8a191; }
  .regler--offen::-moz-range-thumb { border-style: dashed; border-color: #a8a191; }
  .regler__stufen { list-style: none; margin: 2px 0 0; padding: 0; display: flex; justify-content: space-between; gap: 8px; font-size: 0.8rem; color: #6f6a60; }
  .regler__stufen li { flex: 1; text-align: center; line-height: 1.25; }
  .regler__stufen li:first-child { text-align: left; }
  .regler__stufen li:last-child { text-align: right; }
  .regler__wert { margin: 10px 0 0 !important; font-weight: 650; color: var(--accent-ink) !important; }
  .check:not(.check--js) .regler__wert { display: none; }

  /* Ergebnis: Diagramm + Einordnung */
  .einordnung { display: grid; justify-items: start; gap: 14px; margin-top: 10px; }
  .schnitt-balken { width: 100%; max-width: 560px; margin: 0; text-align: left; }
  .check:not(.check--js) .schnitt-balken { display: none; }
  .schnitt-balken__titel { margin: 0 0 10px; font-family: var(--font-head); font-weight: 650; font-size: 1rem; }
  .schnitt-balken__titel span { font-family: var(--font-body); font-weight: 600; color: var(--ink-soft); }
  .schnitt-balken__spur { position: relative; height: 14px; border-radius: 7px; background: var(--paper-2); overflow: hidden; }
  .schnitt-balken__fuellung { position: absolute; inset: 0 auto 0 0; width: 0; border-radius: 7px; background: var(--accent); transition: width 250ms ease, background-color 250ms ease; }
  .schnitt-balken__fuellung--hoch { background: #8f897c; }
  .schnitt-balken__achse { display: flex; justify-content: space-between; margin-top: 6px; font-size: 0.78rem; color: #6f6a60; }
  @media (prefers-reduced-motion: reduce) { .schnitt-balken__fuellung { transition: none; } }
  .einordnung__text { margin: 0; max-width: 52ch; color: var(--ink-soft); line-height: 1.6; }
  .einordnung__text :global(strong) { display: block; font-family: var(--font-head); font-size: 1.2rem; color: var(--ink); margin-bottom: 4px; }
  @media (min-width: 960px) {
    .einordnung { justify-items: center; text-align: center; padding: 24px 32px; justify-self: center; z-index: 1; background: linear-gradient(rgb(0 79 76 / 4%), rgb(0 79 76 / 4%)), var(--sec-bg); }
  }
</style>
